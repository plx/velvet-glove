/// pinact — pin GitHub Actions references to commit SHAs.
///
/// `--verify` calls the GitHub API to resolve each pinned action's version
/// comment to a commit SHA, on every invocation, including an already-fully
/// pinned "clean" file: pinact has no offline mode that preserves this check
/// (`--no-api` exists but drops to a purely syntactic 40-hex-char check and
/// cannot resolve refs to fix them, changing what "clean"/"issues" mean), so
/// this tool needs network access and is rate-limited without a token. A
/// bad `-c` config path also exits 1, the same code as a real pin issue;
/// pinact does not expose a distinct exit status for the two.

module velvet_glove.builtins.tools.Pinact

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "pinact"
  displayName = "pinact"
  executable = "pinact"
  installHint = "install pinact with `brew install pinact`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.yml"; "*.yaml"
      "**/*.yml"; "**/*.yaml"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "run"
        "--verify"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "run"
        "--verify"
        "--check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".pinact.yaml"; ".pinact.yml"; ".github/pinact.yaml"; ".github/pinact.yml" }
    note = "config-only: verifies pins over the network"
  }
}
