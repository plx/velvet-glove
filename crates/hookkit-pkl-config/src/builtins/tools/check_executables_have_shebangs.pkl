/// check-executables-have-shebangs — verify executable files begin with `#!`.
///
/// Backed by hk's (jdx/hk) `hk util check-executables-have-shebangs`, which
/// filters to mode-bit-executable regular files and reads their first bytes
/// itself; non-executable files are silently skipped. Note the sharp edge:
/// a missing path also exits 1 (`No such file or directory`), the same code
/// as a real issue, so an I/O error cannot be told apart from a shebang
/// violation this way. Our hook only ever passes paths it just saw edited,
/// so this is a narrow window, not a practical false-clean/false-issue risk.
/// A malformed invocation (bad flag) exits 2 and is classified as a failure.

module velvet_glove.builtins.tools.CheckExecutablesHaveShebangs

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "check-executables-have-shebangs"
  displayName = "check-executables-have-shebangs"
  executable = "hk"
  installHint = "install hk, e.g. `brew install hk` or `mise use -g hk`"

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "util"
        "check-executables-have-shebangs"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    note = "opt-in only: only meaningful on POSIX executable files"
  }
}
