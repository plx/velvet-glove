/// Sorbet — gradual type checker for Ruby.
///
/// DRAFT: Sorbet expects a `sorbet/` directory at the project root with a
/// `config` file. Most projects also need RBI files, runtime hooks, and a
/// non-trivial setup beyond `gem install sorbet`. This spec covers the common
/// "type-check the whole project" invocation but real projects will likely
/// want to override `extraArgs` to point at specific paths.
///
/// `srb tc` requires its current directory to directly contain `sorbet/`; it
/// does not search parent directories the way rubocop or bundler do, and a
/// missing `sorbet/` directory is reported on stdout but still exits 0 (looks
/// clean, verified against Sorbet 0.6.13508). Without `workspaceIndicator`,
/// every invocation runs from the overall project root, so a nested Ruby app
/// (its own `sorbet/config` under a subdirectory) would silently never be
/// type-checked. `workspaceIndicator` makes the runner invoke `srb tc` from
/// the nearest directory that actually has a `sorbet/config`. Issue exit code
/// 100 is verified; an invalid `sorbet/config` option exits 1, which is
/// distinct from both 0 and 100 and is classified as a failure by default.

module velvet_glove.builtins.tools.Sorbet

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "sorbet"
  displayName = "Sorbet"
  executable = "srb"
  installHint = "install sorbet with `gem install sorbet sorbet-runtime` and run `srb init`"
  workspaceIndicator = "sorbet/config"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.rb"; "**/*.rb"; "*.rbi"; "**/*.rbi" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "tc"
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 100 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "sorbet/config" }
    role = "ruby-typecheck"
  }
}
