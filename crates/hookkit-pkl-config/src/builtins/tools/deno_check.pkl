/// deno check — Deno's TypeScript type checker.
///
/// `deno check` exits 1 for both a type error and a broken `deno.json`, so
/// an operational failure is not distinguishable from a source issue via
/// exit code; no operational-failure fixture is provided (verified against
/// deno 2.9.7). `deno check` also prints a `Check <file>` progress line for
/// every file it's given, including ones with no error, so a batch
/// invocation's output names every candidate file and the runner's
/// output-based blame can't isolate the actually-failing one; per-file
/// invocation keeps each file's result independent (see the `multi-file`
/// fixture).

module velvet_glove.builtins.tools.DenoCheck

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "deno-check"
  displayName = "deno check"
  executable = "deno"
  installHint = "install deno with `brew install deno` or `curl -fsSL https://deno.land/install.sh | sh`"
  phaseInvocation = "per-file"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.js"; "**/*.js"
      "*.jsx"; "**/*.jsx"
      "*.ts"; "**/*.ts"
      "*.tsx"; "**/*.tsx"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "deno.json"; "deno.jsonc" }
    role = "ts-typecheck"
  }
}
