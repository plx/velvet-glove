/// Biome — Rust-based formatter and linter for JS/TS/JSON.
///
/// A malformed `biome.json` and a real lint finding both exit 1 (verified on
/// 2.5.14), so an operational failure is not distinguishable from "issues"
/// here; no `operational-failure` fixture is claimed.

module velvet_glove.builtins.tools.Biome

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "biome"
  displayName = "Biome"
  executable = "biome"
  installHint = "install biome with `brew install biome` or add `@biomejs/biome` to the project"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.js"; "**/*.js"
      "*.mjs"; "**/*.mjs"
      "*.cjs"; "**/*.cjs"
      "*.jsx"; "**/*.jsx"
      "*.ts"; "**/*.ts"
      "*.mts"; "**/*.mts"
      "*.cts"; "**/*.cts"
      "*.tsx"; "**/*.tsx"
      "*.json"; "**/*.json"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "check"
        "--write"
        "--no-errors-on-unmatched"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "check"
        "--no-errors-on-unmatched"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "biome.json"; "biome.jsonc" }
    contains = new Mapping<String, String> { ["package.json"] = "\"@biomejs/biome\"" }
    role = "js-format"
  }
}
