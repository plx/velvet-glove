/// Harper — grammar checker for commit messages (harper-cli on COMMIT_EDITMSG).
///
/// Disabled: not applicable to this product's hook model. Velvet Glove's
/// PostToolUse/deferred pipeline runs against files a coding agent edited
/// through its file-editing tools; `git commit` does not go through those
/// tools (an agent typically shells out to `git commit -m`, and even an
/// editor-driven commit writes `.git/COMMIT_EDITMSG`, a transient file well
/// outside any project the agent is editing). Confirmed empirically that
/// `harper-cli --no-color lint --format compact` is otherwise a correct
/// invocation (exits 0 clean / 1 with findings, same as `harper`), so this is
/// shipped as a catalog entry only, following the `cocogitto-commit-msg`
/// precedent, until a commit-message hook lifecycle exists.

module velvet_glove.builtins.tools.HarperCommitMessage

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "harper-commit-message"
  displayName = "Harper (commit message)"
  executable = "harper-cli"
  installHint = "install harper with `brew install harper`"
  enabled = false

  files = new Config.FileSelection {
    include = new Listing<String> {}
  }

  phases = new Mapping<String, Config.Phase> {}
  phaseOrder = new Listing<String> {}
}
