/// deadnix — finds (and optionally removes) unused bindings in Nix code.
///
/// Verified with deadnix 1.3.1: `--fail` exits 1 when unused bindings are
/// found and 0 otherwise. A parse error is printed but also exits 0 (deadnix
/// has no distinct exit code for it), so an unparseable file reads as clean
/// unless another file in the same batch has dead code — a tool limitation
/// this spec cannot work around. `--edit` deletes unused bindings in place,
/// which is why `detect` keeps the tool opt-in. Its report is ANSI-colored
/// even when piped and `NO_COLOR` is the only switch, so diagnostics carry
/// escape codes.

module velvet_glove.builtins.tools.Deadnix

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "deadnix"
  displayName = "deadnix"
  executable = "deadnix"
  installHint = "install deadnix with `nix-env -iA nixpkgs.deadnix` or `cargo install deadnix`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.nix"; "**/*.nix" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "--edit"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--fail"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    note = "opt-in only: its fix deletes unused bindings mid-edit"
  }
}
