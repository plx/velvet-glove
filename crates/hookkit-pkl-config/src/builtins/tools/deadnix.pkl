/// deadnix — finds (and optionally removes) unused bindings in Nix code.
///
/// Verified with deadnix 1.3.1: `--fail` exits 1 when unused bindings are
/// found and 0 otherwise, including on a parse error (deadnix has no
/// distinct exit code for a bad parse — that's a real limitation of the
/// tool, not something this spec can work around; a syntax error is silently
/// treated as "nothing to report" unless another file in the same batch also
/// has dead code). `--edit` removes the unused bindings and rewrites the
/// file in place; because that deletes code rather than just reformatting
/// it, the `fix` phase is disabled by default so a project must opt in
/// explicitly (`phases { ["fix"] { enabled = true } }`) before Velvet Glove
/// will auto-remove anything.

module velvet_glove.builtins.tools.Deadnix

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "deadnix"
  displayName = "deadnix"
  executable = "deadnix"
  installHint = "install deadnix with `nix-env -iA nixpkgs.deadnix` or `cargo install deadnix`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.nix"; "**/*.nix" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      // Opt-in: `--edit` deletes unused bindings/imports rather than just
      // reformatting, so autofix stays off until a project enables it.
      enabled = false
      argv = new Listing<String | Config.ArgToken> {
        "--edit"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--fail"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    note = "opt-in only: its fix deletes unused bindings mid-edit"
  }
}
