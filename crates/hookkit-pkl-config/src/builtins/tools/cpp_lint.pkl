/// cpplint — Google C++ style checker.
///
/// Verified at 2.0.2: style violations and a usage error (unknown flag) both
/// exit 1, and a broken `CPPLINT.cfg` (unknown config key) only warns and
/// still exits 0 after linting normally. There is no operational exit code
/// distinguishable from "issues found", so no `operational-failure` fixture
/// case is possible; see the fixture README note in this tool's directory.
module velvet_glove.builtins.tools.CppLint

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "cpplint"
  displayName = "cpplint"
  executable = "cpplint"
  installHint = "install cpplint with `pipx install cpplint`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.c"; "**/*.c"
      "*.h"; "**/*.h"
      "*.cpp"; "**/*.cpp"
      "*.hpp"; "**/*.hpp"
      "*.cc"; "**/*.cc"
      "*.hh"; "**/*.hh"
      "*.cxx"; "**/*.cxx"
      "*.hxx"; "**/*.hxx"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      // `--quiet` drops the per-file "Done processing <file>" lines, which
      // would otherwise name every file of a batch as if it had issues.
      argv = new Listing<String | Config.ArgToken> {
        "--quiet"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "CPPLINT.cfg" }
    role = "c-lint"
  }
}
