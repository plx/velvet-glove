/// Prettier — opinionated formatter for JS/TS/CSS/HTML/Markdown/YAML and friends.
///
/// Prettier uses status 1 for both formatting differences and configuration
/// failures. The isolated adapter accepts status 1 only when `--list-different`
/// emits a complete, duplicate-free subset of the exact selected files. It
/// disables implicit config, ignore, EditorConfig, cache, plugin, and pragma
/// discovery; an explicitly requested override-free JSON config is validated
/// as data and copied outside the project before Prettier loads it.
/// Replacing that source config after its validated read cannot affect the
/// private copy. Selected files can still be replaced or changed after the
/// adapter validates them, and a late native write failure can leave partial
/// writes; the adapter deliberately does not attempt unsafe rollback.
/// Format first runs that same read-only check across the complete batch so a
/// known parse/config failure cannot mutate an earlier file. A file changed
/// after that preflight is likewise outside the completed read-only evidence.

module velvet_glove.builtins.tools.Prettier

import "../Config.pkl" as Config

prettierAdapter: String = #"""
  import json
  import os
  import selectors
  import shutil
  import signal
  import stat
  import subprocess
  import sys
  import tempfile
  import time

  MARKER = "__VELVET_GLOVE_PRETTIER_FILES__"
  LIMIT = 16 * 1024 * 1024
  CONFIG_LIMIT = 1024 * 1024
  DEFAULT_CONFIG = "/dev/null"
  SAFE_CLI_OPTIONS = {
      "--arrow-parens",
      "--bracket-same-line",
      "--bracket-spacing",
      "--embedded-language-formatting",
      "--end-of-line",
      "--experimental-operator-position",
      "--experimental-ternaries",
      "--html-whitespace-sensitivity",
      "--jsx-single-quote",
      "--object-wrap",
      "--parser",
      "--print-width",
      "--prose-wrap",
      "--quote-props",
      "--semi",
      "--single-attribute-per-line",
      "--single-quote",
      "--tab-width",
      "--trailing-comma",
      "--use-tabs",
      "--vue-indent-script-and-style",
  }
  SAFE_CONFIG_OPTIONS = {
      "arrowParens",
      "bracketSameLine",
      "bracketSpacing",
      "embeddedLanguageFormatting",
      "endOfLine",
      "experimentalOperatorPosition",
      "experimentalTernaries",
      "htmlWhitespaceSensitivity",
      "jsxSingleQuote",
      "objectWrap",
      "parser",
      "printWidth",
      "proseWrap",
      "quoteProps",
      "semi",
      "singleAttributePerLine",
      "singleQuote",
      "tabWidth",
      "trailingComma",
      "useTabs",
      "vueIndentScriptAndStyle",
  }


  def fail(message):
      print(f"velvet-glove-prettier: {message}", file=sys.stderr)
      raise SystemExit(2)


  if len(sys.argv) < 6 or sys.argv[4:].count(MARKER) != 1:
      fail("invalid adapter arguments")

  requested_node = sys.argv[1]
  requested_tool = sys.argv[2]
  phase = sys.argv[3]
  payload = sys.argv[4:]
  marker_index = payload.index(MARKER)
  extra_args = payload[:marker_index]
  requested_files = payload[marker_index + 1 :]
  if phase not in ("format", "verify") or not requested_files:
      fail("invalid phase or empty file selection")

  config_argument = None
  forwarded_args = []
  for argument in extra_args:
      if "\n" in argument or "\r" in argument:
          fail("extra arguments cannot contain line breaks")
      if argument == "--" or not argument.startswith("--") or "=" not in argument:
          fail(
              f"unsupported argument {argument!r}; use a permitted long --name=value option"
          )
      option, value = argument.split("=", 1)
      if option != option.lower() or not value:
          fail(f"unsupported argument {argument!r}; option names are lowercase and values nonempty")
      if option == "--config":
          if config_argument is not None:
              fail("at most one explicit config is supported")
          config_argument = value
      elif option not in SAFE_CLI_OPTIONS:
          fail(f"unsupported argument {argument!r}; option can bypass the controlled contract")
      else:
          forwarded_args.append(argument)

  workspace = os.path.realpath(os.getcwd())
  if not os.path.isdir(workspace):
      fail(f"working directory is not a real directory: {workspace}")


  def controlled_path(value, label):
      if not value or "\n" in value or "\r" in value:
          fail(f"{label} is not a nonempty single-line path")
      lexical = os.path.abspath(value)
      try:
          inside = os.path.commonpath((workspace, lexical)) == workspace
      except ValueError:
          inside = False
      if not inside:
          fail(f"{label} escapes the project root: {value}")
      if os.path.realpath(lexical) != lexical:
          fail(f"{label} traverses a symlink: {value}")
      return lexical


  files = []
  file_identities = set()
  for requested in requested_files:
      path = controlled_path(requested, "selected path")
      try:
          info = os.lstat(path)
          if (
              os.path.islink(path)
              or not stat.S_ISREG(info.st_mode)
              or info.st_nlink != 1
          ):
              fail(f"selected path is not a unique regular file: {requested}")
          with open(path, "rb"):
              pass
      except OSError as error:
          fail(f"cannot read selected path {requested}: {error}")
      identity = (info.st_dev, info.st_ino)
      if identity in file_identities:
          fail(f"selected paths repeat or alias one file: {requested}")
      file_identities.add(identity)
      try:
          path.encode("utf-8")
      except UnicodeError as error:
          fail(f"selected path is not UTF-8: {error}")
      files.append(path)

  config_path = None
  validated_config_bytes = None


  def validate_config(value, label):
      if not isinstance(value, dict):
          fail(f"{label} must be a JSON object")
      for key, option_value in value.items():
          if key == "$schema":
              if not isinstance(option_value, str):
                  fail(f"{label} $schema must be a string")
          elif key == "overrides":
              fail(f"{label} overrides are unsupported because config is copied outside the project")
          elif key not in SAFE_CONFIG_OPTIONS:
              fail(f"{label} contains unsupported option {key!r}")


  if config_argument is not None:
      config_path = controlled_path(config_argument, "config path")
      name = os.path.basename(config_path)
      if name != ".prettierrc" and not name.endswith(".json"):
          fail("explicit config must be JSON named .prettierrc or ending in .json")
      config_fd = None
      try:
          open_flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
          config_fd = os.open(config_path, open_flags)
          info = os.fstat(config_fd)
          if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1:
              fail(f"config is not a unique regular file: {config_argument}")
          with os.fdopen(config_fd, "rb") as config_file:
              config_fd = None
              config_bytes = config_file.read(CONFIG_LIMIT + 1)
      except OSError as error:
          fail(f"cannot read config {config_argument}: {error}")
      finally:
          if config_fd is not None:
              os.close(config_fd)
      if len(config_bytes) > CONFIG_LIMIT:
          fail("config exceeds the 1 MiB validation limit")
      try:
          document = json.loads(config_bytes.decode("utf-8"))
      except (UnicodeError, json.JSONDecodeError) as error:
          fail(f"config is not canonical UTF-8 JSON: {error}")
      if name == "package.json":
          if not isinstance(document, dict) or "prettier" not in document:
              fail("package.json config has no prettier object")
          document = document["prettier"]
      validate_config(document, "Prettier config")
      validated_config_bytes = (
          json.dumps(document, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
          + "\n"
      ).encode("utf-8")


  def resolve_program(requested, label, must_be_executable):
      resolved = requested if os.path.dirname(requested) else shutil.which(requested)
      if resolved is None:
          fail(f"cannot resolve {label} {requested!r}")
      resolved = os.path.realpath(resolved)
      try:
          info = os.stat(resolved)
      except OSError as error:
          fail(f"cannot inspect {label} {resolved}: {error}")
      if not stat.S_ISREG(info.st_mode) or not os.access(resolved, os.R_OK):
          fail(f"resolved {label} is not a readable regular file: {resolved}")
      if must_be_executable and not os.access(resolved, os.X_OK):
          fail(f"resolved {label} is not executable: {resolved}")
      return resolved


  node = resolve_program(requested_node, "Node executable", True)
  tool = resolve_program(requested_tool, "Prettier CLI", False)

  environment = {}
  for name in (
      "VELVET_GLOVE_TOOL_TRACE_DIR",
      "VELVET_GLOVE_TOOL_TRACE_SENTINEL",
  ):
      if name in os.environ:
          environment[name] = os.environ[name]
  environment.update(
      {
          "PATH": "/usr/bin:/bin",
          "LANG": "C",
          "LC_ALL": "C",
          "TZ": "UTC",
          "TERM": "dumb",
          "CI": "1",
          "NO_COLOR": "1",
          "FORCE_COLOR": "0",
          "CLICOLOR": "0",
      }
  )

  process = None
  pending_signal = None
  reported_signal = None
  cleaning = False
  handled_signals = (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)


  class AdapterSignal(BaseException):
      def __init__(self, signum):
          super().__init__(f"received signal {signum}")
          self.signum = signum


  def signal_group(signum):
      if process is None:
          return
      try:
          os.killpg(process.pid, signum)
      except (OSError, ValueError):
          pass


  def process_group_exists():
      if process is None:
          return False
      try:
          os.killpg(process.pid, 0)
          return True
      except ProcessLookupError:
          return False
      except PermissionError:
          return True


  def sweep_process_group():
      if not process_group_exists():
          return False
      signal_group(signal.SIGKILL)
      deadline = time.monotonic() + 1
      while process_group_exists() and time.monotonic() < deadline:
          time.sleep(0.01)
      if process_group_exists():
          raise ValueError("cannot reap same-group descendants after child exit")
      return True


  def stop_child(initial_signal=None):
      global process
      global cleaning
      child = process
      if child is None:
          return
      cleaning = True
      try:
          try:
              running = child.poll() is None
          except (OSError, ValueError):
              running = True
          if running:
              signal_group(initial_signal if initial_signal is not None else signal.SIGTERM)
              try:
                  child.wait(timeout=1)
              except (OSError, ValueError, subprocess.TimeoutExpired):
                  pass
          signal_group(signal.SIGKILL)
          try:
              child.wait(timeout=1)
          except (OSError, ValueError, subprocess.TimeoutExpired):
              pass
      finally:
          process = None
          cleaning = False


  def forward_signal(signum, _frame):
      global pending_signal
      pending_signal = signum
      if process is not None and not cleaning:
          signal_group(signum)
          raise AdapterSignal(signum)


  def append_adapter_error(primary, secondary):
      if primary is None:
          return secondary
      return ValueError(f"{primary}; {secondary}")


  def apply_pending_signal(primary):
      global reported_signal
      if pending_signal is None or pending_signal == reported_signal:
          return primary
      reported_signal = pending_signal
      return append_adapter_error(primary, AdapterSignal(pending_signal))


  def drain_blocked_signals(primary):
      global pending_signal
      drained = False
      while True:
          queued = sorted(set(signal.sigpending()).intersection(handled_signals), key=int)
          if not queued:
              return primary, drained
          pending_signal = int(signal.sigwait({queued[0]}))
          primary = apply_pending_signal(primary)
          drained = True


  previous_handlers = {}
  total = 0
  adapter_error = None
  private_config_dir = None
  private_config_path = None
  stdout_bytes = b""
  stderr_bytes = b""
  returncode = 2


  def sanitize_private_error(error):
      message = str(error)
      if private_config_dir is not None:
          message = message.replace(private_config_dir, "<prettier-private>")
      elif isinstance(error, OSError) and error.filename is not None:
          filename = os.fsdecode(error.filename)
          candidate = os.path.abspath(filename)
          parent = os.path.dirname(candidate)
          if os.path.basename(candidate).startswith("velvet-glove-prettier-config-"):
              message = message.replace(candidate, "<prettier-private>")
          elif os.path.basename(parent).startswith("velvet-glove-prettier-config-"):
              message = message.replace(parent, "<prettier-private>")
      return message


  def sanitize_private_output(output):
      if private_config_dir is None:
          return output
      return output.replace(os.fsencode(private_config_dir), b"<prettier-private>")


  class EvidenceError(Exception):
      pass


  def validated_list_different(native_status, native_stdout, native_stderr, label):
      if native_status == 0:
          if native_stdout or native_stderr:
              raise EvidenceError(
                  f"{label} exited 0 with output instead of clean completion evidence"
              )
          return set()
      if native_status != 1 or native_stderr:
          raise EvidenceError(
              f"{label} exited {native_status} without valid list-different evidence"
          )
      try:
          output = native_stdout.decode("utf-8")
      except UnicodeError as error:
          raise EvidenceError(f"{label} emitted invalid list-different UTF-8: {error}")
      if not output.endswith("\n"):
          raise EvidenceError(f"{label} list-different output has no final newline")
      rendered_different = output.splitlines()
      if not rendered_different:
          raise EvidenceError(f"{label} list-different output is empty")
      different = [os.path.abspath(path) for path in rendered_different]
      if len(different) != len(set(different)):
          raise EvidenceError(f"{label} list-different output repeats files")
      selected = set(files)
      if any(path not in selected for path in different):
          raise EvidenceError(
              f"{label} list-different output names a file outside the selection"
          )
      return set(different)


  def child_arguments(config_for_child, native_mode):
      child_args = [node, tool, f"--config={config_for_child}"]
      if native_mode == "write":
          child_args.extend(("--write", "--log-level=error"))
      elif native_mode == "list":
          child_args.extend(("--list-different", "--log-level=log"))
      else:
          raise ValueError(f"unsupported native mode {native_mode!r}")
      child_args.extend(forwarded_args)
      child_args.extend(
          (
              "--no-editorconfig",
              "--ignore-path=/dev/null",
              "--with-node-modules",
              "--no-color",
              "--",
          )
      )
      child_args.extend(files)
      return child_args


  def run_child(child_args):
      global process
      global total
      if pending_signal is not None:
          raise AdapterSignal(pending_signal)
      process = subprocess.Popen(
          child_args,
          stdin=subprocess.DEVNULL,
          stdout=subprocess.PIPE,
          stderr=subprocess.PIPE,
          cwd=workspace,
          env=environment,
          start_new_session=True,
      )
      if pending_signal is not None:
          raise AdapterSignal(pending_signal)
      stdout_chunks = []
      stderr_chunks = []
      selector = selectors.DefaultSelector()
      try:
          for stream, target in (
              (process.stdout, stdout_chunks),
              (process.stderr, stderr_chunks),
          ):
              if stream is None:
                  raise OSError("failed to capture tool output")
              os.set_blocking(stream.fileno(), False)
              selector.register(stream, selectors.EVENT_READ, target)
          while selector.get_map():
              if pending_signal is not None:
                  raise InterruptedError(f"received signal {pending_signal}")
              for key, _ in selector.select(timeout=0.1):
                  chunk = os.read(key.fileobj.fileno(), 65536)
                  if chunk:
                      total += len(chunk)
                      if total > LIMIT:
                          raise BufferError(f"combined output exceeded {LIMIT} bytes")
                      key.data.append(chunk)
                  else:
                      selector.unregister(key.fileobj)
                      key.fileobj.close()
          native_status = process.wait()
          if sweep_process_group():
              raise EvidenceError("native Prettier left same-group descendants after child exit")
      finally:
          selector.close()
      process = None
      return native_status, b"".join(stdout_chunks), b"".join(stderr_chunks)


  try:
      for signum in handled_signals:
          previous_handlers[signum] = signal.signal(signum, forward_signal)
      if pending_signal is not None:
          raise AdapterSignal(pending_signal)
      config_for_child = DEFAULT_CONFIG
      if validated_config_bytes is not None:
          temp_root = os.path.realpath(tempfile.gettempdir())
          temp_info = os.stat(temp_root)
          if not stat.S_ISDIR(temp_info.st_mode):
              raise OSError(f"temporary root is not a directory: {temp_root}")
          if os.path.commonpath((workspace, temp_root)) == workspace:
              raise OSError(f"temporary root must be outside the project: {temp_root}")
          private_config_dir = tempfile.mkdtemp(
              prefix="velvet-glove-prettier-config-", dir=temp_root
          )
          os.chmod(private_config_dir, 0o700)
          private_config_path = os.path.join(private_config_dir, "config.json")
          private_fd = os.open(
              private_config_path,
              os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0),
              0o600,
          )
          try:
              os.fchmod(private_fd, 0o600)
              with os.fdopen(private_fd, "wb") as private_config:
                  private_fd = None
                  private_config.write(validated_config_bytes)
                  private_config.flush()
                  os.fsync(private_config.fileno())
          finally:
              if private_fd is not None:
                  os.close(private_fd)
          config_for_child = private_config_path
      if phase == "format":
          preflight_status, preflight_stdout, preflight_stderr = run_child(
              child_arguments(config_for_child, "list")
          )
          try:
              validated_list_different(
                  preflight_status,
                  preflight_stdout,
                  preflight_stderr,
                  "native Prettier format preflight",
              )
          except EvidenceError:
              stdout_bytes = preflight_stdout
              stderr_bytes = preflight_stderr
              raise
          returncode, stdout_bytes, stderr_bytes = run_child(
              child_arguments(config_for_child, "write")
          )
      else:
          returncode, stdout_bytes, stderr_bytes = run_child(
              child_arguments(config_for_child, "list")
          )
  except AdapterSignal as error:
      stop_child(error.signum)
      adapter_error = error
      reported_signal = error.signum
      returncode = 2
  except BaseException as error:
      stop_child()
      adapter_error = error
      returncode = 2
  finally:
      cleaning = True
      blocked_mask = None
      try:
          if private_config_path is not None:
              try:
                  os.unlink(private_config_path)
              except FileNotFoundError:
                  pass
              except OSError as error:
                  adapter_error = append_adapter_error(adapter_error, error)
                  returncode = 2
          if private_config_dir is not None:
              try:
                  os.rmdir(private_config_dir)
              except FileNotFoundError:
                  pass
              except OSError as error:
                  adapter_error = append_adapter_error(adapter_error, error)
                  returncode = 2
          try:
              blocked_mask = signal.pthread_sigmask(signal.SIG_BLOCK, handled_signals)
          except (OSError, ValueError) as error:
              adapter_error = append_adapter_error(
                  adapter_error, ValueError(f"cannot block cleanup signals: {error}")
              )
              returncode = 2
          adapter_error = apply_pending_signal(adapter_error)
          if blocked_mask is not None:
              while True:
                  adapter_error, drained = drain_blocked_signals(adapter_error)
                  if not drained:
                      break
          if adapter_error is not None:
              returncode = 2
      finally:
          # Keep handled signals blocked through diagnostics and process exit.
          # Unblocking after restoring default handlers would reopen the
          # post-cleanup termination window that this cutoff closes.
          try:
              for signum, handler in previous_handlers.items():
                  try:
                      signal.signal(signum, handler)
                  except (OSError, ValueError):
                      pass
          finally:
              cleaning = False
  process = None

  def forward_raw():
      if stdout_bytes:
          sys.stdout.buffer.write(sanitize_private_output(stdout_bytes))
      if stderr_bytes:
          sys.stderr.buffer.write(sanitize_private_output(stderr_bytes))


  if adapter_error is not None:
      forward_raw()
      fail(sanitize_private_error(adapter_error))

  if returncode == 0 and not stdout_bytes and not stderr_bytes:
      raise SystemExit(0)

  if phase == "verify" and returncode == 1:
      try:
          different_set = validated_list_different(
              returncode, stdout_bytes, stderr_bytes, "native Prettier verify"
          )
      except EvidenceError as error:
          forward_raw()
          fail(str(error))
      for path in files:
          if path in different_set:
              print(f"prettier: formatting differs: {path}", file=sys.stderr)
      raise SystemExit(1)

  forward_raw()
  fail(f"native Prettier exited {returncode} without valid completion evidence")
  """#

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "prettier"
  displayName = "Prettier"
  executable = "prettier"
  installHint = "install exact Prettier 3.9.6, its pinned Node 24.19.0 runtime, and a Python 3 interpreter with isolated-mode support"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.js"; "**/*.js"
      "*.jsx"; "**/*.jsx"
      "*.mjs"; "**/*.mjs"
      "*.cjs"; "**/*.cjs"
      "*.ts"; "**/*.ts"
      "*.tsx"; "**/*.tsx"
      "*.mts"; "**/*.mts"
      "*.cts"; "**/*.cts"
      "*.css"; "**/*.css"
      "*.scss"; "**/*.scss"
      "*.less"; "**/*.less"
      "*.html"; "**/*.html"
      "*.json"; "**/*.json"
      "*.json5"; "**/*.json5"
      "*.jsonc"; "**/*.jsonc"
      "*.yaml"; "**/*.yaml"
      "*.yml"; "**/*.yml"
      "*.markdown"; "**/*.markdown"
      "*.markdown.mdx"; "**/*.markdown.mdx"
      "*.md"; "**/*.md"
      "*.graphql"; "**/*.graphql"
      "*.handlebars"; "**/*.handlebars"
      "*.htmlangular"; "**/*.htmlangular"
      "*.vue"; "**/*.vue"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      program = "python"
      argv = new Listing<String | Config.ArgToken> {
        "-I"
        "-c"
        prettierAdapter
        "node"
        new Config.ToolExecutable {}
        "format"
        new Config.ExtraArgs {}
        "__VELVET_GLOVE_PRETTIER_FILES__"
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        failure = new Listing<Int> { 2 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      program = "python"
      argv = new Listing<String | Config.ArgToken> {
        "-I"
        "-c"
        prettierAdapter
        "node"
        new Config.ToolExecutable {}
        "verify"
        new Config.ExtraArgs {}
        "__VELVET_GLOVE_PRETTIER_FILES__"
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }
}
