/// just-format — format a Justfile with `just --fmt --unstable`.
///
/// `just --fmt --justfile <path>` only accepts a single justfile per
/// invocation. Batching two or more cited justfiles into one `Files` argv
/// expansion doesn't fail loudly — `just` reads the first path as the
/// `--justfile` value and the rest as *recipe names* to run, so it either
/// errors confusingly ("path-prefixed recipes may not be used with
/// --justfile", confirmed empirically) or, worse, tries to run recipes
/// instead of formatting. `phaseInvocation = "per-file"` makes the runner
/// invoke this tool once per cited file instead.

module velvet_glove.builtins.tools.JustFormat

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "just-format"
  displayName = "just --fmt"
  executable = "just"
  installHint = "install just with `brew install just` or `cargo install just`"
  phaseInvocation = "per-file"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "Justfile"; "justfile"
      "**/Justfile"; "**/justfile"
      "*.just"; "**/*.just"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "--fmt"
        "--unstable"
        new Config.ExtraArgs {}
        "--justfile"
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--fmt"
        "--unstable"
        "--check"
        new Config.ExtraArgs {}
        "--justfile"
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }

  detect = new Config.Detect {
    role = "just-format"
    note = "opt-in only: just's formatter is unstable"
  }
}
