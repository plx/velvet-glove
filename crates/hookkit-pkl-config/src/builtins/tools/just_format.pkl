/// just-format — format a Justfile with `just --fmt --unstable`.
///
/// `just --fmt --justfile <path>` formats exactly one justfile. Batching two
/// cited justfiles into one `Files` expansion makes `just` read the extra
/// paths as recipe arguments and exit 1 ("Path-prefixed recipes may not be
/// used with `--justfile`", just 1.45) without formatting anything, which
/// the format phase reports as an operational failure (see the `multi-file`
/// fixture). `phaseInvocation = "per-file"` runs one invocation per file.

module velvet_glove.builtins.tools.JustFormat

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "just-format"
  displayName = "just --fmt"
  executable = "just"
  installHint = "install just with `brew install just` or `cargo install just`"
  phaseInvocation = "per-file"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "Justfile"; "justfile"
      "**/Justfile"; "**/justfile"
      "*.just"; "**/*.just"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "--fmt"
        "--unstable"
        new Config.ExtraArgs {}
        "--justfile"
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--fmt"
        "--unstable"
        "--check"
        new Config.ExtraArgs {}
        "--justfile"
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }

  detect = new Config.Detect {
    role = "just-format"
    note = "opt-in only: just's formatter is unstable"
  }
}
