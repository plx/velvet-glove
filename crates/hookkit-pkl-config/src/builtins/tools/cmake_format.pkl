/// cmake-format — formatter for CMake listfiles.
///
/// Verified at 0.6.13 (cmakelang): `--check` exits 1 for a formatting issue,
/// reporting every dirty file in a batch, not just the first. Argument
/// parsing errors (e.g. an unrecognized flag) exit 2 for both `--check` and
/// `--in-place`, which is a genuine operational signal distinct from issues.
module velvet_glove.builtins.tools.CmakeFormat

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "cmake-format"
  displayName = "cmake-format"
  executable = "cmake-format"
  // The PyPI distribution is `cmakelang`; it provides the `cmake-format`
  // console-script entry point actually invoked here.
  installHint = "install cmake-format with `pipx install cmakelang`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "CMakeLists.txt"; "**/CMakeLists.txt"
      "*.cmake"; "**/*.cmake"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "--in-place"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        failure = new Listing<Int> { 2 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".cmake-format.yaml"; ".cmake-format.json"; ".cmake-format.py"; "cmake-format.yaml" }
    role = "cmake-format"
  }
}
