/// revive — fast, configurable Go linter, replacement for golint.
///
/// `-set_exit_status` makes revive exit 1 for both reported issues and a
/// file it cannot parse; there is no distinct exit code for the latter, so
/// no operational-failure fixture is included (the real tool can't produce
/// one distinguishable from a lint issue).

module velvet_glove.builtins.tools.Revive

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "revive"
  displayName = "revive"
  executable = "revive"
  installHint = "install revive with `go install github.com/mgechev/revive@latest`"
  workspaceIndicator = "go.mod"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.go"; "**/*.go" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "-set_exit_status"
        new Config.ExtraArgs {}
        "./..."
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "revive.toml" }
    role = "go-lint"
  }
}
