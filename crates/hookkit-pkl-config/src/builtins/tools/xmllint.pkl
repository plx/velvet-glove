/// xmllint — XML validator from libxml2.

module velvet_glove.builtins.tools.Xmllint

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "xmllint"
  displayName = "xmllint"
  executable = "xmllint"
  installHint = "xmllint ships with macOS; on Linux install via `apt install libxml2-utils` or `brew install libxml2`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.xml"; "**/*.xml" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--noout"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        // xmllint exits 1..9 for various parse/validation/usage errors; treat
        // them as issues so the runner surfaces the diagnostics. Verified
        // against libxml2 20913: a malformed document and a missing input
        // file both exit 1, so there is no code that distinguishes an
        // operational failure from a source issue here.
        issues = new Listing<Int> { 1; 2; 3; 4; 5; 6; 7; 8; 9 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    role = "xml-lint"
    default = true
  }
}
