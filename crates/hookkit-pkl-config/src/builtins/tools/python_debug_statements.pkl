/// python-debug-statements — flag leftover `breakpoint()` / `pdb.set_trace()`.
///
/// hk ships this behind its `hk util python-debug-statements` namespace, a
/// multi-line implementation we can't replicate as a single argv invocation
/// (see anti-goals: no embedded wrapper programs). This spec uses a plain
/// `grep -nH -E` instead. Validated empirically: it correctly flags a real
/// `breakpoint()`/`pdb.set_trace()` call, correctly ignores one that is
/// commented out (`^[^#]*` requires no `#` before the match), and correctly
/// classifies a missing file as an operational failure (exit 2), matching
/// grep's own semantics. Known limitation, left in place rather than
/// papered over: grep has no syntax awareness, so a string literal or
/// docstring that merely *mentions* `breakpoint()` is a false positive. For
/// projects that hit this often, ruff's `T100` (`flake8-debugger`) rule is a
/// syntax-aware alternative worth configuring instead.

module velvet_glove.builtins.tools.PythonDebugStatements

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "python-debug-statements"
  displayName = "python debug-statements"
  executable = "grep"
  installHint = "grep is part of any POSIX environment"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.py"; "**/*.py" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      // Flags any non-comment line containing `breakpoint()` or `pdb.set_trace()`.
      // grep exits 0 when a match is found (issues) and 1 when no match (clean).
      argv = new Listing<String | Config.ArgToken> {
        "-nH"
        "-E"
        #"^[^#]*(\bbreakpoint\(\)|pdb\.set_trace\(\))"#
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 1 }
        issues = new Listing<Int> { 0 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
