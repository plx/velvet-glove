/// tflint — Terraform linter.
///
/// Without `--recursive`, tflint only inspects `.tf` files in its current
/// working directory (here, the project root); a child module directory is
/// invisible to it and a real issue there is silently missed rather than
/// reported. `--recursive` makes each command walk every module directory
/// under the project root, which is why the deferred check/remedy declare an
/// explicit `workflows` entry scoped to the whole workspace instead of the
/// `target-files` scope the phase-derived default would otherwise assume.

module velvet_glove.builtins.tools.Tflint

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "tflint"
  displayName = "tflint"
  executable = "tflint"
  installHint = "install tflint with `brew install tflint`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.tf"; "**/*.tf" }
  }

  workflows = new Mapping<String, Config.Workflow> {
    ["lint"] = new Config.Workflow {
      check = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "--recursive"
          new Config.ExtraArgs {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          issues = new Listing<Int> { 2 }
        }
      }
      remedy = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "--fix"
          "--recursive"
          new Config.ExtraArgs {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          issues = new Listing<Int> { 2 }
        }
        writes = "matching-globs"
      }
      checkScope = "workspace"
      invocation = "workspace"
    }
  }
  workflowOrder = new Listing<String> { "lint" }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "--fix"
        "--recursive"
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 2 }
      }
      writes = "matching-globs"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--recursive"
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".tflint.hcl" }
    role = "terraform-lint"
  }
}
