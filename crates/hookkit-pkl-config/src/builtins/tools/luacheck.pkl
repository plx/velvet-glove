/// luacheck — static analyzer and linter for Lua.
///
/// Probed with luacheck 1.2.0: 0 = clean, 1 = warnings, 2 = syntax errors,
/// 3 = unreadable file, 4 = critical error (bad config or arguments). Codes 3
/// and 4 fall through to the default `unexpected = failure` policy.

module velvet_glove.builtins.tools.Luacheck

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "luacheck"
  displayName = "Luacheck"
  executable = "luacheck"
  installHint = "install luacheck via LuaRocks: `brew install luarocks && luarocks install luacheck`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.lua"; "**/*.lua" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1; 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".luacheckrc" }
    role = "lua-lint"
  }
}
