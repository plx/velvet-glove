/// Standard Ruby — opinionated RuboCop preset.
///
/// `--fix` is standardrb's safe autocorrect (it forwards to rubocop's `-a`).
/// A Ruby syntax error is reported as a normal `Lint/Syntax` offense (exit 1),
/// not silently ignored. Batch invocation attributes multiple files
/// correctly. Limitation: unlike plain rubocop, standardrb's own CLI does not
/// wrap `RuboCop::CLI#run`'s error handling, so an invalid `.standard.yml` (or
/// a missing file) raises an uncaught exception that also exits 1 — the same
/// code used for "issues found" (verified against standard 1.56.0). No
/// `operational-failure` fixture case is included because no input reliably
/// produces a distinguishable failure.

module velvet_glove.builtins.tools.StandardRb

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "standard-rb"
  displayName = "Standard Ruby"
  executable = "standardrb"
  installHint = "install standard with `gem install standard` or add it to the project Gemfile"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.rb"; "**/*.rb" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "--fix"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".standard.yml" }
    contains = new Mapping<String, String> { ["Gemfile"] = "standard" }
    role = "ruby-lint"
  }
}
