/// oxfmt — Fast Rust-powered code formatter from the Oxidation compiler project.
///
/// A malformed config file and an unformatted-file finding both exit 1
/// (verified on 0.70.0), so an operational failure is not distinguishable
/// from "issues" here; no `operational-failure` fixture is claimed.

module velvet_glove.builtins.tools.Oxfmt

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "oxfmt"
  displayName = "oxfmt"
  executable = "oxfmt"
  installHint = "install oxfmt with `npm i -g oxfmt` or add it to the project"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.js"; "**/*.js"
      "*.mjs"; "**/*.mjs"
      "*.cjs"; "**/*.cjs"
      "*.ts"; "**/*.ts"
      "*.mts"; "**/*.mts"
      "*.cts"; "**/*.cts"
      "*.jsx"; "**/*.jsx"
      "*.tsx"; "**/*.tsx"
      "*.mdx"; "**/*.mdx"
      "*.vue"; "**/*.vue"
      "*.json"; "**/*.json"
      "*.jsonc"; "**/*.jsonc"
      "*.json5"; "**/*.json5"
      "*.yaml"; "**/*.yaml"
      "*.yml"; "**/*.yml"
      "*.toml"; "**/*.toml"
      "*.md"; "**/*.md"
      "*.markdown"; "**/*.markdown"
      "*.html"; "**/*.html"
      "*.htm"; "**/*.htm"
      "*.css"; "**/*.css"
      "*.scss"; "**/*.scss"
      "*.less"; "**/*.less"
      "*.graphql"; "**/*.graphql"
      "*.gql"; "**/*.gql"
      "*.handlebars"; "**/*.handlebars"
      "*.hbs"; "**/*.hbs"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "--write"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".oxfmtrc.json"; ".oxfmtrc.jsonc" }
    contains = new Mapping<String, String> { ["package.json"] = "\"oxfmt\"" }
    role = "js-format"
  }
}
