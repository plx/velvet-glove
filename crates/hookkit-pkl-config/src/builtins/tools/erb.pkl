/// erb_lint — ERB template linter (Shopify).
///
/// Tool id is `erb` to keep the public hook name short; the underlying
/// executable is `erb_lint`. `.erb-lint.yml` is erb_lint's own deprecated
/// alias for `.erb_lint.yml`; both are real config filenames it still loads
/// (with a deprecation warning for the hyphenated one), so both remain
/// `detect` indicators. Batch invocation attributes multiple files correctly
/// (verified against erb_lint 0.9.0). Limitation: an invalid config file
/// exits 1, the same code used for "issues found", so an operational failure
/// there is not distinguishable from a lint result through the exit code.

module velvet_glove.builtins.tools.Erb

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "erb"
  displayName = "erb_lint"
  executable = "erb_lint"
  installHint = "install erb_lint with `gem install erb_lint` or add it to the project Gemfile"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.erb"; "**/*.erb" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "--autocorrect"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        unexpected = "failure"
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".erb-lint.yml"; ".erb_lint.yml" }
    role = "erb-lint"
  }
}
