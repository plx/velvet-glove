/// hadolint — Dockerfile linter.
///
/// hadolint lints a `Containerfile` (the Podman/Buildah name) exactly like a
/// `Dockerfile`; the glob covers both names.
/// A missing `--config` file also exits 1, the same code as a lint finding;
/// hadolint does not expose a distinct exit status for the two. `--no-color`
/// keeps ANSI escapes out of diagnostics piped to a non-TTY, which hadolint
/// otherwise emits unconditionally.

module velvet_glove.builtins.tools.Hadolint

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "hadolint"
  displayName = "hadolint"
  executable = "hadolint"
  installHint = "install hadolint with `brew install hadolint`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "Dockerfile"
      "Dockerfile.*"
      "**/Dockerfile"
      "**/Dockerfile.*"
      "Containerfile"
      "Containerfile.*"
      "**/Containerfile"
      "**/Containerfile.*"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--no-color"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".hadolint.yaml"; ".hadolint.yml" }
    role = "docker-lint"
    default = true
  }
}
