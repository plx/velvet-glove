/// reek — Ruby code-smell detector.
///
/// Batch invocation is safe: reek accepts and correctly attributes multiple
/// file arguments (verified against reek 6.5.0). An invalid `.reek.yml`
/// raises an error and exits 1, distinct from both `clean` (0) and `issues`
/// (2), so it is already classified as a failure by the default `unexpected`
/// policy. Limitation: a Ruby syntax error in a scanned file is reported on
/// stdout as outside reek's scope but still exits 0 (looks clean), so that
/// case cannot be distinguished from a real clean pass through the exit code.

module velvet_glove.builtins.tools.Reek

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "reek"
  displayName = "reek"
  executable = "reek"
  installHint = "install reek with `gem install reek` or add it to the project Gemfile"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.rb"; "**/*.rb" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 2 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".reek.yml" }
  }
}
