/// selene — fast, opinionated Lua linter (Rust-based).
///
/// Verified against selene 0.31.0: lint warnings, parse errors, and a
/// malformed `selene.toml` all exit 1, so there is no exit code that
/// distinguishes an operational failure from a source issue; both are
/// reported as issues and there is no `operational-failure` fixture.

module velvet_glove.builtins.tools.Selene

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "selene"
  displayName = "Selene"
  executable = "selene"
  installHint = "install selene with `brew install selene` or `cargo install selene`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.lua"; "**/*.lua" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "selene.toml" }
    role = "lua-lint"
  }
}
