/// check-conventional-commit — verify a commit message matches Conventional Commits.
///
// NOT APPLICABLE to agent file hooks: this is a `commit-msg` hook in
// pre-commit / hk terminology (`hk util check-conventional-commit
// <commit-msg-file>`) — it takes the commit-message *file*, not project
// files, and only ever runs at commit time. Velvet Glove's post-tool-use
// hook fires after an edit, not a commit, and has no commit-message context
// to hand it. Listed here for catalog completeness; kept disabled.

module velvet_glove.builtins.tools.CheckConventionalCommit

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "check-conventional-commit"
  displayName = "check-conventional-commit"
  executable = "hk"
  installHint = "install hk from https://github.com/jdx/hk; this tool is currently a thin wrapper around `hk util check-conventional-commit`"
  enabled = false

  files = new Config.FileSelection {
    include = new Listing<String> {}
  }

  phases = new Mapping<String, Config.Phase> {}
  phaseOrder = new Listing<String> {}
}
