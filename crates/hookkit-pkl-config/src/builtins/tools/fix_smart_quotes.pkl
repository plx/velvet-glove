/// fix-smart-quotes — flag typographic quotes that should be plain ASCII.
///
/// Backed by hk's (jdx/hk) `hk util fix-smart-quotes --check`, covering
/// U+2018/U+2019/U+201C/U+201D. Deliberately check-only: hk's fixing mode
/// (the command with no flag) truncates any non-UTF-8 file, binary or
/// legacy-encoded text, to zero bytes and exits 0, as the `non-utf8`
/// fixture demonstrates. `--check` reports such files clean and never
/// mutates. A missing path with `--check` exits 1, the same code as a real
/// issue, so an I/O error cannot be told apart from found smart quotes; a
/// malformed invocation (bad flag) exits 2 and is classified as a failure.

module velvet_glove.builtins.tools.FixSmartQuotes

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "fix-smart-quotes"
  displayName = "fix-smart-quotes"
  executable = "hk"
  installHint = "install hk, e.g. `brew install hk` or `mise use -g hk`"

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "util"
        "fix-smart-quotes"
        "--check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    note = "opt-in only: flags smart quotes in every edited file"
  }
}
