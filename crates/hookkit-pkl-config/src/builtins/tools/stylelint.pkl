/// stylelint — CSS / SCSS / Less / Sass linter and auto-fixer.
///
/// A malformed config file is a genuinely distinguishable operational
/// failure (a JS exception, not exit 2 "issues"), but stylelint reports it
/// by dumping an uncaught exception's full Node stack trace, including
/// absolute paths into its own installed `node_modules` — outside the
/// fixture workspace, so the harness cannot normalize them and the paths
/// vary per machine/install. No `operational-failure` fixture is claimed
/// for that reason (not because the failure is unclassifiable).

module velvet_glove.builtins.tools.Stylelint

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "stylelint"
  displayName = "stylelint"
  executable = "stylelint"
  installHint = "install stylelint with `npm install --global stylelint`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.css"; "**/*.css"
      "*.scss"; "**/*.scss"
      "*.sass"; "**/*.sass"
      "*.less"; "**/*.less"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "--fix"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 2 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }
}
