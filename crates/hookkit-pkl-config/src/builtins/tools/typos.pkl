/// typos — source-code typo finder with autofix support.

module velvet_glove.builtins.tools.Typos

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "typos"
  displayName = "typos"
  executable = "typos"
  installHint = "install typos with `brew install typos-cli`"

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "--force-exclude"
        "--color"
        "never"
        "--write-changes"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 2 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--force-exclude"
        "--color"
        "never"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "_typos.toml"; "typos.toml"; ".typos.toml" }
    note = "config-only: its fix can rename identifiers in one file"
  }
}
