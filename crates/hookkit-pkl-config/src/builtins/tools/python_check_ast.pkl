/// python-check-ast — validate Python syntax by parsing it, read-only.
///
/// hk implements this as `hk util python-check-ast`. We previously translated
/// it to the standard-library `py_compile` module, but `py_compile` writes a
/// `.pyc` into `__pycache__/` next to each file even though this phase
/// declares `writes = "none"` — demonstrated: running it against a clean file
/// leaves a `__pycache__/<name>.cpython-*.pyc` behind. `compile(..., "exec")`
/// parses the same way without ever touching bytecode-cache files, so this
/// spec uses a single-expression `python3 -c` invocation instead of a module.
/// Any `extraArgs` here are extra positional arguments to that expression
/// (i.e. more paths), not flags, since `-c` leaves no room for python3-level
/// flags; that matches this tool's narrow, flag-free role.

module velvet_glove.builtins.tools.PythonCheckAst

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "python-check-ast"
  displayName = "python check-ast"
  executable = "python3"
  installHint = "install Python 3 (e.g. `brew install python`)"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.py"; "**/*.py" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "-c"
        "import sys; [compile(open(p, 'rb').read(), p, 'exec') for p in sys.argv[1:]]"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    note = "opt-in only: Python linters already report syntax errors"
  }
}
