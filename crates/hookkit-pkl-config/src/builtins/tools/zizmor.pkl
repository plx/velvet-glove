/// zizmor — GitHub Actions static analysis / security linter.
///
/// zizmor only collects workflows, action definitions and Dependabot config;
/// fed any other YAML file it collects zero inputs and exits 3 ("no inputs
/// collected"), a spurious operational failure. The glob is scoped to the
/// file shapes zizmor actually audits.

module velvet_glove.builtins.tools.Zizmor

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "zizmor"
  displayName = "zizmor"
  executable = "zizmor"
  installHint = "install zizmor with `brew install zizmor` or `pipx install zizmor`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      ".github/workflows/*.yml"; ".github/workflows/*.yaml"
      "**/.github/workflows/*.yml"; "**/.github/workflows/*.yaml"
      "action.yml"; "action.yaml"
      "**/action.yml"; "**/action.yaml"
      ".github/dependabot.yml"; ".github/dependabot.yaml"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "--no-progress"
        "-qq"
        "--fix"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 10; 11; 12; 13; 14 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--no-progress"
        "-qq"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 10; 11; 12; 13; 14 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "zizmor.yml"; "zizmor.yaml"; ".github/zizmor.yml"; ".github/zizmor.yaml" }
  }
}
