/// trailing-whitespace — strip trailing whitespace from text files.
///
/// Backed by hk's (jdx/hk) `hk util trailing-whitespace`. With no flag it
/// checks without mutating and exits 1 when trailing whitespace is found;
/// `--fix` removes it, including Markdown's two-space hard line breaks (hk
/// has no Markdown exemption). A missing path is silently treated as clean
/// (exit 0); a malformed invocation (bad flag) exits 2.

module velvet_glove.builtins.tools.TrailingWhitespace

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "trailing-whitespace"
  displayName = "trailing-whitespace"
  executable = "hk"
  installHint = "install hk, e.g. `brew install hk` or `mise use -g hk`"

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "util"
        "trailing-whitespace"
        "--fix"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "util"
        "trailing-whitespace"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    note = "opt-in only: rewrites trailing whitespace in every edited file"
  }
}
