/// tsserver — TypeScript language-server style file-targeted type checks.
///
/// Uses `tsc-files` (a thin shim around `tsc`) so individual files can be
/// checked while still respecting the nearest `tsconfig.json`.
///
/// Known upstream limitation (tsc-files 1.1.4): it spawns
/// `<typescript-package-dir>/../.bin/tsc` and exits 0 when that path is
/// missing, which is the case under pnpm's default isolated `node_modules`
/// (verified with pnpm 10.26.2 and TypeScript 5 and 7). Type errors are then
/// silently reported clean. npm's hoisted layout works; prefer the `tsc`
/// builtin in pnpm projects.

module velvet_glove.builtins.tools.Tsserver

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "tsserver"
  displayName = "tsserver"
  executable = "tsc-files"
  installHint = "install with `npm i -g tsc-files typescript` or add them to the project"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.ts"; "**/*.ts"
      "*.tsx"; "**/*.tsx"
      "*.mts"; "**/*.mts"
      "*.cts"; "**/*.cts"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--noEmit"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1; 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    contains = new Mapping<String, String> { ["package.json"] = "\"tsc-files\"" }
    role = "ts-typecheck"
  }
}
