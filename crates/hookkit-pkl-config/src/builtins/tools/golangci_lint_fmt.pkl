/// golangci-lint fmt — the formatter half of golangci-lint (v2+).
///
/// `fmt` takes explicit file paths (unlike `run`, which needs `./...`), so it
/// formats only the files it is given and needs no workspace resolution.
/// `--diff` is non-mutating and prints a unified diff on stdout while
/// exiting 1 when formatting would change something, 0 when clean. A file
/// the formatters can't parse also exits 0 with only a stderr warning: like
/// several other Go tools in this catalog, a build failure isn't
/// distinguishable from "already formatted" here, so no operational-failure
/// fixture is included for that case. A malformed `.golangci.yml` (for
/// example naming an unknown formatter) is distinguishable: golangci-lint
/// exits 3 before it looks at any file.

module velvet_glove.builtins.tools.GolangciLintFmt

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "golangci-lint-fmt"
  displayName = "golangci-lint fmt"
  executable = "golangci-lint"
  installHint = "install golangci-lint (v2+) with `brew install golangci-lint`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.go"; "**/*.go" }
  }

  workflows = new Mapping<String, Config.Workflow> {
    ["format"] = new Config.Workflow {
      check = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "fmt"
          "--diff"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          issues = new Listing<Int> { 1 }
          unexpected = "failure"
        }
      }
      remedy = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "fmt"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          unexpected = "failure"
        }
        writes = "target-files"
      }
      checkScope = "target-files"
      invocation = "batch"
    }
  }
  workflowOrder = new Listing<String> { "format" }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "fmt"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        unexpected = "failure"
      }
      writes = "target-files"
    }
  }
  phaseOrder = new Listing<String> { "format" }

  // No indicators: gofmt already claims go-format for every go.mod, and a
  // `.golangci.yml` usually configures only linters, so an indicator here
  // would select two formatters for one mutually exclusive role.
  detect = new Config.Detect {
    role = "go-format"
    note = "opt-in only: needs golangci-lint v2+ (the `fmt` subcommand)"
  }
}
