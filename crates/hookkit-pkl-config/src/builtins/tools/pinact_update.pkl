/// pinact (update mode) — pin GitHub Actions and update to latest versions.
///
/// `--update` additionally bumps each action to its latest release, which is
/// a more disruptive rewrite than plain pinning (it can pull in breaking
/// changes). Like plain pinact, `--verify` requires GitHub API access on
/// every run, including an already up-to-date "clean" file, and a bad `-c`
/// config path shares pinact's exit 1 with a real pin/update issue.

module velvet_glove.builtins.tools.PinactUpdate

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "pinact-update"
  displayName = "pinact (update)"
  executable = "pinact"
  installHint = "install pinact with `brew install pinact`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.yml"; "*.yaml"
      "**/*.yml"; "**/*.yaml"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "run"
        "--update"
        "--verify"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "run"
        "--update"
        "--verify"
        "--check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    note = "opt-in only: bumps action versions"
  }
}
