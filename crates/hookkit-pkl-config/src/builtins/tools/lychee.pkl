/// lychee — fast async link checker for Markdown, HTML, and friends.
///
/// `hk` ships `lychee` as a `check`-only step over text files. The CLI is
/// straightforward — pass the input paths and inspect the exit code. Verified
/// empirically against real lychee 0.24.2: `0` on every link reachable, `2`
/// on any broken link, `1` on a bad/missing input argument, and `3` on a
/// malformed `--config` file; `3` isn't listed explicitly but still falls
/// through to `exitCodes.unexpected`'s "failure" default. Local (non-http)
/// links are checked without network access, which is what the fixtures
/// exercise; the tool still needs the network for real `https://` targets,
/// which is why it stays opt-in (`detect` requires a project indicator).

module velvet_glove.builtins.tools.Lychee

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "lychee"
  displayName = "lychee"
  executable = "lychee"
  installHint = "install lychee with `brew install lychee` or `cargo install lychee`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.md"; "**/*.md"
      "*.markdown"; "**/*.markdown"
      "*.mdx"; "**/*.mdx"
      "*.html"; "**/*.html"
      "*.htm"; "**/*.htm"
      "*.rst"; "**/*.rst"
      "*.txt"; "**/*.txt"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--no-progress"
        new Config.ExtraArgs {}
        "--"
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 2 }
        failure = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "lychee.toml"; ".lycheeignore" }
    note = "config-only: checks links over the network"
  }
}
