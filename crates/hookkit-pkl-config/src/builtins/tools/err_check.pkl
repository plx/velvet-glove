/// errcheck — reports unchecked errors in Go programs.
///
/// errcheck delegates package discovery and type checking to the Go command.
/// The isolated adapter fixes that command's module, toolchain, network, and
/// workspace inputs; proves the complete package scope before checking; and
/// validates errcheck's native diagnostic protocol before forwarding it.

module velvet_glove.builtins.tools.ErrCheck

import "../Config.pkl" as Config

errCheckAdapter: String = #"""
  import hashlib
  import json
  import os
  import re
  import selectors
  import shutil
  import signal
  import stat
  import subprocess
  import sys
  import tempfile

  MARKER = "__VELVET_GLOVE_ERRCHECK_WORKSPACE__"
  LIMIT = 16 * 1024 * 1024
  SOURCE_LIMIT = 64 * 1024 * 1024
  SOURCE_COUNT_LIMIT = 4096
  DIAGNOSTIC = re.compile(
      r"^(?P<path>.+):(?P<line>[1-9][0-9]*):(?P<column>[1-9][0-9]*):\t(?P<source>.*)$"
  )


  def fail(message):
      print(f"velvet-glove-errcheck: {message}", file=sys.stderr)
      raise SystemExit(2)


  if len(sys.argv) < 5 or sys.argv[3:].count(MARKER) != 1:
      fail("invalid adapter arguments")

  requested_tool = sys.argv[1]
  requested_go = sys.argv[2]
  payload = sys.argv[3:]
  marker_index = payload.index(MARKER)
  extra_args = payload[:marker_index]
  indicators = payload[marker_index + 1 :]
  if requested_tool != "errcheck" or requested_go != "go":
      fail("the checker and Go executables must be errcheck and go")
  if extra_args:
      fail("extra arguments are unsupported because they can change package scope or diagnostic semantics")
  if len(indicators) != 1:
      fail("the adapter requires exactly one workspace indicator")

  requested_manifest = os.path.abspath(indicators[0])
  try:
      manifest_info = os.lstat(requested_manifest)
      if (
          stat.S_ISLNK(manifest_info.st_mode)
          or not stat.S_ISREG(manifest_info.st_mode)
          or manifest_info.st_nlink != 1
      ):
          fail(f"workspace manifest is not a unique regular file: {requested_manifest}")
      manifest = os.path.realpath(requested_manifest)
      if manifest != requested_manifest or os.path.basename(manifest) != "go.mod":
          fail(f"workspace manifest path is not canonical: {requested_manifest}")
      workspace = os.path.dirname(manifest)
      workspace_info = os.lstat(workspace)
      if stat.S_ISLNK(workspace_info.st_mode) or not stat.S_ISDIR(workspace_info.st_mode):
          fail(f"workspace is not a real directory: {workspace}")
  except OSError as error:
      fail(f"cannot inspect workspace manifest {requested_manifest}: {error}")


  def file_snapshot(path, size_limit=LIMIT):
      initial = os.lstat(path)
      if stat.S_ISLNK(initial.st_mode) or not stat.S_ISREG(initial.st_mode) or initial.st_nlink != 1:
          raise ValueError(f"path is not a unique regular file: {path}")
      flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
      descriptor = os.open(path, flags)
      with os.fdopen(descriptor, "rb", closefd=True) as source_file:
          opened = os.fstat(source_file.fileno())
          if (
              not stat.S_ISREG(opened.st_mode)
              or opened.st_nlink != 1
              or opened.st_dev != initial.st_dev
              or opened.st_ino != initial.st_ino
          ):
              raise ValueError(f"path changed while it was opened: {path}")
          content = source_file.read(size_limit + 1)
          final = os.fstat(source_file.fileno())
      if len(content) > size_limit:
          raise ValueError(f"path exceeds the {size_limit}-byte validation limit: {path}")
      stable_fields = ("st_dev", "st_ino", "st_mode", "st_nlink", "st_size", "st_mtime_ns")
      if any(getattr(opened, field) != getattr(final, field) for field in stable_fields):
          raise ValueError(f"path changed while it was read: {path}")
      return {
          "device": final.st_dev,
          "inode": final.st_ino,
          "mode": stat.S_IMODE(final.st_mode),
          "size": final.st_size,
          "mtime": final.st_mtime_ns,
          "sha256": hashlib.sha256(content).hexdigest(),
          "content": content,
      }


  def scan_workspace():
      sources = {}
      total_size = 0

      def walk_error(error):
          raise ValueError(f"cannot walk workspace: {error}")

      for directory, child_directories, names in os.walk(
          workspace, followlinks=False, onerror=walk_error
      ):
          if directory != workspace and "go.mod" in names:
              child_directories[:] = []
              continue
          retained = []
          for name in child_directories:
              path = os.path.join(directory, name)
              if name in {".git", "node_modules", "target", "testdata", "vendor"}:
                  continue
              if name.startswith(".") or name.startswith("_"):
                  continue
              if os.path.islink(path):
                  raise ValueError(f"workspace contains a symlink directory: {path}")
              retained.append(name)
          child_directories[:] = retained
          for name in names:
              if not name.endswith(".go"):
                  continue
              path = os.path.join(directory, name)
              relative = os.path.relpath(path, workspace).replace(os.sep, "/")
              snapshot = file_snapshot(path)
              total_size += snapshot["size"]
              if len(sources) >= SOURCE_COUNT_LIMIT:
                  raise ValueError(
                      f"workspace contains more than {SOURCE_COUNT_LIMIT} Go source files"
                  )
              if total_size > SOURCE_LIMIT:
                  raise ValueError(
                      f"workspace Go sources exceed the {SOURCE_LIMIT}-byte validation limit"
                  )
              sources[relative] = snapshot
      if not sources:
          raise ValueError("workspace contains no physical Go source files")
      controls = {manifest: file_snapshot(manifest, 1024 * 1024)}
      go_sum = os.path.join(workspace, "go.sum")
      if os.path.lexists(go_sum):
          controls[go_sum] = file_snapshot(go_sum)
      return sources, controls


  try:
      source_snapshots, control_snapshots = scan_workspace()
  except (OSError, ValueError) as error:
      fail(str(error))


  def resolve_program(name):
      resolved = shutil.which(name)
      if resolved is None:
          fail(f"cannot resolve required executable {name!r}")
      resolved = os.path.abspath(resolved)
      try:
          info = os.stat(resolved)
      except OSError as error:
          fail(f"cannot inspect required executable {resolved}: {error}")
      if not stat.S_ISREG(info.st_mode) or not os.access(resolved, os.X_OK):
          fail(f"required executable is not a regular executable file: {resolved}")
      return resolved


  tool = resolve_program(requested_tool)
  go_launcher = resolve_program(requested_go)
  inherited_modcache = os.environ.get("GOMODCACHE")
  temporary_parent = os.environ.get("TMPDIR", "")
  if not os.path.isabs(temporary_parent):
      fail("TMPDIR must be an absolute path")
  temporary_parent = os.path.realpath(temporary_parent)
  if not os.path.isdir(temporary_parent):
      fail("TMPDIR must identify an existing directory")
  if inherited_modcache is not None:
      if not os.path.isabs(inherited_modcache):
          fail("GOMODCACHE must be absolute when configured")
      canonical_modcache = os.path.realpath(inherited_modcache)
      if canonical_modcache != inherited_modcache or not os.path.isdir(canonical_modcache):
          fail("GOMODCACHE must identify a canonical existing directory")
      inherited_modcache = canonical_modcache

  private_root = None
  process = None
  pending_signal = None
  cleaning = False


  class AdapterSignal(BaseException):
      def __init__(self, signum):
          super().__init__(f"received signal {signum}")
          self.signum = signum


  def signal_group(signum):
      if process is None:
          return
      try:
          os.killpg(process.pid, signum)
      except (OSError, ValueError):
          pass


  def stop_child(initial_signal=None):
      global process
      global cleaning
      child = process
      if child is None:
          return
      cleaning = True
      try:
          try:
              running = child.poll() is None
          except (OSError, ValueError):
              running = True
          if running:
              signal_group(initial_signal if initial_signal is not None else signal.SIGTERM)
              try:
                  child.wait(timeout=1)
              except (OSError, ValueError, subprocess.TimeoutExpired):
                  pass
          signal_group(signal.SIGKILL)
          try:
              child.wait(timeout=1)
          except (OSError, ValueError, subprocess.TimeoutExpired):
              pass
      finally:
          process = None
          cleaning = False


  def forward_signal(signum, _frame):
      global pending_signal
      pending_signal = signum
      if process is not None and not cleaning:
          signal_group(signum)
          raise AdapterSignal(signum)


  def run_child(arguments, environment):
      global process
      stdout_chunks = []
      stderr_chunks = []
      total = 0
      try:
          if pending_signal is not None:
              raise AdapterSignal(pending_signal)
          process = subprocess.Popen(
              arguments,
              stdin=subprocess.DEVNULL,
              stdout=subprocess.PIPE,
              stderr=subprocess.PIPE,
              cwd=workspace,
              env=environment,
              start_new_session=True,
          )
          if pending_signal is not None:
              raise AdapterSignal(pending_signal)
          selector = selectors.DefaultSelector()
          for stream, target in ((process.stdout, stdout_chunks), (process.stderr, stderr_chunks)):
              if stream is None:
                  raise OSError("failed to capture tool output")
              os.set_blocking(stream.fileno(), False)
              selector.register(stream, selectors.EVENT_READ, target)
          while selector.get_map():
              if pending_signal is not None:
                  raise AdapterSignal(pending_signal)
              for key, _ in selector.select(timeout=0.1):
                  chunk = os.read(key.fileobj.fileno(), 65536)
                  if chunk:
                      total += len(chunk)
                      if total > LIMIT:
                          raise BufferError(f"combined output exceeded {LIMIT} bytes")
                      key.data.append(chunk)
                  else:
                      selector.unregister(key.fileobj)
                      key.fileobj.close()
          status = process.wait()
          process = None
          if pending_signal is not None:
              raise AdapterSignal(pending_signal)
          return status, b"".join(stdout_chunks), b"".join(stderr_chunks)
      except AdapterSignal as error:
          stop_child(error.signum)
          raise
      except BaseException:
          stop_child()
          raise


  def assert_workspace_unchanged():
      current_sources, current_controls = scan_workspace()
      if set(current_sources) != set(source_snapshots):
          raise ValueError("workspace Go source set changed while errcheck was running")
      if set(current_controls) != set(control_snapshots):
          raise ValueError("workspace module controls changed while errcheck was running")
      for label, before, after in (
          ("Go source", source_snapshots, current_sources),
          ("module control", control_snapshots, current_controls),
      ):
          for path, initial in before.items():
              current = after[path]
              for field in ("device", "inode", "mode", "size", "mtime", "sha256"):
                  if current[field] != initial[field]:
                      raise ValueError(f"{label} changed while errcheck was running: {path}")


  def parse_json_object(raw, label):
      try:
          value = json.loads(raw.decode("utf-8"))
      except (UnicodeError, json.JSONDecodeError) as error:
          raise ValueError(f"{label} is not one UTF-8 JSON object: {error}")
      if not isinstance(value, dict):
          raise ValueError(f"{label} JSON root is not an object")
      return value


  def parse_json_stream(raw, label):
      try:
          text = raw.decode("utf-8")
      except UnicodeError as error:
          raise ValueError(f"{label} is not UTF-8: {error}")
      decoder = json.JSONDecoder()
      records = []
      cursor = 0
      while True:
          while cursor < len(text) and text[cursor].isspace():
              cursor += 1
          if cursor == len(text):
              break
          try:
              record, cursor = decoder.raw_decode(text, cursor)
          except json.JSONDecodeError as error:
              raise ValueError(f"{label} is not a complete JSON object stream: {error}")
          if not isinstance(record, dict):
              raise ValueError(f"{label} contains a non-object record")
          records.append(record)
      if not records:
          raise ValueError(f"{label} returned no package records")
      return records


  def package_file(directory, value, label):
      if not isinstance(value, str) or not value or os.path.basename(value) != value:
          raise ValueError(f"{label} is not one package-local filename: {value!r}")
      path = os.path.realpath(os.path.join(directory, value))
      if os.path.commonpath((workspace, path)) != workspace:
          raise ValueError(f"{label} escapes the selected workspace: {value!r}")
      return os.path.relpath(path, workspace).replace(os.sep, "/")


  def validate_package_scope(raw):
      records = parse_json_stream(raw, "go list preflight")
      analyzed = set()
      ignored = set()
      workspace_packages = 0
      for record in records:
          if record.get("Incomplete") is True or record.get("Error") is not None:
              raise ValueError("go list reported an incomplete package")
          dependency_errors = record.get("DepsErrors", [])
          if dependency_errors not in (None, []):
              raise ValueError("go list reported dependency errors")
          directory_value = record.get("Dir")
          if not isinstance(directory_value, str) or not os.path.isabs(directory_value):
              raise ValueError("go list package directory is not absolute")
          directory = os.path.realpath(directory_value)
          if os.path.commonpath((workspace, directory)) != workspace:
              raise ValueError(f"go list package escaped the selected workspace: {directory}")
          module = record.get("Module")
          if not isinstance(module, dict):
              raise ValueError("go list workspace package omitted module metadata")
          go_mod = module.get("GoMod")
          if not isinstance(go_mod, str) or os.path.realpath(go_mod) != manifest:
              raise ValueError("go list package belongs to a different module")
          workspace_packages += 1
          for key in ("GoFiles", "CgoFiles", "TestGoFiles", "XTestGoFiles"):
              values = record.get(key, [])
              if not isinstance(values, list) or any(not isinstance(value, str) for value in values):
                  raise ValueError(f"go list {key} is not a string array")
              for value in values:
                  analyzed.add(package_file(directory, value, f"go list {key} entry"))
          invalid_files = record.get("InvalidGoFiles", [])
          if invalid_files not in (None, []):
              raise ValueError("go list reported invalid Go files")
          ignored_files = record.get("IgnoredGoFiles", [])
          if not isinstance(ignored_files, list) or any(
              not isinstance(value, str) for value in ignored_files
          ):
              raise ValueError("go list IgnoredGoFiles is not a string array")
          for value in ignored_files:
              ignored.add(package_file(directory, value, "go list IgnoredGoFiles entry"))
      if workspace_packages == 0 or not analyzed:
          raise ValueError("go list found no analyzable workspace package sources")
      physical = set(source_snapshots)
      uncovered = sorted(physical - analyzed - ignored)
      unexpected = sorted((analyzed | ignored) - physical)
      if uncovered:
          raise ValueError("go list omitted physical Go sources: " + ", ".join(uncovered))
      if unexpected:
          raise ValueError("go list reported unvalidated Go sources: " + ", ".join(unexpected))
      return analyzed


  def validate_issue_output(raw, analyzed):
      try:
          text = raw.decode("utf-8")
      except UnicodeError as error:
          raise ValueError(f"errcheck issue output is not UTF-8: {error}")
      if not text or not text.endswith("\n"):
          raise ValueError("errcheck issue output is empty or incomplete")
      canonical_lines = []
      previous = None
      for line_text in text.splitlines():
          match = DIAGNOSTIC.fullmatch(line_text)
          if match is None:
              raise ValueError(f"errcheck emitted an invalid diagnostic line: {line_text!r}")
          path_text = match.group("path")
          if not os.path.isabs(path_text):
              raise ValueError(f"errcheck diagnostic path is not absolute: {path_text!r}")
          path = os.path.realpath(path_text)
          if path != path_text:
              raise ValueError(f"errcheck diagnostic path is not canonical: {path_text!r}")
          try:
              relative = os.path.relpath(path, workspace).replace(os.sep, "/")
          except ValueError:
              relative = "../"
          if relative not in analyzed:
              raise ValueError(f"errcheck diagnostic is outside analyzed package scope: {path_text!r}")
          current_snapshot = file_snapshot(path)
          initial_snapshot = source_snapshots[relative]
          for field in ("device", "inode", "mode", "size", "mtime", "sha256"):
              if current_snapshot[field] != initial_snapshot[field]:
                  raise ValueError(f"errcheck diagnostic source is not stable: {relative}")
          line_number = int(match.group("line"))
          column = int(match.group("column"))
          try:
              source_text = source_snapshots[relative]["content"].decode("utf-8")
          except UnicodeError as error:
              raise ValueError(f"Go source is not UTF-8: {relative}: {error}")
          source_lines = source_text.splitlines()
          if line_number > len(source_lines):
              raise ValueError(f"errcheck diagnostic line escapes its source: {line_text!r}")
          source = match.group("source")
          if source != source_lines[line_number - 1].strip():
              raise ValueError(f"errcheck diagnostic source text does not match {relative}")
          key = (relative, line_number, column, source)
          if previous is not None and key <= previous:
              raise ValueError("errcheck diagnostics are repeated or not sorted")
          previous = key
          canonical_lines.append(
              f"{relative}:{line_number}:{column}:\t{source}\n"
          )
      if not canonical_lines:
          raise ValueError("errcheck issue status contained no diagnostics")
      return "".join(canonical_lines).encode("utf-8")


  previous_handlers = {}
  result_status = 2
  result_stdout = b""
  result_stderr = b""
  adapter_error = None
  try:
      private_root = tempfile.mkdtemp(prefix="velvet-glove-errcheck-", dir=temporary_parent)
      private_paths = {
          "HOME": os.path.join(private_root, "home"),
          "TMPDIR": os.path.join(private_root, "tmp"),
          "XDG_CACHE_HOME": os.path.join(private_root, "xdg-cache"),
          "GOCACHE": os.path.join(private_root, "go-build"),
          "GOPATH": os.path.join(private_root, "gopath"),
          "GOTMPDIR": os.path.join(private_root, "go-tmp"),
      }
      for path in private_paths.values():
          os.mkdir(path, mode=0o700)
      if inherited_modcache is None:
          inherited_modcache = os.path.join(private_paths["GOPATH"], "pkg", "mod")
          os.makedirs(inherited_modcache, mode=0o700)
      environment = os.environ.copy()
      for name in tuple(environment):
          if (
              name.startswith("GO")
              or name.startswith("DYLD_")
              or name.startswith("LD_")
              or name
              in {
                  "CC",
                  "CXX",
                  "CGO_CFLAGS",
                  "CGO_CPPFLAGS",
                  "CGO_CXXFLAGS",
                  "CGO_LDFLAGS",
                  "CI",
                  "DEBUG",
                  "HOME",
                  "PKG_CONFIG",
                  "TMPDIR",
                  "XDG_CACHE_HOME",
              }
          ):
              environment.pop(name, None)
      environment.update(private_paths)
      environment.update(
          {
              "PATH": "/usr/bin:/bin",
              "LANG": "C",
              "LC_ALL": "C",
              "TZ": "UTC",
              "TERM": "dumb",
              "NO_COLOR": "1",
              "CLICOLOR": "0",
              "FORCE_COLOR": "0",
              "CGO_ENABLED": "0",
              "GO111MODULE": "on",
              "GODEBUG": "",
              "GOENV": "off",
              "GOFLAGS": "-mod=readonly",
              "GOMAXPROCS": "1",
              "GOMODCACHE": inherited_modcache,
              "GONOPROXY": "",
              "GONOSUMDB": "",
              "GOPRIVATE": "",
              "GOPROXY": "off",
              "GOSUMDB": "off",
              "GOTELEMETRY": "off",
              "GOTOOLCHAIN": "local",
              "GOVCS": "*:off",
              "GOWORK": "off",
          }
      )
      for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
          previous_handlers[signum] = signal.signal(signum, forward_signal)

      env_args = [
          go_launcher,
          "env",
          "-json",
          "GOARCH",
          "GOMODCACHE",
          "GOOS",
          "GOROOT",
          "GOVERSION",
      ]
      env_status, env_stdout, env_stderr = run_child(env_args, environment)
      if env_status != 0 or env_stderr:
          if env_stdout:
              sys.stdout.buffer.write(env_stdout)
          if env_stderr:
              sys.stderr.buffer.write(env_stderr)
          raise ValueError(
              f"Go environment preflight exited {env_status} without valid completion evidence"
          )
      go_environment = parse_json_object(env_stdout, "Go environment preflight")
      expected_go_keys = {"GOARCH", "GOMODCACHE", "GOOS", "GOROOT", "GOVERSION"}
      if set(go_environment) != expected_go_keys:
          raise ValueError("Go environment preflight returned an unexpected field set")
      if go_environment["GOMODCACHE"] != inherited_modcache:
          raise ValueError("Go environment preflight ignored the controlled module cache")
      for key in ("GOARCH", "GOOS", "GOVERSION"):
          if not isinstance(go_environment[key], str) or not go_environment[key]:
              raise ValueError(f"Go environment preflight returned an invalid {key}")
      if re.fullmatch(r"go[0-9]+\.[0-9]+(?:\.[0-9]+)?", go_environment["GOVERSION"]) is None:
          raise ValueError("Go environment preflight returned an invalid GOVERSION")
      go_root = go_environment["GOROOT"]
      if not isinstance(go_root, str) or not os.path.isabs(go_root):
          raise ValueError("Go environment preflight returned a non-absolute GOROOT")
      go_root = os.path.realpath(go_root)
      real_go = os.path.realpath(os.path.join(go_root, "bin", "go"))
      real_go_info = os.stat(real_go)
      if not stat.S_ISREG(real_go_info.st_mode) or not os.access(real_go, os.X_OK):
          raise ValueError("Go environment preflight did not identify an executable toolchain")
      environment["PATH"] = os.pathsep.join((os.path.dirname(real_go), "/usr/bin", "/bin"))
      assert_workspace_unchanged()

      verify_status, verify_stdout, verify_stderr = run_child(
          [go_launcher, "mod", "verify"], environment
      )
      if verify_status != 0 or verify_stdout != b"all modules verified\n" or verify_stderr:
          if verify_stdout:
              sys.stdout.buffer.write(verify_stdout)
          if verify_stderr:
              sys.stderr.buffer.write(verify_stderr)
          raise ValueError(
              f"go mod verify exited {verify_status} without exact completion evidence"
          )
      assert_workspace_unchanged()

      list_status, list_stdout, list_stderr = run_child(
          [go_launcher, "list", "-mod=readonly", "-json", "./..."],
          environment,
      )
      if list_status != 0 or list_stderr:
          if list_stdout:
              sys.stdout.buffer.write(list_stdout)
          if list_stderr:
              sys.stderr.buffer.write(list_stderr)
          raise ValueError(
              f"go list scope preflight exited {list_status} without valid completion evidence"
          )
      analyzed_sources = validate_package_scope(list_stdout)
      assert_workspace_unchanged()

      result_status, native_stdout, result_stderr = run_child(
          [tool, "-abspath", "-mod=readonly", "./..."], environment
      )
      assert_workspace_unchanged()
      if result_status == 0:
          if native_stdout or result_stderr:
              raise ValueError("errcheck clean status emitted output")
          result_stdout = b""
      elif result_status == 1:
          if result_stderr:
              sys.stderr.buffer.write(result_stderr)
              raise ValueError("errcheck issue status emitted stderr")
          result_stdout = validate_issue_output(native_stdout, analyzed_sources)
      elif result_status == 2:
          if native_stdout:
              sys.stdout.buffer.write(native_stdout)
              raise ValueError("errcheck operational failure emitted issue output")
          if not result_stderr or not result_stderr.endswith(b"\n"):
              raise ValueError("errcheck operational failure omitted complete stderr diagnostics")
          try:
              result_stderr.decode("utf-8")
          except UnicodeError as error:
              raise ValueError(f"errcheck operational diagnostics are not UTF-8: {error}")
      else:
          if native_stdout:
              sys.stdout.buffer.write(native_stdout)
          if result_stderr:
              sys.stderr.buffer.write(result_stderr)
          raise ValueError(f"errcheck returned unsupported status {result_status}")
  except AdapterSignal as error:
      stop_child(error.signum)
      adapter_error = f"received signal {error.signum}"
      result_status = 2
      result_stdout = b""
      result_stderr = b""
  except BaseException as error:
      stop_child()
      adapter_error = str(error)
      result_status = 2
      result_stdout = b""
      result_stderr = b""
  finally:
      cleaning = True
      try:
          for signum, handler in previous_handlers.items():
              try:
                  signal.signal(signum, handler)
              except (OSError, ValueError):
                  pass
      finally:
          cleaning = False
      stop_child()
      if private_root is not None:
          try:
              shutil.rmtree(private_root)
          except OSError as cleanup_error:
              if adapter_error is None:
                  adapter_error = f"cannot remove controlled temporary directory: {cleanup_error}"
                  result_status = 2
                  result_stdout = b""
                  result_stderr = b""

  if adapter_error is not None:
      fail(adapter_error)
  if result_stdout:
      sys.stdout.buffer.write(result_stdout)
  if result_stderr:
      sys.stderr.buffer.write(result_stderr)
  raise SystemExit(result_status)
  """#

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "errcheck"
