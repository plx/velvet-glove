/// mixed-line-ending — normalize files that mix CRLF and LF.
///
/// Backed by hk's (jdx/hk) `hk util mixed-line-ending`, which only flags a
/// file that contains *both* line-ending styles; a file that is uniformly
/// CRLF throughout is left alone (this is not a general dos2unix
/// replacement). With no flag it checks without mutating and exits 1 when
/// mixed endings are found; `--fix` normalizes to LF. A missing path exits 1
/// too, the same code as a real issue, so an I/O error cannot be told apart
/// from mixed endings; a malformed invocation (bad flag) exits 2.

module velvet_glove.builtins.tools.MixedLineEnding

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "mixed-line-ending"
  displayName = "mixed-line-ending"
  executable = "hk"
  installHint = "install hk, e.g. `brew install hk` or `mise use -g hk`"

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "util"
        "mixed-line-ending"
        "--fix"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "util"
        "mixed-line-ending"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    note = "opt-in only: normalizes only files that mix CRLF and LF"
  }
}
