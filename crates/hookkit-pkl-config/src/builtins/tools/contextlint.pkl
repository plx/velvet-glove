/// Contextlint — rule-based linter for structured Markdown documents.
///
/// Contextlint 1.1.1 reports an empty JSON array both when every document is
/// clean and when its patterns match no files. The isolated adapter therefore
/// ignores config `include` for execution scope: it inventories every physical
/// Markdown file in the resolved workspace, proves that the runner's candidates
/// belong to that inventory, and supplies the complete inventory explicitly.
/// A private SEC-001 probe proves the pinned CLI completed real lint work before
/// the project result can be accepted. Node's permission model limits reads to
/// the pinned package graph plus the private probe or workspace and grants no
/// writes, child processes, workers, or native addons.

module velvet_glove.builtins.tools.Contextlint

import "../Config.pkl" as Config

contextlintAdapter: String = #"""
  import hashlib
  import json
  import os
  import re
  import selectors
  import shutil
  import signal
  import stat
  import subprocess
  import sys
  import tempfile
  import time

  MARKER = "__VELVET_GLOVE_CONTEXTLINT_FILES__"
  VERSION = "1.1.1"
  MAX_CONFIG_BYTES = 1024 * 1024
  MAX_FILE_BYTES = 16 * 1024 * 1024
  MAX_TOTAL_BYTES = 64 * 1024 * 1024
  MAX_FILES = 4096
  MAX_ENTRIES = 100000
  MAX_OUTPUT_BYTES = 16 * 1024 * 1024
  EXCLUDED_DIRECTORIES = frozenset((".git", "node_modules", ".velvet-glove"))
  # glob 13.0.6 expands braces before minimatch 10.2.6 parses a pattern.
  # This is minimatch.escape(..., magicalBraces=True)'s POSIX magic set.
  GLOB_MAGIC = frozenset("*?()[]{}\\")
  RULES = frozenset((
      "tbl001", "tbl002", "tbl003", "tbl004", "tbl005", "tbl006",
      "sec001", "sec002", "str001",
      "ref001", "ref002", "ref003", "ref004", "ref005", "ref006",
      "chk001", "ctx001", "ctx002", "grp001", "grp002", "grp003",
  ))
  PROBE_CONFIG = (
      b'{"rules":[{"rule":"sec001","options":{"sections":'
      b'["__VELVET_GLOVE_CONTEXTLINT_COMPLETION__"]}}]}\n'
  )
  PROBE_DOCUMENT = b"# Probe\n"
  PROBE_REPORT = [{
      "file": "probe.md",
      "line": 0,
      "severity": "error",
      "message": 'Missing required section "__VELVET_GLOVE_CONTEXTLINT_COMPLETION__"',
      "ruleId": "SEC-001",
  }]


  class AdapterFailure(Exception):
      pass


  class AdapterSignal(BaseException):
      def __init__(self, signum):
          super().__init__(f"received signal {signum}")
          self.signum = signum


  def reject(message):
      raise AdapterFailure(message)


  def reject_glob_magic_path(path, description):
      absolute = os.path.abspath(path)
      for component in absolute.split(os.sep):
          magic = "".join(sorted(set(component).intersection(GLOB_MAGIC)))
          if magic:
              reject(
                  f"{description} contains Contextlint glob magic {magic!r}: {path}"
              )


  def duplicate_safe_object(pairs):
      value = {}
      for key, item in pairs:
          if key in value:
              reject(f"configuration contains duplicate key {key!r}")
          value[key] = item
      return value


  def read_bounded(path, limit, description):
      flags = os.O_RDONLY
      if hasattr(os, "O_NOFOLLOW"):
          flags |= os.O_NOFOLLOW
      try:
          before = os.lstat(path)
          if not stat.S_ISREG(before.st_mode) or stat.S_ISLNK(before.st_mode):
              reject(f"{description} is not a regular file: {path}")
          if before.st_nlink != 1:
              reject(f"{description} must have exactly one hard link: {path}")
          descriptor = os.open(path, flags)
          try:
              opened = os.fstat(descriptor)
              if (opened.st_dev, opened.st_ino) != (before.st_dev, before.st_ino):
                  reject(f"{description} changed while opening: {path}")
              chunks = []
              total = 0
              while True:
                  chunk = os.read(descriptor, min(65536, limit + 1 - total))
                  if not chunk:
                      break
                  chunks.append(chunk)
                  total += len(chunk)
                  if total > limit:
                      reject(f"{description} exceeds {limit} bytes: {path}")
          finally:
              os.close(descriptor)
      except AdapterFailure:
          raise
      except OSError as error:
          reject(f"cannot read {description} {path}: {error}")
      data = b"".join(chunks)
      identity = (
          before.st_dev,
          before.st_ino,
          before.st_mode,
          before.st_nlink,
          before.st_size,
          before.st_mtime_ns,
          hashlib.sha256(data).hexdigest(),
      )
      return data, identity


  def parse_json_bytes(data, description):
      try:
          text = data.decode("utf-8")
          return json.loads(text, object_pairs_hook=duplicate_safe_object)
      except AdapterFailure:
          raise
      except (UnicodeError, json.JSONDecodeError) as error:
          reject(f"invalid UTF-8 JSON in {description}: {error}")


  def resolve_program(name, description):
      if not name or "\x00" in name:
          reject(f"invalid {description} name")
      candidate = shutil.which(name)
      if candidate is None:
          reject(f"cannot resolve {description} {name!r}")
      absolute = os.path.abspath(candidate)
      try:
          metadata = os.stat(absolute)
      except OSError as error:
          reject(f"cannot inspect {description} {absolute}: {error}")
      if not stat.S_ISREG(metadata.st_mode) or not os.access(absolute, os.X_OK):
          reject(f"{description} is not an executable regular file: {absolute}")
      return absolute


  def validate_package_graph(tool_program):
      resolved = os.path.realpath(tool_program)
      cursor = os.path.dirname(resolved)
      graph = None
      while True:
          if os.path.basename(cursor) == "node_modules":
              graph = cursor
              break
          parent = os.path.dirname(cursor)
          if parent == cursor:
              break
          cursor = parent
      if graph is None:
          reject(f"contextlint executable is outside a node_modules graph: {tool_program}")
      graph = os.path.realpath(graph)
      cli_entry = os.path.realpath(
          os.path.join(graph, "@contextlint", "cli", "dist", "index.js")
      )
      if resolved != cli_entry:
          reject(
              "contextlint executable does not resolve to "
              f"@contextlint/cli/dist/index.js: {tool_program}"
          )
      cli_manifest_path = os.path.join(graph, "@contextlint", "cli", "package.json")
      core_manifest_path = os.path.join(graph, "@contextlint", "core", "package.json")
      cli_bytes, _ = read_bounded(cli_manifest_path, MAX_CONFIG_BYTES, "CLI manifest")
      core_bytes, _ = read_bounded(core_manifest_path, MAX_CONFIG_BYTES, "core manifest")
      cli = parse_json_bytes(cli_bytes, "CLI manifest")
      core = parse_json_bytes(core_bytes, "core manifest")
      cli_valid = (
          isinstance(cli, dict)
          and cli.get("name") == "@contextlint/cli"
          and cli.get("version") == VERSION
          and cli.get("type") == "module"
          and cli.get("bin") == {"contextlint": "dist/index.js"}
          and isinstance(cli.get("dependencies"), dict)
          and cli["dependencies"].get("@contextlint/core") == VERSION
      )
      core_valid = (
          isinstance(core, dict)
          and core.get("name") == "@contextlint/core"
          and core.get("version") == VERSION
          and core.get("type") == "module"
      )
      if not cli_valid or not core_valid:
          reject(f"contextlint package graph is not the exact supported {VERSION} pair")
      return graph, cli_entry


  def validate_config(config_bytes):
      config = parse_json_bytes(config_bytes, "contextlint.config.json")
      if not isinstance(config, dict):
          reject("contextlint.config.json must contain a JSON object")
      rules = config.get("rules")
      if not isinstance(rules, list) or not rules:
          reject("contextlint.config.json must declare at least one rule")
      for index, entry in enumerate(rules):
          if not isinstance(entry, dict) or entry.get("rule") not in RULES:
              reject(f"contextlint.config.json rules[{index}] is not a pinned built-in rule")
      return config


  def inventory_workspace(workspace):
      files = []
      seen_inodes = set()
      entries = 0
      total_bytes = 0

      def visit(directory):
          nonlocal entries, total_bytes
          try:
              directory_metadata = os.lstat(directory)
              if not stat.S_ISDIR(directory_metadata.st_mode) or stat.S_ISLNK(directory_metadata.st_mode):
                  reject(f"workspace traversal encountered a non-directory: {directory}")
              children = sorted(os.scandir(directory), key=lambda item: item.name)
          except AdapterFailure:
              raise
          except OSError as error:
              reject(f"cannot inventory workspace directory {directory}: {error}")
          for child in children:
              entries += 1
              if entries > MAX_ENTRIES:
                  reject(f"workspace inventory exceeds {MAX_ENTRIES} entries")
              path = child.path
              try:
                  metadata = child.stat(follow_symlinks=False)
              except OSError as error:
                  reject(f"cannot inspect workspace entry {path}: {error}")
              if stat.S_ISLNK(metadata.st_mode):
                  reject(f"workspace inventory rejects symbolic links: {path}")
              if stat.S_ISDIR(metadata.st_mode):
                  if child.name in EXCLUDED_DIRECTORIES:
                      continue
                  reject_glob_magic_path(path, "workspace inventory path")
                  visit(path)
                  continue
              lowered = child.name.lower()
              if not (lowered.endswith(".md") or lowered.endswith(".markdown")):
                  continue
              reject_glob_magic_path(path, "workspace inventory path")
              if not stat.S_ISREG(metadata.st_mode):
                  reject(f"Markdown inventory entry is not a regular file: {path}")
              if metadata.st_nlink != 1:
                  reject(f"Markdown inventory entry must have one hard link: {path}")
              inode = (metadata.st_dev, metadata.st_ino)
              if inode in seen_inodes:
                  reject(f"Markdown inventory contains a duplicate inode: {path}")
              seen_inodes.add(inode)
              if len(files) >= MAX_FILES:
                  reject(f"workspace inventory exceeds {MAX_FILES} Markdown files")
              data, identity = read_bounded(path, MAX_FILE_BYTES, "Markdown file")
              total_bytes += len(data)
              if total_bytes > MAX_TOTAL_BYTES:
                  reject(f"workspace Markdown inventory exceeds {MAX_TOTAL_BYTES} bytes")
              files.append((os.path.realpath(path), identity))

      visit(workspace)
      files.sort(key=lambda item: item[0])
      if not files:
          reject("workspace contains no physical Markdown files")
      return files


  PRIVATE_ROOT_PREFIX = "velvet-glove-contextlint-probe-"


  def normalize_private_error(error, root=None):
      message = str(error)
      if root is not None:
          return message.replace(root, "<private-probe>")
      if isinstance(error, OSError) and error.filename is not None:
          candidate = os.path.abspath(os.fsdecode(error.filename))
          parent = os.path.dirname(candidate)
          if os.path.basename(candidate).startswith(PRIVATE_ROOT_PREFIX):
              return message.replace(candidate, "<private-probe>")
          if os.path.basename(parent).startswith(PRIVATE_ROOT_PREFIX):
              return message.replace(parent, "<private-probe>")
      return message


  def create_private_run_root(workspace):
      base = os.environ.get("TMPDIR", "/tmp")
      if not os.path.isabs(base):
          reject("TMPDIR must be absolute")
      reject_glob_magic_path(base, "TMPDIR")
      base = os.path.realpath(base)
      reject_glob_magic_path(base, "resolved TMPDIR")
      if not os.path.isdir(base):
          reject(f"TMPDIR is not a directory: {base}")
      try:
          inside_workspace = os.path.commonpath((workspace, base)) == workspace
      except ValueError:
          inside_workspace = False
      if inside_workspace:
          reject("TMPDIR must resolve outside the Contextlint workspace")
      root = None
      created = []
      try:
          root = tempfile.mkdtemp(prefix=PRIVATE_ROOT_PREFIX, dir=base)
          created.append(root)
          os.chmod(root, 0o700)
          for name in ("home", "tmp", "xdg-cache"):
              path = os.path.join(root, name)
              os.mkdir(path, 0o700)
              os.chmod(path, 0o700)
              created.append(path)
      except OSError as error:
          for path in reversed(created):
              try:
                  os.rmdir(path)
              except OSError:
                  pass
          reject(
              "cannot create private completion-probe root: "
              + normalize_private_error(error, root)
          )
      return root


  def write_private_file(path, data):
      flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0)
      if hasattr(os, "O_NOFOLLOW"):
          flags |= os.O_NOFOLLOW
      descriptor = os.open(path, flags, 0o600)
      try:
          os.fchmod(descriptor, 0o600)
          offset = 0
          while offset < len(data):
              offset += os.write(descriptor, data[offset:])
          os.fsync(descriptor)
      finally:
          os.close(descriptor)


  process = None
  pending_signal = None
  reported_signal = None
  cleaning = False
  active_workspace = None
  private_run_root = None
  handled_signals = (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)


  def signal_group(signum):
      if process is None:
          return
      try:
          os.killpg(process.pid, signum)
      except (OSError, ValueError):
          pass


  def process_group_exists():
      if process is None:
          return False
      try:
          os.killpg(process.pid, 0)
          return True
      except ProcessLookupError:
          return False
      except PermissionError:
          return True


  def sweep_process_group():
      if not process_group_exists():
          return False
      signal_group(signal.SIGKILL)
      deadline = time.monotonic() + 1
      while process_group_exists() and time.monotonic() < deadline:
          time.sleep(0.01)
      if process_group_exists():
          raise AdapterFailure("cannot reap same-group descendants after child exit")
      return True


  def stop_child(initial_signal=None):
      global process, cleaning
      child = process
      if child is None:
          return None
      cleanup_error = None
      cleaning = True
      try:
          try:
              running = child.poll() is None
          except (OSError, ValueError):
              running = True
          if running:
              signal_group(initial_signal if initial_signal is not None else signal.SIGTERM)
              try:
                  child.wait(timeout=1)
              except (OSError, ValueError, subprocess.TimeoutExpired):
                  pass
          signal_group(signal.SIGKILL)
          try:
              child.wait(timeout=1)
          except (OSError, ValueError, subprocess.TimeoutExpired):
              pass
          deadline = time.monotonic() + 1
          while process_group_exists() and time.monotonic() < deadline:
              time.sleep(0.01)
          if process_group_exists():
              cleanup_error = AdapterFailure(
                  "cannot reap same-group descendants during child cleanup"
              )
      finally:
          process = None
          cleaning = False
      return cleanup_error


  def forward_signal(signum, _frame):
      global pending_signal
      pending_signal = signum
      if process is not None and not cleaning:
          signal_group(signum)
          raise AdapterSignal(signum)


  def append_adapter_error(primary, secondary):
      if secondary is None:
          return primary
      if primary is None:
          return secondary
      return AdapterFailure(f"{primary}; {secondary}")


  def apply_pending_signal(primary):
      global reported_signal
      if pending_signal is None or pending_signal == reported_signal:
          return primary
      reported_signal = pending_signal
      return append_adapter_error(primary, AdapterSignal(pending_signal))


  def drain_blocked_signals(primary):
      global pending_signal
      drained = False
      while True:
          queued = sorted(set(signal.sigpending()).intersection(handled_signals), key=int)
          if not queued:
              return primary, drained
          pending_signal = int(signal.sigwait({queued[0]}))
          primary = apply_pending_signal(primary)
          drained = True


  def child_environment(run_root):
      environment = {
          "PATH": "/usr/bin:/bin",
          "HOME": os.path.join(run_root, "home"),
          "TMPDIR": os.path.join(run_root, "tmp"),
          "XDG_CACHE_HOME": os.path.join(run_root, "xdg-cache"),
          "LANG": "C",
          "LC_ALL": "C",
          "TZ": "UTC",
          "TERM": "dumb",
          "CI": "1",
          "NO_COLOR": "1",
          "CLICOLOR": "0",
          "FORCE_COLOR": "0",
          "NODE_DISABLE_COLORS": "1",
          "UV_THREADPOOL_SIZE": "1",
      }
      for name in (
          "VELVET_GLOVE_TOOL_TRACE_DIR",
          "VELVET_GLOVE_TOOL_TRACE_SENTINEL",
      ):
          if name in os.environ:
              environment[name] = os.environ[name]
      return environment


  def run_child(arguments, cwd, environment):
      global process, pending_signal
      stdout_chunks = []
      stderr_chunks = []
      total = 0
      child = None
      selector = selectors.DefaultSelector()
      spawn_mask = None
      leader_exit_deadline = None
      try:
          spawn_mask = signal.pthread_sigmask(signal.SIG_BLOCK, handled_signals)
          try:
              queued = sorted(
                  set(signal.sigpending()).intersection(handled_signals), key=int
              )
              if queued:
                  pending_signal = int(signal.sigwait({queued[0]}))
              if pending_signal is not None:
                  raise AdapterSignal(pending_signal)
              child = subprocess.Popen(
                  arguments,
                  cwd=cwd,
                  stdin=subprocess.DEVNULL,
                  stdout=subprocess.PIPE,
                  stderr=subprocess.PIPE,
                  env=environment,
                  start_new_session=True,
              )
              process = child
          finally:
              signal.pthread_sigmask(signal.SIG_SETMASK, spawn_mask)
          if pending_signal is not None:
              raise AdapterSignal(pending_signal)
          for stream, target in ((process.stdout, stdout_chunks), (process.stderr, stderr_chunks)):
              if stream is None:
                  reject("failed to capture contextlint output")
              os.set_blocking(stream.fileno(), False)
              selector.register(stream, selectors.EVENT_READ, target)
          while selector.get_map():
              if pending_signal is not None:
                  raise AdapterSignal(pending_signal)
              events = selector.select(timeout=0.1)
              for key, _ in events:
                  chunk = os.read(key.fileobj.fileno(), 65536)
                  if chunk:
                      total += len(chunk)
                      if total > MAX_OUTPUT_BYTES:
                          raise BufferError(
                              f"combined contextlint output exceeded {MAX_OUTPUT_BYTES} bytes"
                          )
                      key.data.append(chunk)
                  else:
                      selector.unregister(key.fileobj)
                      key.fileobj.close()
              if process.poll() is not None and selector.get_map():
                  if sweep_process_group():
                      raise AdapterFailure(
                          "native Contextlint left same-group descendants after child exit"
                      )
                  if leader_exit_deadline is None:
                      leader_exit_deadline = time.monotonic() + 0.25
                  elif time.monotonic() >= leader_exit_deadline:
                      raise AdapterFailure(
                          "native Contextlint child exited without closing output pipes"
                      )
          returncode = process.wait()
          if sweep_process_group():
              raise AdapterFailure(
                  "native Contextlint left same-group descendants after child exit"
              )
          process = None
          return returncode, b"".join(stdout_chunks), b"".join(stderr_chunks)
      except AdapterSignal as error:
          cleanup_error = stop_child(pending_signal)
          if cleanup_error is not None:
              raise append_adapter_error(error, cleanup_error) from error
          raise
      except BaseException as error:
          cleanup_error = stop_child()
          if cleanup_error is not None:
              raise append_adapter_error(error, cleanup_error) from error
          raise
      finally:
          selector.close()
          if child is not None:
              for stream in (child.stdout, child.stderr):
                  if stream is not None:
                      try:
                          stream.close()
                      except OSError:
                          pass


  def node_arguments(node_program, cli_entry, readable_roots, config, cwd, files):
      arguments = [node_program, "--disable-proto=throw", "--permission"]
      for root in readable_roots:
          arguments.append(f"--allow-fs-read={root}")
      arguments.extend((
          cli_entry,
          "lint",
          "--config", config,
          "--cwd", cwd,
          "--format", "json",
          "--",
      ))
      arguments.extend(files)
      return arguments


  def parse_report(stdout_bytes, description):
      report = parse_json_bytes(stdout_bytes, description)
      if not isinstance(report, list):
          reject(f"{description} is not a JSON array")
      expected_keys = {"file", "line", "severity", "message", "ruleId"}
      for index, item in enumerate(report):
          valid = (
              isinstance(item, dict)
              and set(item) == expected_keys
              and isinstance(item.get("file"), str)
              and type(item.get("line")) is int
              and item["line"] >= 0
              and item.get("severity") in ("error", "warning")
              and isinstance(item.get("message"), str)
              and isinstance(item.get("ruleId"), str)
              and re.fullmatch(r"[A-Z]{3}-[0-9]{3}", item["ruleId"]) is not None
          )
          if not valid:
              reject(f"{description} entry {index} has an invalid shape")
      return report


  def verify_snapshots(paths):
      for path, expected, limit, description in paths:
          _, observed = read_bounded(path, limit, description)
          if observed != expected:
              reject(f"{description} changed during contextlint: {path}")


  def sanitize(text, workspace, run_root):
      stable = text.replace(run_root, "<private-probe>")
      stable = stable.replace(workspace, "<workspace>")
      return stable


  def cleanup_private_root(root):
      if root is None:
          return
      for name in ("contextlint.config.json", "project.config.json", "probe.md"):
          path = os.path.join(root, name)
          if os.path.lexists(path):
              os.unlink(path)
      for name in ("home", "tmp", "xdg-cache"):
          path = os.path.join(root, name)
          if os.path.lexists(path):
              os.rmdir(path)
      os.rmdir(root)


  def main():
      global active_workspace, private_run_root, cleaning, reported_signal
      if len(sys.argv) < 6:
          reject("invalid adapter arguments")
      node_name = sys.argv[1]
      tool_name = sys.argv[2]
      indicator_argument = sys.argv[3]
      payload = sys.argv[4:]
      if payload.count(MARKER) != 1 or payload[0] != MARKER:
          reject("forwarded arguments are unsupported and file marker is invalid")
      candidates = payload[1:]
      if not candidates:
          reject("runner selected zero candidate files")

      node_program = resolve_program(node_name, "Node executable")
      tool_program = resolve_program(tool_name, "contextlint executable")
      graph, cli_entry = validate_package_graph(tool_program)

      lexical_indicator = os.path.abspath(indicator_argument)
      if os.path.basename(lexical_indicator) != "contextlint.config.json":
          reject(f"invalid workspace indicator: {indicator_argument}")
      indicator = os.path.realpath(lexical_indicator)
      if lexical_indicator != indicator:
          reject("workspace indicator traverses a symbolic link")
      workspace = os.path.dirname(indicator)
      active_workspace = workspace
      reject_glob_magic_path(indicator, "workspace indicator")
      config_bytes, config_identity = read_bounded(
          indicator, MAX_CONFIG_BYTES, "contextlint.config.json"
      )
      validate_config(config_bytes)

      inventory = inventory_workspace(workspace)
      inventory_paths = [path for path, _ in inventory]
      inventory_set = set(inventory_paths)
      candidate_paths = []
      for candidate in candidates:
          absolute = os.path.abspath(candidate)
          reject_glob_magic_path(absolute, "runner candidate")
          canonical = os.path.realpath(absolute)
          if absolute != canonical or canonical not in inventory_set:
              reject(f"runner candidate is outside the physical Markdown inventory: {candidate}")
          candidate_paths.append(canonical)
      if len(set(candidate_paths)) != len(candidate_paths):
          reject("runner candidate list contains duplicates")

      snapshots = [(indicator, config_identity, MAX_CONFIG_BYTES, "contextlint.config.json")]
      snapshots.extend(
          (path, identity, MAX_FILE_BYTES, "Markdown file")
          for path, identity in inventory
      )

      run_root = None
      result = None
      try:
          run_root = create_private_run_root(workspace)
          private_run_root = run_root
          probe_config = os.path.join(run_root, "contextlint.config.json")
          project_config = os.path.join(run_root, "project.config.json")
          probe_document = os.path.join(run_root, "probe.md")
          write_private_file(probe_config, PROBE_CONFIG)
          write_private_file(project_config, config_bytes)
          write_private_file(probe_document, PROBE_DOCUMENT)
          private_config_bytes, _ = read_bounded(
              project_config, MAX_CONFIG_BYTES, "private contextlint.config.json copy"
          )
          if private_config_bytes != config_bytes:
              reject("private contextlint.config.json copy changed while being created")
          environment = child_environment(run_root)

          probe_args = node_arguments(
              node_program,
              cli_entry,
              (graph, run_root),
              probe_config,
              run_root,
              (probe_document,),
          )
          probe_status, probe_stdout, probe_stderr = run_child(
              probe_args, run_root, environment
          )
          probe_report = parse_report(probe_stdout, "private completion report")
          if probe_status != 1 or probe_stderr or probe_report != PROBE_REPORT:
              reject(
                  "private SEC-001 completion probe did not return its exact pinned result"
              )

          command_args = node_arguments(
              node_program,
              cli_entry,
              (graph, workspace, run_root),
              project_config,
              workspace,
              inventory_paths,
          )
          status, stdout_bytes, stderr_bytes = run_child(
              command_args, workspace, environment
          )
          verify_snapshots(snapshots)

          if status in (0, 1):
              if stderr_bytes:
                  reject("contextlint emitted stderr with a lint status")
              report = parse_report(stdout_bytes, "project completion report")
              has_errors = any(item["severity"] == "error" for item in report)
              if (status == 1) != has_errors:
                  reject("contextlint exit status contradicts its JSON severities")
              relative_inventory = {
                  os.path.relpath(path, workspace).replace(os.sep, "/")
                  for path in inventory_paths
              }
              for item in report:
                  if item["file"] != "(project)" and item["file"] not in relative_inventory:
                      reject(
                          f"contextlint attributed a diagnostic outside the inventory: {item['file']}"
                      )
                  item["message"] = sanitize(item["message"], workspace, run_root)
              report.sort(
                  key=lambda item: (
                      item["file"], item["line"], item["ruleId"],
                      item["severity"], item["message"],
                  )
              )
              stable = json.dumps(
                  report, ensure_ascii=False, sort_keys=True, separators=(",", ":")
              ) + "\n"
              result = (1 if report else 0, stable.encode("utf-8"), b"")
          else:
              stdout = sanitize(stdout_bytes.decode("utf-8", "replace"), workspace, run_root)
              stderr = sanitize(stderr_bytes.decode("utf-8", "replace"), workspace, run_root)
              diagnostic = stdout.encode("utf-8") + stderr.encode("utf-8")
              diagnostic += (
                  f"velvet-glove-contextlint: contextlint exited with operational status {status}\n"
              ).encode("utf-8")
              result = (2, b"", diagnostic)
      finally:
          primary_error = sys.exc_info()[1]
          cleanup_error = stop_child()
          cleaning = True
          try:
              if run_root is not None:
                  cleanup_private_root(run_root)
          except OSError as error:
              cleanup_failure = AdapterFailure(
                  "cannot remove private completion-probe root: "
                  + normalize_private_error(error, run_root)
              )
              cleanup_error = append_adapter_error(cleanup_error, cleanup_failure)
          finally:
              cleaning = False
          if cleanup_error is not None:
              if isinstance(primary_error, AdapterSignal):
                  reported_signal = primary_error.signum
              if primary_error is not None:
                  raise append_adapter_error(primary_error, cleanup_error)
              raise cleanup_error
      if pending_signal is not None:
          raise AdapterSignal(pending_signal)
      if result is None:
          reject("contextlint adapter produced no result")
      return result


  previous_handlers = {}
  adapter_error = None
  result = None
  try:
      for signum in handled_signals:
          previous_handlers[signum] = signal.signal(signum, forward_signal)
      result = main()
  except AdapterSignal as error:
      adapter_error = append_adapter_error(error, stop_child(error.signum))
      reported_signal = error.signum
  except AdapterFailure as error:
      adapter_error = append_adapter_error(error, stop_child())
  except BaseException as error:
      adapter_error = append_adapter_error(
          RuntimeError(f"adapter failure: {error}"), stop_child()
      )
  finally:
      cleaning = True
      blocked_mask = None
      try:
          try:
              blocked_mask = signal.pthread_sigmask(signal.SIG_BLOCK, handled_signals)
          except (OSError, ValueError) as error:
              adapter_error = append_adapter_error(
                  adapter_error, AdapterFailure(f"cannot block cleanup signals: {error}")
              )
          adapter_error = apply_pending_signal(adapter_error)
          if blocked_mask is not None:
              while True:
                  adapter_error, drained = drain_blocked_signals(adapter_error)
                  if not drained:
                      break
      finally:
          # Keep these signals blocked through diagnostics and process exit.
          # Unblocking after restoring default handlers would reopen the
          # post-cleanup termination window closed by this cutoff.
          try:
              for signum, handler in previous_handlers.items():
                  try:
                      signal.signal(signum, handler)
                  except (OSError, ValueError):
                      pass
          finally:
              cleaning = False

  if adapter_error is not None:
      message = normalize_private_error(adapter_error, private_run_root)
      if active_workspace is not None:
          message = message.replace(active_workspace, "<workspace>")
      print(f"velvet-glove-contextlint: {message}", file=sys.stderr)
      raise SystemExit(2)
  if result is None:
      print("velvet-glove-contextlint: adapter produced no result", file=sys.stderr)
      raise SystemExit(2)
  status, stdout_bytes, stderr_bytes = result
  if stdout_bytes:
      sys.stdout.buffer.write(stdout_bytes)
  if stderr_bytes:
      sys.stderr.buffer.write(stderr_bytes)
  raise SystemExit(status)
  """#

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "contextlint"
  displayName = "Contextlint"
  executable = "contextlint"
  installHint = "install exact `@contextlint/cli@1.1.1`, `@contextlint/core@1.1.1`, Node.js 24.19.0, and a Python 3 interpreter with isolated-mode support"
  workspaceIndicator = "contextlint.config.json"
  phaseInvocation = "workspace"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.[mM][dD]"; "**/*.[mM][dD]"
      "*.[mM][aA][rR][kK][dD][oO][wW][nN]"
      "**/*.[mM][aA][rR][kK][dD][oO][wW][nN]"
    }
    exclude = new Listing<String> {
      ".git/**"; "**/.git/**"
      "node_modules/**"; "**/node_modules/**"
      ".velvet-glove/**"; "**/.velvet-glove/**"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      program = "python"
      argv = new Listing<String | Config.ArgToken> {
        "-I"
        "-c"
        contextlintAdapter
        "node"
        new Config.ToolExecutable {}
        new Config.WorkspaceIndicator {}
        new Config.ExtraArgs {}
        "__VELVET_GLOVE_CONTEXTLINT_FILES__"
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
