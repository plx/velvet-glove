/// contextlint — rule-based linter for structured Markdown documents.
///
/// Verified empirically against real contextlint 1.1.1 (`@contextlint/cli`):
/// `lint` is the default command, so bare file args work; exits 0 clean / 1
/// on rule violations / 2 on a missing or malformed `contextlint.config.json`
/// (a distinguishable operational failure). `workspaceIndicator` means the
/// tool is skipped entirely when no config is discoverable, so the missing-
/// config path is not normally reachable. The npm package named plain
/// `contextlint` does not exist; the real package is `@contextlint/cli`.

module velvet_glove.builtins.tools.Contextlint

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "contextlint"
  displayName = "contextlint"
  executable = "contextlint"
  installHint = "install contextlint with `npm install -g @contextlint/cli` (not the nonexistent `contextlint` package)"
  workspaceIndicator = "contextlint.config.json"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.md"; "**/*.md"
      "*.markdown"; "**/*.markdown"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "contextlint.config.json" }
  }
}
