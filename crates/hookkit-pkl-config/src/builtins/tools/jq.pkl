/// jq — JSON processor.
///
/// hk's recipes are multi-line bash pipelines (per-file stdout-to-tempfile and
/// `diff -u`) that the single-argv runtime can't express directly. We expose a
/// verify-only phase that asks `jq` to parse each file independently. Plain
/// `empty` returns zero for a valid JSON stream and five for malformed input;
/// `-e empty` returns four even for valid JSON because `empty` emits no value.
/// Use the `taplo`/`prettier`-style formatters for actual rewriting.

module velvet_glove.builtins.tools.Jq

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "jq"
  displayName = "jq"
  executable = "jq"
  installHint = "install jq with `brew install jq`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.json"; "**/*.json" }
  }
  // jq parses multiple paths as one stream, so adjacent malformed fragments
  // can mask each other. Isolate every file for precise issue attribution.
  phaseInvocation = "per-file"

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "empty"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 5 }
        failure = new Listing<Int> { 1; 2; 3; 4 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
