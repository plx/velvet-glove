/// nixpkgs-fmt — the nixpkgs project's Nix formatter.
///
/// Verified with nixpkgs-fmt 1.3.0: `--check` exits 0 when nothing needs
/// reformatting and 1 when it does, and plain invocation only rewrites files
/// it actually reformats. Its parser is error-tolerant (rnix-based) and
/// gives *no* signal at all for a file it can't meaningfully parse: even
/// wholly unparseable input is reported as "0 would have been reformatted"
/// at exit 0 (indistinguishable from a genuinely clean file) and is left
/// untouched rather than mutated. This is a real limitation of the tool
/// itself — there is no flag or exit code to recover a parse-error signal —
/// so no operational-failure case can be demonstrated for it; nixfmt (RFC
/// 166) is the actively maintained formatter and does surface parse errors.

module velvet_glove.builtins.tools.NixpkgsFormat

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "nixpkgs-fmt"
  displayName = "nixpkgs-fmt"
  executable = "nixpkgs-fmt"
  installHint = "install nixpkgs-fmt with `nix-env -iA nixpkgs.nixpkgs-fmt`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.nix"; "**/*.nix" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }

  detect = new Config.Detect {
    role = "nix-format"
  }
}
