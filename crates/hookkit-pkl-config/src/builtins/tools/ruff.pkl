/// Ruff — Python linter and formatter.

module velvet_glove.builtins.tools.Ruff

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "ruff"
  displayName = "Ruff"
  executable = "ruff"
  installHint = "install ruff with `brew install ruff` or add it to the project"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.py"; "**/*.py"; "*.pyi"; "**/*.pyi" }
  }

  workflows = new Mapping<String, Config.Workflow> {
    ["lint"] = new Config.Workflow {
      check = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "check"
          "--force-exclude"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          issues = new Listing<Int> { 1 }
          failure = new Listing<Int> { 2 }
        }
      }
      remedy = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "check"
          "--force-exclude"
          "--fix"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          issues = new Listing<Int> { 1 }
          failure = new Listing<Int> { 2 }
        }
        writes = "target-files"
      }
      checkScope = "target-files"
      invocation = "batch"
    }
    ["format"] = new Config.Workflow {
      // Not `--quiet`: before Ruff 0.16 it also hides the parse error that
      // makes the check exit 2, and with it where the syntax error is.
      check = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "format"
          "--force-exclude"
          "--check"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          issues = new Listing<Int> { 1 }
          failure = new Listing<Int> { 2 }
        }
      }
      remedy = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "format"
          "--quiet"
          "--force-exclude"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          failure = new Listing<Int> { 2 }
        }
        writes = "target-files"
      }
      checkScope = "target-files"
      invocation = "batch"
    }
  }
  // Lint fixes can change layout, so the remedy pass runs lint before
  // formatting; a format check that a lint fix dirtied is rerun first.
  workflowOrder = new Listing<String> { "lint"; "format" }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "format"
        "--quiet"
        "--force-exclude"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        failure = new Listing<Int> { 2 }
      }
      writes = "target-files"
    }
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "check"
        "--force-exclude"
        "--fix"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "check"
        "--force-exclude"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  // Lint fixes can leave layout behind (e.g. removed imports), so fix first.
  phaseOrder = new Listing<String> { "fix"; "format"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "ruff.toml"; ".ruff.toml" }
    contains = new Mapping<String, String> { ["pyproject.toml"] = "[tool.ruff" }
    role = "python-lint"
    default = true
  }
}
