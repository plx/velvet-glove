/// taplo — TOML linter (the `taplo` step in hk; see `taplo_format.pkl` for the formatter).
///
/// taplo logs every file it collects at INFO level, so a batched run names
/// clean files in its output and the runner would blame them too (see the
/// `multi-file` fixture). `RUST_LOG=warn` keeps only the diagnostics.

module velvet_glove.builtins.tools.Taplo

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "taplo"
  displayName = "taplo"
  executable = "taplo"
  installHint = "install taplo with `brew install taplo` or `cargo install taplo-cli`"
  env = new Mapping<String, String> { ["RUST_LOG"] = "warn" }

  files = new Config.FileSelection {
    include = new Listing<String> { "*.toml"; "**/*.toml" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "lint"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".taplo.toml"; "taplo.toml" }
    role = "toml-lint"
  }
}
