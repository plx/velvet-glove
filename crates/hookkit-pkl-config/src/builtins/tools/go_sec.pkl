/// gosec — Go security scanner.
///
/// No `-quiet`: with it, a package that fails to type-check (for example a
/// syntax error introduced mid-edit) makes gosec exit 0 with no output at
/// all, silently reporting "clean" for a broken build. Without `-quiet`,
/// the same package exits 1 (gosec still can't tell a build failure from a
/// real finding — both are exit 1 — but at least it stops claiming success).

module velvet_glove.builtins.tools.GoSec

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "gosec"
  displayName = "gosec"
  executable = "gosec"
  installHint = "install gosec with `go install github.com/securego/gosec/v2/cmd/gosec@latest`"
  workspaceIndicator = "go.mod"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.go"; "**/*.go" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        "./..."
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    note = "opt-in only: noisy security findings"
  }
}
