/// Pkl — validate Pkl files via `pkl eval`.

module velvet_glove.builtins.tools.Pkl

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "pkl"
  displayName = "Pkl"
  executable = "pkl"
  installHint = "install Pkl with `brew install pkl`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.pkl"; "**/*.pkl" }
    // Velvet Glove's own project policy files (post-tool-use.pkl,
    // post-tool-use.local.pkl, and their legacy .agent-hook-kit peers)
    // `amends`/`import` the embedded `Config.pkl`/`Builtins.pkl` modules by
    // relative path. Those modules are staged into the runner, not present
    // on disk, so a plain `pkl eval` on these files always fails with
    // "Cannot find module", misreporting a perfectly valid policy edit as a
    // source issue. Exclude them; the runner validates policy itself.
    exclude = new Listing<String> {
      "**/.velvet-glove/*.pkl"
      "**/.agent-hook-kit/*.pkl"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "eval"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    note = "opt-in only: evaluates each module, which may read files or fetch packages"
  }
}
