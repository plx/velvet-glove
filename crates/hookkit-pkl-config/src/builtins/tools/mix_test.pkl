/// mix test — Elixir test runner.
///
/// Tests run for the whole Mix project, not per-file. The file list is only
/// used as a gate; tests are invoked at the project root. Running the full
/// suite is slow, so `detect` keeps this tool opt-in only.
///
/// Probed with Elixir/mix 1.20.4: failing tests exit 2 (issues); a project
/// that does not compile exits 1, which the default `unexpected` policy
/// reports as an operational failure unless the compiler names an edited
/// file at a location (then it is that file's issue; see the `syntax-error`
/// fixture). ExUnit reports a failing assertion at
/// its location in the test file, so the runners blame the test
/// file, not the library change that broke it.

module velvet_glove.builtins.tools.MixTest

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "mix-test"
  displayName = "mix test"
  executable = "mix"
  installHint = "install Elixir (e.g. `brew install elixir`) so `mix` is available"
  workspaceIndicator = "mix.exs"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.ex"; "**/*.ex"
      "*.exs"; "**/*.exs"
    }
    exclude = new Listing<String> { "deps/**/*"; "_build/**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "test"
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 2 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    note = "opt-in only: runs the test suite"
  }
}
