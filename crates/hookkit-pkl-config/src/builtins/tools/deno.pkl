/// deno fmt — Deno's built-in formatter for JS/TS sources.
///
/// `deno fmt` exits 1 both for a plain formatting issue and for a file it
/// cannot parse at all (or a broken `deno.json`), so an operational failure
/// is not distinguishable from a source issue via exit code; no
/// operational-failure fixture is provided (verified against deno 2.9.7).
/// A batch that mixes a fixable and an unparseable file still formats the
/// fixable one (see the `multi-file` fixture).

module velvet_glove.builtins.tools.Deno

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "deno"
  displayName = "deno fmt"
  executable = "deno"
  installHint = "install deno with `brew install deno` or `curl -fsSL https://deno.land/install.sh | sh`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.js"; "**/*.js"
      "*.jsx"; "**/*.jsx"
      "*.ts"; "**/*.ts"
      "*.tsx"; "**/*.tsx"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "fmt"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "fmt"
        "--check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "deno.json"; "deno.jsonc" }
    role = "js-format"
  }
}
