/// newlines — ensure every text file ends with exactly one trailing newline.
///
/// Backed by hk's (jdx/hk) `hk util end-of-file-fixer`. With no flag it
/// checks without mutating and exits 1 when a file has no trailing newline
/// or extra trailing blank lines; `--fix` rewrites it to end with exactly
/// one. An empty file is treated as clean either way. A missing path is
/// silently treated as clean (exit 0); a malformed invocation (bad flag)
/// exits 2.

module velvet_glove.builtins.tools.Newlines

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "newlines"
  displayName = "newlines"
  executable = "hk"
  installHint = "install hk, e.g. `brew install hk` or `mise use -g hk`"

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "util"
        "end-of-file-fixer"
        "--fix"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "util"
        "end-of-file-fixer"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    note = "opt-in only: rewrites end-of-file newlines in every edited file"
  }
}
