/// clang-format — C/C++/Objective-C formatter.
///
/// clang-format exits 1 for a genuine formatting issue AND for every
/// operational failure this spec can trigger without a wrapper (missing
/// file, unrecognized flag, an invalid `.clang-format` style config) — all
/// verified indistinguishable at 23.1.2. There is no separate operational
/// exit code to declare, so no `operational-failure` fixture case is
/// possible; see the fixture README note in this tool's directory.
module velvet_glove.builtins.tools.ClangFormat

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "clang-format"
  displayName = "clang-format"
  executable = "clang-format"
  installHint = "install clang-format with `brew install clang-format`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.c"; "**/*.c"
      "*.h"; "**/*.h"
      "*.cpp"; "**/*.cpp"
      "*.hpp"; "**/*.hpp"
      "*.cc"; "**/*.cc"
      "*.hh"; "**/*.hh"
      "*.cxx"; "**/*.cxx"
      "*.hxx"; "**/*.hxx"
      "*.m"; "**/*.m"
      "*.mm"; "**/*.mm"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "-i"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--dry-run"
        "-Werror"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".clang-format"; "_clang-format" }
    role = "c-format"
  }
}
