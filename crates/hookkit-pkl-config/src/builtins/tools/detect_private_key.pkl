/// detect-private-key — flag committed private-key material.
///
/// `hk` wraps this behind `hk util detect-private-key`, which scans for the
/// standard PEM and OpenSSH/PuTTY armor strings. The regex set is small and
/// well-known, so we can implement the same check portably with `grep -lE`.
/// grep's exit codes map cleanly onto our phase model: `0` means at least
/// one path matched (issues), `1` means no matches (clean), `2` is a read
/// or regex error (failure).
///
/// Verified the regex directly with `grep -lE`: it matches RSA/DSA/EC/
/// OPENSSH/unqualified/ENCRYPTED PEM headers and both PuTTY versions, and
/// correctly ignores certificates, CSRs, and public keys. The original
/// pattern missed `-----BEGIN PGP PRIVATE KEY BLOCK-----` (the armor GnuPG
/// emits for `gpg --export-secret-keys --armor`) because that header has a
/// trailing ` BLOCK` before the dashes; `( BLOCK)?` closes that gap without
/// matching `PGP PUBLIC KEY BLOCK`.

module velvet_glove.builtins.tools.DetectPrivateKey

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "detect-private-key"
  displayName = "detect-private-key"
  executable = "grep"
  installHint = "grep is part of any POSIX environment"

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      // Matches the canonical PEM armor used by OpenSSL, OpenSSH, and PuTTY.
      // The character class covers `RSA`, `DSA`, `EC`, `OPENSSH`, plus the
      // unqualified `PRIVATE KEY` form emitted by OpenSSL PKCS#8 output, and
      // the PuTTY-only `PuTTY-User-Key-File-` header.
      argv = new Listing<String | Config.ArgToken> {
        "-lE"
        "--"
        #"-----BEGIN ([A-Z]+ )?PRIVATE KEY( BLOCK)?-----|PuTTY-User-Key-File-"#
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 1 }
        issues = new Listing<Int> { 0 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    note = "opt-in only: pattern scan of every edited file"
  }
}
