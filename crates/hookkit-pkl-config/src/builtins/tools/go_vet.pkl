/// go vet — Go's built-in static analyzer.
///
/// `go vet` exits 1 both for reported vet issues and for a package that
/// fails to build (e.g. a syntax error). There is no flag that separates the
/// two, so a build failure is classified as a source issue rather than an
/// operational failure; no fixture demonstrates the latter because the real
/// tool cannot produce it.

module velvet_glove.builtins.tools.GoVet

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "go-vet"
  displayName = "go vet"
  executable = "go"
  installHint = "install the Go toolchain (go vet ships with it)"
  workspaceIndicator = "go.mod"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.go"; "**/*.go" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "vet"
        new Config.ExtraArgs {}
        "./..."
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    role = "go-lint"
    default = true
  }
}
