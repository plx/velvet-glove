/// betterleaks — alternative secrets scanner with a gitleaks-compatible CLI.
///
/// Verified with betterleaks 1.8.1: unlike upstream gitleaks, `dir` correctly
/// scans only the paths it's given (multiple explicit files are each scanned,
/// with no whole-cwd expansion). Its default exit code for "leaks found" (1)
/// collides with genuine operational failures (missing path, unreadable
/// config), which also exit 1, so `--exit-code 2` reassigns the leaks-found
/// exit code and leaves 1 exclusively for operational failure. Every log line
/// is prefixed with a wall-clock timestamp even under `--no-color`, so
/// `--log-level error` silences the non-deterministic info/warn chrome and
/// keeps only the (already deterministic) finding report and fatal errors.

module velvet_glove.builtins.tools.Betterleaks

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "betterleaks"
  displayName = "betterleaks"
  executable = "betterleaks"
  installHint = "install betterleaks with `brew install betterleaks`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*"; "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "dir"
        "--redact"
        "--verbose"
        "--no-color"
        "--no-banner"
        // Free up exit 1 for operational failures; see header comment.
        "--exit-code"
        "2"
        // Drop timestamped info/warn logging so diagnostics are reproducible.
        "--log-level"
        "error"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 2 }
        failure = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".betterleaks.toml" }
    role = "secrets"
  }
}
