/// no-commit-to-branch — block direct commits to protected branches.
///
// NOT APPLICABLE to agent file hooks: this is fundamentally a *pre-commit*
// guard (`hk util no-commit-to-branch`) — it checks the current branch
// against a configured protected list and refuses the commit. A
// post-tool-use hook fires after every edit, has no commit-stage context,
// and the check has nothing to do with the file the agent just modified.
// Listed here for catalog completeness; kept disabled.

module velvet_glove.builtins.tools.NoCommitToBranch

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "no-commit-to-branch"
  displayName = "no-commit-to-branch"
  executable = "git"
  installHint = "install git from your platform's package manager"
  enabled = false

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {}
  phaseOrder = new Listing<String> {}
}
