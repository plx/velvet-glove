/// nixfmt — the official Nix formatter (RFC 166).
///
/// Verified with nixfmt 1.4.0: `--check` exits 0 when a file is already
/// formatted and 1 otherwise, and plain invocation never mutates a file it
/// can't parse. A parse error or missing path also exits 1, so `--check`
/// alone cannot tell it from a formatting issue (a tool limitation). The
/// format phase runs first and never exits 1 on success, so the immediate
/// pipeline still reports a parse error as a failure; the Stop-time check
/// reads it as manual and then reports the failing remedy.

module velvet_glove.builtins.tools.NixFmt

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "nixfmt"
  displayName = "nixfmt"
  executable = "nixfmt"
  installHint = "install nixfmt with `brew install nixfmt` or `nix-env -iA nixpkgs.nixfmt-rfc-style`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.nix"; "**/*.nix" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }

  detect = new Config.Detect {
    role = "nix-format"
    default = true
  }
}
