/// Asciidoctor — AsciiDoc syntax validator and processor.
///
/// Verified empirically against real Asciidoctor 2.0.26: exits 0 clean / 1
/// promoted-to-error (`--failure-level=WARNING`), covering both document
/// problems (e.g. a missing `include::[]` target) and CLI/runtime failures
/// (bad flag, missing input file, unloadable `-r` library) — Asciidoctor
/// does not use a distinct exit code for the latter, so an operational
/// failure here is not distinguishable from a source issue by exit code.
/// `exitCodes.failure` is left empty accordingly; document this rather than
/// invent an unverifiable split.

module velvet_glove.builtins.tools.Asciidoctor

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "asciidoctor"
  displayName = "Asciidoctor"
  executable = "asciidoctor"
  installHint = "install Asciidoctor with `gem install asciidoctor`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.adoc"; "**/*.adoc"
      "*.asciidoc"; "**/*.asciidoc"
      "*.asc"; "**/*.asc"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      // `--failure-level=WARNING` promotes warnings to non-zero exits;
      // `--out-file=/dev/null` suppresses generated HTML.
      argv = new Listing<String | Config.ArgToken> {
        "--failure-level=WARNING"
        "--out-file=/dev/null"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    note = "opt-in only: AsciiDoc has no zero-config canonical checker and no project indicator to key off of"
  }
}
