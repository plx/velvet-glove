/// check-symlinks — flag broken symlinks.
///
/// Backed by hk's (jdx/hk) `hk util check-symlinks`, which stats each given
/// path and reports ones that are a symlink whose target does not exist. A
/// missing path (not a symlink at all) is silently treated as clean
/// (exit 0); a malformed invocation (bad flag) exits 2. Fixtures cannot
/// exercise the issue case directly: the fixture harness forbids symlinks
/// in fixture trees, so this tool's "found a broken symlink" path is
/// verified by manual probing (see the validation report) rather than a
/// committed fixture; clean and operational-failure are still covered.

module velvet_glove.builtins.tools.CheckSymlinks

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "check-symlinks"
  displayName = "check-symlinks"
  executable = "hk"
  installHint = "install hk, e.g. `brew install hk` or `mise use -g hk`"

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "util"
        "check-symlinks"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    note = "opt-in only: flags broken symlinks among edited paths"
  }
}
