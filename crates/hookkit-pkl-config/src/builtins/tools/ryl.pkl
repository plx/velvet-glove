/// ryl — Rust-based YAML linter (https://github.com/owenlamont/ryl).
///
/// ryl enables zero rules without a config (its own `.ryl.toml`/`ryl.toml`,
/// or a discovered legacy `.yamllint`/`.yamllint.yml`) and exits 2 refusing
/// to run rather than passing silently. That exit is left in `exitCodes`'
/// default failure bucket (not `issues`): it is a configuration error, and a
/// project with no lint config configured is not "clean". `--strict` would
/// reuse the same exit 2 for "only warnings", so this spec does not pass it.

module velvet_glove.builtins.tools.Ryl

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "ryl"
  displayName = "ryl"
  executable = "ryl"
  installHint = "install ryl with `cargo install ryl` or `pipx install ryl`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.yaml"; "**/*.yaml"
      "*.yml"; "**/*.yml"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "ryl.toml"; ".ryl.toml" }
    role = "yaml-lint"
  }
}
