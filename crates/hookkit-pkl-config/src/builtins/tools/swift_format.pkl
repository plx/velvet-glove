/// swift-format — Apple's Swift formatter and linter.
///
/// Invoked as `swift format …`, the `swift` driver's built-in subcommand
/// (Swift 5.9+ / Xcode 15+ toolchains), rather than the standalone
/// `swift-format` binary some people install separately via Homebrew.
/// Package.swift projects already require the `swift` toolchain to build, so
/// this invocation works without an extra install for that dominant case; a
/// user who only has the standalone Homebrew binary and no toolchain is
/// covered by the sibling `swiftformat` (nicklockwood) role default instead.
///
/// Verified at 603.0.0: `lint --strict` promotes warnings so a clean exit
/// distinguishes real issues (1) from clean (0); an unrecognized flag exits
/// 64 and a malformed `.swift-format` JSON config exits 1 — the same code as
/// a real issue, so `.swift-format` corruption is not a distinguishable
/// operational failure. A missing input path is silently exit 0 (no files to
/// check), which never arises here since this only runs on files the agent
/// actually edited. `format -i` always exits 0 once it runs.
module velvet_glove.builtins.tools.SwiftFormat

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "swift-format"
  displayName = "swift-format"
  executable = "swift"
  installHint = "ships with the Swift 6 toolchain as `swift format`; install Xcode or the Swift toolchain from swift.org"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.swift"; "**/*.swift" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "format"
        "format"
        "-i"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        failure = new Listing<Int> { 1; 64 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "format"
        "lint"
        "--strict"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 64 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".swift-format" }
    role = "swift-format"
    default = true
    note = "preferred over swiftformat when no `.swift-format`/`.swiftformat` config picks one"
  }
}
