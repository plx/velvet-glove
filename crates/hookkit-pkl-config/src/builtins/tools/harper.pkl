/// Harper — grammar checker for prose and documentation (harper-cli).
///
/// Verified empirically against real harper-cli 2.11.0: `lint --format
/// compact` exits 0 clean / 1 with findings on stdout, and batched files are
/// each attributed by name. It does print a "Note: ... user dictionary at
/// <HOME>/..." line on every invocation (stderr) that would make a byte-level
/// golden environment-fragile, but the v2 fixture format asserts semantics
/// (outcome, post-state), never stdout/stderr transcripts, so that no longer
/// blocks a fixture.
///
/// Known limitation: `INPUTS` accepts either a file path or literal text, and
/// a nonexistent path silently falls back to linting the argument string
/// itself as prose rather than failing — so a missing input file is not a
/// distinguishable operational failure with this tool.

module velvet_glove.builtins.tools.Harper

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "harper"
  displayName = "Harper"
  executable = "harper-cli"
  installHint = "install harper with `brew install harper`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.md"; "**/*.md"
      "*.markdown"; "**/*.markdown"
      "*.txt"; "**/*.txt"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--no-color"
        "lint"
        "--format"
        "compact"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    role = "prose-lint"
    note = "opt-in only: harper is zero-config and has no project indicator, so init never auto-suggests it"
  }
}
