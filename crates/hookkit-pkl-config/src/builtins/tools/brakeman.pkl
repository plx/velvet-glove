/// Brakeman — security scanner for Ruby on Rails applications.
///
/// Brakeman scans an entire Rails app rather than individual files, so the
/// runner invokes it against the app's workspace root (the nearest ancestor
/// directory containing a `Gemfile`) whenever any tracked Ruby or ERB file
/// changes. `-p` must receive that same nested directory, not the overall
/// project root: pointing brakeman at a monorepo root that isn't itself a
/// Rails app makes it refuse to scan (`Please supply the path to a Rails
/// application`, exit 4) instead of finding the real app one level down,
/// verified against brakeman 8.0.6.

module velvet_glove.builtins.tools.Brakeman

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "brakeman"
  displayName = "Brakeman"
  executable = "brakeman"
  installHint = "install brakeman with `gem install brakeman` or add it to the project Gemfile"
  workspaceIndicator = "Gemfile"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.rb"; "**/*.rb"; "*.erb"; "**/*.erb" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--quiet"
        "--no-progress"
        "--no-summary"
        "-p"
        new Config.Workspace {}
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 3 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "config/brakeman.yml"; "config/brakeman.ignore" }
  }
}
