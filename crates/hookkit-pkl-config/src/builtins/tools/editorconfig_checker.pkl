/// editorconfig-checker — validate files against `.editorconfig` rules.
///
/// Verified with editorconfig-checker 4.0.1: exits 0 clean, 1 when
/// violations are found (never mutates), and a distinct 2 when `-config`
/// can't be read or parsed, so that's made an explicit failure code rather
/// than relying on the implicit "unexpected -> failure" default. With no
/// `.editorconfig` anywhere above a file, the tool has no rules to apply and
/// always exits 0 for that file — expected, not a bug.

module velvet_glove.builtins.tools.EditorconfigChecker

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "editorconfig-checker"
  displayName = "editorconfig-checker"
  executable = "editorconfig-checker"
  installHint = "install editorconfig-checker with `brew install editorconfig-checker`"

  // `.editorconfig` rules apply to any text file; let the tool decide what
  // to skip via its own ignore handling.
  files = new Config.FileSelection {
    include = new Listing<String> { "*"; "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      // `-no-color` keeps diagnostics ANSI-free for downstream consumers.
      argv = new Listing<String | Config.ArgToken> {
        "-no-color"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".editorconfig-checker.json"; ".ecrc" }
  }
}
