/// mix compile — Elixir compiler invocation.
///
/// Compilation always operates on the whole project; the file list is only
/// used to gate when the runner triggers a build. Verified against Elixir
/// 1.20.4 / mix 1.20.4: `--warnings-as-errors` makes both a compiler warning
/// and a genuine parse/compile error exit 1, so there is no exit code that
/// distinguishes a broken source file from a warnings-as-errors violation;
/// both are treated as source issues for the agent to fix.

module velvet_glove.builtins.tools.MixCompile

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "mix-compile"
  displayName = "mix compile"
  executable = "mix"
  installHint = "install Elixir (e.g. `brew install elixir`) so `mix` is available"
  workspaceIndicator = "mix.exs"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.ex"; "**/*.ex"
      "*.exs"; "**/*.exs"
    }
    exclude = new Listing<String> { "deps/**/*"; "_build/**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "compile"
        "--warnings-as-errors"
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    note = "opt-in only: compiles the whole project"
  }
}
