/// buf format — Protocol Buffers formatter.
///
/// Buf uses status 100 for formatting differences and other nonzero statuses
/// for operational failures. The isolated adapter locks workspace scope and
/// symlink behavior, validates native unified-diff completion, and removes
/// only the two generated mtime fields from each complete diff block.

module velvet_glove.builtins.tools.BufFormat

import "../Config.pkl" as Config

bufFormatAdapter: String = #"""
  import os
  import json
  import re
  import selectors
  import shutil
  import signal
  import stat
  import subprocess
  import sys

  MARKER = "__VELVET_GLOVE_BUF_WORKSPACE__"
  LIMIT = 16 * 1024 * 1024
  HUNK = re.compile(
      r"^@@ -([0-9]+)(?:,([0-9]+))? \+([0-9]+)(?:,([0-9]+))? @@(?:.*)$"
  )
  MTIME = re.compile(
      r"^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}"
      r"(?:\.[0-9]{1,9})?(?: [+-][0-9]{4})?$"
  )


  def fail(message):
      print(f"velvet-glove-buf-format: {message}", file=sys.stderr)
      raise SystemExit(2)


  if len(sys.argv) < 5 or sys.argv[3:].count(MARKER) != 1:
      fail("invalid adapter arguments")

  requested_tool = sys.argv[1]
  phase = sys.argv[2]
  payload = sys.argv[3:]
  marker_index = payload.index(MARKER)
  extra_args = payload[:marker_index]
  workspaces = payload[marker_index + 1 :]
  if phase not in ("write", "verify") or len(workspaces) != 1:
      fail("invalid phase or workspace selection")
  if extra_args:
      fail("extra arguments are unsupported because every buf format option changes the controlled contract")

  requested_workspace = os.path.abspath(workspaces[0])
  try:
      info = os.lstat(requested_workspace)
      if os.path.islink(requested_workspace) or not stat.S_ISDIR(info.st_mode):
          fail(f"workspace is not a real directory: {requested_workspace}")
      workspace = os.path.realpath(requested_workspace)
      if workspace != requested_workspace:
          fail(f"workspace path traverses a symlink: {requested_workspace}")
      with os.scandir(workspace):
          pass
  except OSError as error:
      fail(f"cannot read workspace {requested_workspace}: {error}")

  config_path = os.path.join(workspace, "buf.yaml")
  try:
      config_info = os.lstat(config_path)
      if (
          os.path.islink(config_path)
          or not stat.S_ISREG(config_info.st_mode)
          or config_info.st_nlink != 1
      ):
          fail(f"workspace config is not a unique regular file: {config_path}")
      with open(config_path, "rb") as config_file:
          config_bytes = config_file.read(1024 * 1024 + 1)
  except OSError as error:
      fail(f"cannot read workspace config {config_path}: {error}")
  if len(config_bytes) > 1024 * 1024:
      fail("workspace config exceeds the 1 MiB validation limit")
  try:
      config_text = config_bytes.decode("utf-8")
  except UnicodeError as error:
      fail(f"workspace config is not UTF-8: {error}")
  if re.match(
      r"\Aversion:[ \t]*(?:v1|v2)[ \t]*(?:#.*)?(?:\r?\n|\Z)", config_text
  ) is None:
      fail("workspace config must begin with a canonical v1 or v2 version header")
  if re.search(r"^(?:---|\.\.\.)(?=[ \t]|\r?$)", config_text, re.MULTILINE):
      fail("workspace config must contain exactly one YAML document")
  config_headers = re.findall(r"^version:[^\r\n]*\r?$", config_text, re.MULTILINE)
  config_versions = re.findall(
      r"^version:[ \t]*(v1|v2)[ \t]*(?:#[^\r\n]*)?\r?$",
      config_text,
      re.MULTILINE,
  )
  if len(config_headers) != 1 or len(config_versions) != 1:
      fail("workspace config must have one canonical v1 or v2 version header")

  proto_paths = []
  def walk_error(error):
      fail(f"cannot walk workspace: {error}")


  for directory, child_directories, names in os.walk(
      workspace, followlinks=False, onerror=walk_error
  ):
      child_directories[:] = [
          name
          for name in child_directories
          if not os.path.islink(os.path.join(directory, name))
      ]
      for name in names:
          if not name.endswith(".proto"):
              continue
          path = os.path.join(directory, name)
          try:
              path_info = os.lstat(path)
              if (
                  os.path.islink(path)
                  or not stat.S_ISREG(path_info.st_mode)
                  or path_info.st_nlink != 1
              ):
                  fail(f"workspace proto is not a unique regular file: {path}")
              with open(path, "rb"):
                  pass
          except OSError as error:
              fail(f"cannot read workspace proto {path}: {error}")
          relative_path = os.path.relpath(path, workspace).replace(os.sep, "/")
          if any(
              component in {".git", "node_modules", "target"}
              for component in relative_path.split("/")[:-1]
          ):
              fail(
                  "workspace proto lies under a runner-hard-skipped directory: "
                  + relative_path
              )
          proto_paths.append(relative_path)
  proto_paths.sort()
  if not proto_paths:
      fail("workspace contains no regular .proto files")

  tool = shutil.which(requested_tool)
  if tool is None:
      fail(f"cannot resolve tool executable {requested_tool!r}")
  tool = os.path.abspath(tool)
  if not os.path.isfile(tool):
      fail(f"resolved tool is not a file: {tool}")

  preflight_args = [
      tool,
      "config",
      "ls-modules",
      "--log-format=text",
      "--format=json",
  ]
  child_args = [
      tool,
      "format",
      "--disable-symlinks",
      "--error-format=text",
      "--log-format=text",
  ]
  if phase == "write":
      child_args.append("--write")
  else:
      child_args.extend(("--diff", "--exit-code"))
  child_args.append(workspace)

  environment = os.environ.copy()
  temporary = environment.get("TMPDIR", "")
  if not os.path.isabs(temporary):
      fail("TMPDIR must be an absolute path")
  environment.update(
      {
          "PATH": "/usr/bin:/bin",
          "NO_COLOR": "1",
          "FORCE_COLOR": "0",
          "CLICOLOR": "0",
      }
  )
  scrubbed = (
      "BUF_TOKEN",
      "BUF_INPUT_HTTPS_USERNAME",
      "BUF_INPUT_HTTPS_PASSWORD",
      "BUF_INPUT_SSH_KEY_FILE",
      "BUF_INPUT_SSH_KNOWN_HOSTS_FILES",
      "BUF_ALPHA_SUPPRESS_WARNINGS",
      "BUF_BETA_COPY_FILES_TO_MEMORY",
      "BUF_BETA_SUPPRESS_WARNINGS",
      "DIFF_OPTIONS",
      "DEBUG",
  )
  for name in tuple(environment):
      if name in scrubbed or name.startswith("BUF_"):
          environment.pop(name, None)
  environment["BUF_CACHE_DIR"] = os.path.join(temporary, "velvet-glove-buf-cache")


  def normalize_scope_path(value, label):
      if not isinstance(value, str) or not value:
          raise ValueError(f"{label} is not a nonempty string")
      if "\\" in value or value.startswith("/"):
          raise ValueError(f"{label} is not a normalized relative path: {value!r}")
      normalized = os.path.normpath(value)
      if normalized != value or normalized == ".." or normalized.startswith("../"):
          raise ValueError(f"{label} is not a normalized relative path: {value!r}")
      lexical = os.path.abspath(os.path.join(workspace, value))
      try:
          inside_workspace = os.path.commonpath((workspace, lexical)) == workspace
      except ValueError:
          inside_workspace = False
      if not inside_workspace or os.path.realpath(lexical) != lexical:
          raise ValueError(f"{label} escapes or traverses a symlink: {value!r}")
      return value


  def parse_module_scope(raw):
      text = raw.decode("utf-8")
      if not text or not text.endswith("\n"):
          raise ValueError("module preflight did not emit complete JSON lines")
      modules = []
      previous_path = None
      for line_number, line in enumerate(text.splitlines(), 1):
          try:
              record = json.loads(line)
          except json.JSONDecodeError as error:
              raise ValueError(f"module preflight JSON line {line_number} is invalid: {error}")
          if not isinstance(record, dict):
              raise ValueError(f"module preflight JSON line {line_number} is not an object")
          unknown = set(record) - {"path", "includes", "excludes", "name"}
          if unknown:
              raise ValueError(
                  f"module preflight JSON line {line_number} has unknown keys: {sorted(unknown)!r}"
              )
          module_path = normalize_scope_path(record.get("path"), "module path")
          if previous_path is not None and module_path < previous_path:
              raise ValueError("module preflight paths are not sorted")
          previous_path = module_path
          name = record.get("name")
          if name is not None and (not isinstance(name, str) or not name):
              raise ValueError("module name is not a nonempty string")
          normalized_lists = []
          for key in ("includes", "excludes"):
              values = record.get(key, [])
              if not isinstance(values, list):
                  raise ValueError(f"module {key} is not an array")
              normalized_values = [
                  normalize_scope_path(value, f"module {key} entry") for value in values
              ]
              if normalized_values != sorted(set(normalized_values)):
                  raise ValueError(f"module {key} entries are repeated or not sorted")
              if any(
                  not (
                      value == module_path
                      or module_path == "."
                      or value.startswith(module_path + "/")
                  )
                  for value in normalized_values
              ):
                  raise ValueError(f"module {key} entry escapes its module path")
              normalized_lists.append(normalized_values)
          modules.append((module_path, normalized_lists[0], normalized_lists[1]))
      if not modules:
          raise ValueError("module preflight returned no modules")
      return modules


  def path_is_within(prefix, path):
      return prefix == "." or path == prefix or path.startswith(prefix + "/")


  def validate_module_coverage(modules):
      uncovered = []
      for path in proto_paths:
          covered = any(
              path_is_within(module_path, path)
              and (not includes or any(path_is_within(include, path) for include in includes))
              and not any(path_is_within(exclude, path) for exclude in excludes)
              for module_path, includes, excludes in modules
          )
          if not covered:
              uncovered.append(path)
      if uncovered:
          raise ValueError(
              "buf.yaml module scope omits workspace proto files: " + ", ".join(uncovered)
          )

  process = None
  pending_signal = None
  cleaning = False


  class AdapterSignal(BaseException):
      def __init__(self, signum):
          super().__init__(f"received signal {signum}")
          self.signum = signum


  def signal_group(signum):
      if process is None:
          return
      try:
          os.killpg(process.pid, signum)
      except (OSError, ValueError):
          pass


  def stop_child(initial_signal=None):
      global process
      global cleaning
      child = process
      if child is None:
          return
      cleaning = True
      try:
          try:
              running = child.poll() is None
          except (OSError, ValueError):
              running = True
          if running:
              signal_group(initial_signal if initial_signal is not None else signal.SIGTERM)
              try:
                  child.wait(timeout=1)
              except (OSError, ValueError, subprocess.TimeoutExpired):
                  pass
          signal_group(signal.SIGKILL)
          try:
              child.wait(timeout=1)
          except (OSError, ValueError, subprocess.TimeoutExpired):
              pass
      finally:
          process = None
          cleaning = False


  def forward_signal(signum, _frame):
      global pending_signal
      pending_signal = signum
      if process is not None and not cleaning:
          signal_group(signum)
          raise AdapterSignal(signum)


  previous_handlers = {}
  adapter_error = None
  stdout_bytes = b""
  stderr_bytes = b""


  def run_child(arguments):
      global process
      stdout_chunks = []
      stderr_chunks = []
      total = 0
      process = subprocess.Popen(
          arguments,
          stdin=subprocess.DEVNULL,
          stdout=subprocess.PIPE,
          stderr=subprocess.PIPE,
          cwd=workspace,
          env=environment,
          start_new_session=True,
      )
      if pending_signal is not None:
          raise AdapterSignal(pending_signal)
      selector = selectors.DefaultSelector()
      for stream, target in ((process.stdout, stdout_chunks), (process.stderr, stderr_chunks)):
          if stream is None:
              raise OSError("failed to capture tool output")
          os.set_blocking(stream.fileno(), False)
          selector.register(stream, selectors.EVENT_READ, target)
      while selector.get_map():
          if pending_signal is not None:
              raise AdapterSignal(pending_signal)
          for key, _ in selector.select(timeout=0.1):
              chunk = os.read(key.fileobj.fileno(), 65536)
              if chunk:
                  total += len(chunk)
                  if total > LIMIT:
                      raise BufferError(f"combined output exceeded {LIMIT} bytes")
                  key.data.append(chunk)
              else:
                  selector.unregister(key.fileobj)
                  key.fileobj.close()
      returncode = process.wait()
      process = None
      return returncode, b"".join(stdout_chunks), b"".join(stderr_chunks)


  try:
      for signum in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
          previous_handlers[signum] = signal.signal(signum, forward_signal)
      if pending_signal is not None:
          raise AdapterSignal(pending_signal)
      preflight_code, preflight_stdout, preflight_stderr = run_child(preflight_args)
      if preflight_code != 0 or preflight_stderr:
          stdout_bytes = preflight_stdout
          stderr_bytes = preflight_stderr
          raise ValueError(
              f"native buf module preflight exited {preflight_code} without valid completion evidence"
          )
      modules = parse_module_scope(preflight_stdout)
      validate_module_coverage(modules)
      returncode, stdout_bytes, stderr_bytes = run_child(child_args)
  except AdapterSignal as error:
      stop_child(error.signum)
      adapter_error = error
      returncode = 2
  except BaseException as error:
      stop_child()
      adapter_error = error
      returncode = 2
  finally:
      cleaning = True
      try:
          for signum, handler in previous_handlers.items():
              try:
                  signal.signal(signum, handler)
              except (OSError, ValueError):
                  pass
      finally:
          cleaning = False
      if pending_signal is not None and adapter_error is None:
          adapter_error = AdapterSignal(pending_signal)
          returncode = 2
  process = None


  def forward_raw():
      if stdout_bytes:
          sys.stdout.buffer.write(stdout_bytes)
      if stderr_bytes:
          sys.stderr.buffer.write(stderr_bytes)


  def canonical_diff(raw):
      text = raw.decode("utf-8")
      if not text.endswith("\n"):
          raise ValueError("diff output has no final newline")
      lines = text.splitlines(keepends=True)
      stable = []
      index = 0
      blocks = 0
      previous_path = None
      while index < len(lines):
          command = lines[index]
          if not command.startswith("diff -u ") or not command.endswith("\n"):
              raise ValueError(f"expected diff command at line {index + 1}")
          if index + 2 >= len(lines):
              raise ValueError("truncated diff headers")
          old_header = lines[index + 1]
          new_header = lines[index + 2]
          if not old_header.startswith("--- ") or not new_header.startswith("+++ "):
              raise ValueError("invalid unified-diff headers")
          if not old_header.endswith("\n") or not new_header.endswith("\n"):
              raise ValueError("unterminated unified-diff headers")
          old_fields = old_header[4:-1].rsplit("\t", 1)
          new_fields = new_header[4:-1].rsplit("\t", 1)
          if len(old_fields) != 2 or len(new_fields) != 2:
              raise ValueError("diff headers omit mtime fields")
          old_path, old_mtime = old_fields
          new_path, new_mtime = new_fields
          if (
              not old_path.endswith(".orig")
              or old_path[:-5] != new_path
              or not new_path.endswith(".proto")
              or MTIME.fullmatch(old_mtime) is None
              or MTIME.fullmatch(new_mtime) is None
              or command[:-1] != f"diff -u {old_path} {new_path}"
          ):
              raise ValueError("diff command and header paths disagree")
          if previous_path is not None and new_path <= previous_path:
              raise ValueError("diff paths are repeated or not sorted")
          previous_path = new_path
          candidate = os.path.realpath(new_path)
          try:
              inside_workspace = os.path.commonpath((workspace, candidate)) == workspace
          except ValueError:
              inside_workspace = False
          if not inside_workspace:
              raise ValueError(f"diff path escapes workspace: {new_path}")
          stable.extend(
              (
                  command,
                  f"--- {old_path}\t<mtime>\n",
                  f"+++ {new_path}\t<mtime>\n",
              )
          )
          index += 3
          hunk_count = 0
          while index < len(lines) and not lines[index].startswith("diff -u "):
              header = lines[index]
              if not header.endswith("\n"):
                  raise ValueError("unterminated unified-diff hunk header")
              match = HUNK.fullmatch(header[:-1])
              if match is None:
                  raise ValueError("expected unified-diff hunk header")
              expected_old = int(match.group(2)) if match.group(2) is not None else 1
              expected_new = int(match.group(4)) if match.group(4) is not None else 1
              observed_old = 0
              observed_new = 0
              stable.append(header)
              index += 1
              while (
                  index < len(lines)
                  and not lines[index].startswith("diff -u ")
                  and not lines[index].startswith("@@ ")
              ):
                  line = lines[index]
                  if not line.endswith("\n"):
                      raise ValueError("unterminated unified-diff body line")
                  if line.startswith(" "):
                      observed_old += 1
                      observed_new += 1
                  elif line.startswith("-"):
                      observed_old += 1
                  elif line.startswith("+"):
                      observed_new += 1
                  elif line == "\\ No newline at end of file\n":
                      pass
                  else:
                      raise ValueError("invalid unified-diff body line")
                  stable.append(line)
                  index += 1
              if observed_old != expected_old or observed_new != expected_new:
                  raise ValueError("unified-diff hunk counts disagree")
              hunk_count += 1
          if hunk_count == 0:
              raise ValueError("unified-diff block has no hunk")
          blocks += 1
      if blocks == 0:
          raise ValueError("diff output has no blocks")
      return "".join(stable).encode("utf-8")


  if adapter_error is not None:
      forward_raw()
      fail(str(adapter_error))

  if returncode == 0 and not stdout_bytes and not stderr_bytes:
      raise SystemExit(0)

  if phase == "verify" and returncode == 100 and not stderr_bytes:
      try:
          stable_stdout = canonical_diff(stdout_bytes)
      except (UnicodeError, ValueError) as error:
          forward_raw()
          fail(f"invalid unified-diff completion: {error}")
      sys.stdout.buffer.write(stable_stdout)
      raise SystemExit(100)

  forward_raw()
  fail(f"native buf format exited {returncode} without valid completion evidence")
  """#

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "buf-format"
  displayName = "buf format"
  executable = "buf"
  installHint = "install exact Buf 1.72.0, Python 3 with isolated-mode support, and diff at /usr/bin/diff"
  workspaceIndicator = "buf.yaml"
  phaseInvocation = "workspace"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.proto"; "**/*.proto" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      program = "python"
      argv = new Listing<String | Config.ArgToken> {
        "-I"
        "-c"
        bufFormatAdapter
        new Config.ToolExecutable {}
        "write"
        new Config.ExtraArgs {}
        "__VELVET_GLOVE_BUF_WORKSPACE__"
        new Config.Workspace {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        failure = new Listing<Int> { 2 }
      }
      writes = "workspace"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      program = "python"
      argv = new Listing<String | Config.ArgToken> {
        "-I"
        "-c"
        bufFormatAdapter
        new Config.ToolExecutable {}
        "verify"
        new Config.ExtraArgs {}
        "__VELVET_GLOVE_BUF_WORKSPACE__"
        new Config.Workspace {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 100 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }
}
