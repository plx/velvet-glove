/// oxlint — Oxidation compiler's Rust-based JavaScript/TypeScript linter.
///
/// oxlint tiers its fixes: plain `--fix` only applies changes it considers
/// certainly safe. Many common findings (e.g. `double-comparisons`) are
/// tagged "suggestion" and are only applied with `--fix-suggestions`, which
/// oxlint still keeps separate from `--fix-dangerously` (semantics-risking
/// fixes we deliberately do not opt into). Verified empirically against
/// oxlint 1.84.0: `--fix` alone left a `x === y || x < y` simplification
/// untouched; adding `--fix-suggestions` rewrote it to `x <= y`.
///
/// Config-parse errors, syntax errors, and lint issues all exit 1 with no
/// other observable signal, so an operational failure is not distinguishable
/// from an "issues" result here; no `operational-failure` fixture is claimed.

module velvet_glove.builtins.tools.Oxlint

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "oxlint"
  displayName = "oxlint"
  executable = "oxlint"
  installHint = "install oxlint with `npm i -g oxlint` or add it to the project"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.js"; "**/*.js"
      "*.mjs"; "**/*.mjs"
      "*.cjs"; "**/*.cjs"
      "*.ts"; "**/*.ts"
      "*.mts"; "**/*.mts"
      "*.cts"; "**/*.cts"
      "*.jsx"; "**/*.jsx"
      "*.tsx"; "**/*.tsx"
      "*.vue"; "**/*.vue"
      "*.svelte"; "**/*.svelte"
      "*.astro"; "**/*.astro"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "--deny-warnings"
        "--fix"
        "--fix-suggestions"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--deny-warnings"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }
}
