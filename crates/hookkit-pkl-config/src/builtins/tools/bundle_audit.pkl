/// bundler-audit — scans Gemfile.lock for known vulnerable dependencies.
///
/// Operates at the workspace level — the runner invokes it against the
/// nearest ancestor directory containing `Gemfile.lock`, so a nested Ruby app
/// in a monorepo is scanned in place. `check [DIR]` looks for `DIR/
/// Gemfile.lock`; passing the overall project root here instead of that
/// nested workspace makes it report `Could not find "Gemfile.lock"` at exit
/// 1 — the same code used for "vulnerabilities found" — silently hiding any
/// real vulnerabilities in the nested app (verified against bundler-audit
/// 0.9.3). The first run on a machine with no cached copy of
/// ruby-advisory-db clones it over the network regardless of `--update`;
/// `detect` requires an explicit `.bundler-audit.yml` so this stays opt-in.

module velvet_glove.builtins.tools.BundleAudit

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "bundle-audit"
  displayName = "bundler-audit"
  executable = "bundle-audit"
  installHint = "install bundler-audit with `gem install bundler-audit`"
  workspaceIndicator = "Gemfile.lock"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "Gemfile"; "**/Gemfile"
      "Gemfile.lock"; "**/Gemfile.lock"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "check"
        new Config.ExtraArgs {}
        new Config.Workspace {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".bundler-audit.yml" }
    note = "config-only: fetches its advisory database over the network on first run"
  }
}
