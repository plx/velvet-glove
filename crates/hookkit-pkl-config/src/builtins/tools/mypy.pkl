/// mypy — static type checker for Python.
///
/// Validated empirically: batch invocation checks all cited files together
/// and correctly scopes errors to the file they came from (see the
/// multi-file fixture). mypy writes a `.mypy_cache/` directory in its
/// current working directory as normal, expected caching behavior (unlike
/// python-check-ast's accidental `.pyc` writes, this is a documented mypy
/// feature, not something this spec should disable); `writes = "none"`
/// still correctly describes that mypy never rewrites the *target* source
/// files. Without a project config pointing at the right interpreter/venv,
/// imports of third-party packages outside the standard library may report
/// as missing, matching what running mypy directly would show.

module velvet_glove.builtins.tools.Mypy

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "mypy"
  displayName = "mypy"
  executable = "mypy"
  installHint = "install mypy with `brew install mypy` or `pipx install mypy`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.py"; "**/*.py"; "*.pyi"; "**/*.pyi" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
