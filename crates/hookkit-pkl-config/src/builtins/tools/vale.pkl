/// Vale — syntax-aware prose linter for Markdown, AsciiDoc, reST, HTML, etc.
///
/// Verified empirically against real vale 3.23.0: exits 0 clean / 1 with
/// alerts on stdout (`--output=line`), and a bad `StylesPath` or malformed
/// `.vale.ini` exits 2 — distinct from both, so it already falls through to
/// `exitCodes.failure` by default. Vale has no autofix, so this tool only
/// ever reports; batched files are each attributed by name in the line
/// output.

module velvet_glove.builtins.tools.Vale

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "vale"
  displayName = "Vale"
  executable = "vale"
  installHint = "install vale with `brew install vale`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.md"; "**/*.md"
      "*.markdown"; "**/*.markdown"
      "*.txt"; "**/*.txt"
      "*.rst"; "**/*.rst"
      "*.adoc"; "**/*.adoc"
      "*.asciidoc"; "**/*.asciidoc"
      "*.html"; "**/*.html"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--output=line"
        "--no-wrap"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".vale.ini"; "_vale.ini" }
    role = "prose-lint"
  }
}
