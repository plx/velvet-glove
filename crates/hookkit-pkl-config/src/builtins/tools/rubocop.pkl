/// RuboCop — Ruby linter with auto-correct.
///
/// `--autocorrect` is rubocop's `-a` (safe autocorrections only); the
/// unsafe/all mode is the separate `-A`/`--autocorrect-all` flag, which this
/// spec never passes. Batch invocation is safe: multiple file arguments are
/// each attributed correctly. An invalid `.rubocop.yml` raises
/// `RuboCop::CLI::STATUS_ERROR` (exit 2), distinct from both `clean` and
/// `issues` (verified against rubocop 1.91.0), so it is already classified as
/// a failure by the default `unexpected` policy.

module velvet_glove.builtins.tools.Rubocop

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "rubocop"
  displayName = "RuboCop"
  executable = "rubocop"
  installHint = "install rubocop with `gem install rubocop` or add it to the project Gemfile"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.rb"; "**/*.rb" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "--force-exclusion"
        "--autocorrect"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--force-exclusion"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".rubocop.yml" }
    contains = new Mapping<String, String> { ["Gemfile"] = "rubocop" }
    role = "ruby-lint"
  }
}
