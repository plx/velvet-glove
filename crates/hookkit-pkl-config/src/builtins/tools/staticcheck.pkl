/// staticcheck — comprehensive Go static analysis.
///
/// staticcheck exits 1 both for reported findings and for a package that
/// fails to compile, and also for a malformed `staticcheck.conf` (reported
/// as a "(config)" finding on the same exit code). None of those are
/// distinguishable from a real lint issue by exit code alone, so no
/// operational-failure fixture is included.

module velvet_glove.builtins.tools.Staticcheck

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "staticcheck"
  displayName = "staticcheck"
  executable = "staticcheck"
  installHint = "install staticcheck with `go install honnef.co/go/tools/cmd/staticcheck@latest`"
  workspaceIndicator = "go.mod"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.go"; "**/*.go" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        "./..."
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "staticcheck.conf" }
    role = "go-lint"
  }
}
