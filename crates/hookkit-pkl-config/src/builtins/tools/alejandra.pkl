/// Alejandra — opinionated Nix formatter.
///
/// Verified with Alejandra 4.0.0: `--check` exits 0 clean, 2 when a file
/// needs formatting, and 1 on a parse error (never mutates on that path);
/// plain invocation mirrors the same 0/1 split and only rewrites files that
/// parse. Multiple explicit file args are each reported individually and no
/// extra files are scanned.

module velvet_glove.builtins.tools.Alejandra

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "alejandra"
  displayName = "Alejandra"
  executable = "alejandra"
  installHint = "install alejandra with `brew install alejandra` or `nix-env -iA nixpkgs.alejandra`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.nix"; "**/*.nix" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        failure = new Listing<Int> { 1 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 2 }
        failure = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "alejandra.toml" }
    role = "nix-format"
  }
}
