/// php-cs — PHP CodeSniffer (`phpcs`) style checker with `phpcbf` auto-fixer.
///
/// PHP_CodeSniffer 4.x (probed with 4.0.4) exits with a bitmask: 1 = fixable
/// issues remain, 2 = non-fixable issues remain, 4 = phpcbf failed to fix a
/// file, 16 = process error (unknown standard, bad arguments, missing file).
/// A file with both kinds of violation makes `phpcs` exit 3, and `phpcbf`
/// exits 2 when only non-fixable violations remain after fixing. 3.x (probed
/// with 3.13.5) used 1 = non-fixable only, 2 = fixable present, 3 = process
/// error, so on 3.x a process error is reported as an issue, not a failure.

module velvet_glove.builtins.tools.PhpCs

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "php-cs"
  displayName = "PHP_CodeSniffer"
  executable = "phpcs"
  installHint =
    "install PHP_CodeSniffer (`phpcs`/`phpcbf`) via `brew install php-code-sniffer` or `composer global require \"squizlabs/php_codesniffer=*\"`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.php"; "**/*.php" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      program = "phpcbf"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1; 2; 3; 4; 5; 6; 7 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1; 2; 3 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "phpcs.xml"; "phpcs.xml.dist"; ".phpcs.xml"; ".phpcs.xml.dist" }
    role = "php-lint"
  }
}
