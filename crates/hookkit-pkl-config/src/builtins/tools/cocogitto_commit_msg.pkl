/// cocogitto-commit-msg — validate a commit message with `cog verify`.
///
// NOT APPLICABLE to agent file hooks: like `check_conventional_commit`,
// this is a `commit-msg` hook that takes the commit-message *file* path as
// its argument (`cog --quiet verify --file <path>`), not the list of
// project files a post-tool-use hook produces, and it only makes sense at
// commit time. Listed here for catalog completeness; kept disabled.

module velvet_glove.builtins.tools.CocogittoCommitMsg

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "cocogitto-commit-msg"
  displayName = "cocogitto commit-msg"
  executable = "cog"
  installHint = "install cocogitto with `brew install cocogitto` or `cargo install cocogitto`"
  workspaceIndicator = "cog.toml"
  enabled = false

  files = new Config.FileSelection {
    include = new Listing<String> {}
  }

  phases = new Mapping<String, Config.Phase> {}
  phaseOrder = new Listing<String> {}
}
