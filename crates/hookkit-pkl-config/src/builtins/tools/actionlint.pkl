/// actionlint — GitHub Actions workflow linter.
///
/// actionlint treats any YAML file as a workflow document: on a non-workflow
/// YAML file it still parses successfully and then reports "jobs section is
/// missing" / "on section is missing" as lint findings, which would be a
/// false positive if the glob matched arbitrary YAML. Workflows only ever
/// live under `.github/workflows/`, so the glob is scoped there.

module velvet_glove.builtins.tools.Actionlint

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "actionlint"
  displayName = "actionlint"
  executable = "actionlint"
  installHint = "install actionlint with `brew install actionlint`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      ".github/workflows/*.yml"; ".github/workflows/*.yaml"
      "**/.github/workflows/*.yml"; "**/.github/workflows/*.yaml"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { ".github/workflows/*.yml"; ".github/workflows/*.yaml" }
    role = "gha-lint"
  }
}
