/// ESLint — JavaScript/TypeScript linter with auto-fix.
///
/// ESLint 9 finds its flat config from the working directory upward (ESLint
/// 10 from each file's directory), so files run from their nearest
/// `package.json` directory: a backend+frontend repository's
/// `frontend/eslint.config.mjs` is found, and a monorepo package without its
/// own config still reaches the root one. Files outside every package run
/// from the project root.

module velvet_glove.builtins.tools.Eslint

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "eslint"
  displayName = "ESLint"
  executable = "eslint"
  installHint = "install eslint with `brew install eslint` or add it to the project"
  workspaceIndicator = "package.json"
  workspaceFallback = "project-root"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.js"; "**/*.js"
      "*.mjs"; "**/*.mjs"
      "*.cjs"; "**/*.cjs"
      "*.jsx"; "**/*.jsx"
      "*.ts"; "**/*.ts"
      "*.mts"; "**/*.mts"
      "*.cts"; "**/*.cts"
      "*.tsx"; "**/*.tsx"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "--fix"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "eslint.config.*"; ".eslintrc"; ".eslintrc.*" }
    contains = new Mapping<String, String> { ["package.json"] = "\"eslint\"" }
    role = "js-lint"
  }
}
