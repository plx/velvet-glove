/// ESLint — JavaScript linter with a data-only, built-in-rule contract.
///
/// The isolated adapter never discovers or executes project ESLint config,
/// plugins, parsers, processors, or ignore files. An optional project-root
/// `.velvet-glove-eslint.json` file can change only the severity of the small
/// allowlist below; the adapter translates that data into a private CJS flat
/// config. TypeScript and JSX are deliberately outside this core contract.
///
/// Fix first performs a complete read-only verify and `--fix-dry-run`, then
/// invokes native `--fix` only for files whose exact output was predicted. It
/// checks every resulting byte against that prediction and verifies the whole
/// batch again. A selected file can still be replaced or changed after its
/// validation, and a late native write failure can leave partial writes; the
/// adapter deliberately does not attempt an unsafe rollback.

module velvet_glove.builtins.tools.Eslint

import "../Config.pkl" as Config

eslintAdapter: String = #"""
  import json
  import os
  import selectors
  import shutil
  import signal
  import stat
  import subprocess
  import sys
  import tempfile
  import time

  MARKER = "__VELVET_GLOVE_ESLINT_FILES__"
  CONFIG_NAME = ".velvet-glove-eslint.json"
  OUTPUT_LIMIT = 16 * 1024 * 1024
  FILE_LIMIT = 16 * 1024 * 1024
  TOTAL_FILE_LIMIT = 64 * 1024 * 1024
  CONFIG_LIMIT = 1024 * 1024
  ALLOWED_EXTENSIONS = (".js", ".cjs", ".mjs")
  RULES = (
      "eqeqeq",
      "no-debugger",
      "no-undef",
      "no-unused-vars",
      "no-var",
      "prefer-const",
      "semi",
  )
  DEFAULT_RULES = {name: 2 for name in RULES}
  SEVERITIES = {"off": 0, "warn": 1, "error": 2}


  def fail(message):
      print(f"velvet-glove-eslint: {message}", file=sys.stderr)
      raise SystemExit(2)


  if len(sys.argv) < 6 or sys.argv[4:].count(MARKER) != 1:
      fail("invalid adapter arguments")
  requested_node = sys.argv[1]
  requested_tool = sys.argv[2]
  phase = sys.argv[3]
  payload = sys.argv[4:]
  marker_index = payload.index(MARKER)
  extra_args = payload[:marker_index]
  requested_files = payload[marker_index + 1 :]
  if phase not in ("fix", "verify") or not requested_files:
      fail("invalid phase or empty file selection")
  if extra_args:
      fail("extra arguments are unsupported by the controlled ESLint contract")

  workspace = os.path.realpath(os.getcwd())
  try:
      workspace_info = os.lstat(workspace)
  except OSError as error:
      fail(f"cannot inspect project root: {error}")
  if not stat.S_ISDIR(workspace_info.st_mode) or os.path.islink(workspace):
      fail(f"working directory is not a real directory: {workspace}")
  # Native cache artifacts inherit this private-only mask.
  os.umask(0o077)


  def inside_workspace(path):
      try:
          return os.path.commonpath((workspace, path)) == workspace
      except ValueError:
          return False


  def controlled_path(value, label):
      if not value or "\n" in value or "\r" in value or "\x00" in value:
          fail(f"{label} is not a nonempty single-line path")
      lexical = os.path.abspath(value)
      if not inside_workspace(lexical):
          fail(f"{label} escapes the project root: {value}")
      if os.path.realpath(lexical) != lexical:
          fail(f"{label} traverses a symlink: {value}")
      return lexical


  def read_unique_file(path, label, limit):
      fd = None
      try:
          flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
          fd = os.open(path, flags)
          info = os.fstat(fd)
          current = os.lstat(path)
          if (
              not stat.S_ISREG(info.st_mode)
              or info.st_nlink != 1
              or stat.S_ISLNK(current.st_mode)
              or (info.st_dev, info.st_ino) != (current.st_dev, current.st_ino)
          ):
              raise ValueError(f"{label} is not a unique regular file")
          with os.fdopen(fd, "rb") as source:
              fd = None
              content = source.read(limit + 1)
          if len(content) > limit:
              raise ValueError(f"{label} exceeds the {limit}-byte limit")
          return info, content
      except (OSError, ValueError) as error:
          fail(f"cannot read {label}: {error}")
      finally:
          if fd is not None:
              os.close(fd)


  files = []
  identities = set()
  total_source_bytes = 0
  for requested in requested_files:
      path = controlled_path(requested, "selected path")
      if os.path.splitext(path)[1] not in ALLOWED_EXTENSIONS:
          fail(f"selected path has an unsupported extension: {requested}")
      info, content = read_unique_file(path, f"selected path {requested}", FILE_LIMIT)
      try:
          content.decode("utf-8")
          path.encode("utf-8")
      except UnicodeError as error:
          fail(f"selected path or source is not UTF-8: {error}")
      identity = (info.st_dev, info.st_ino)
      if identity in identities:
          fail(f"selected paths repeat or alias one file: {requested}")
      identities.add(identity)
      total_source_bytes += len(content)
      if total_source_bytes > TOTAL_FILE_LIMIT:
          fail(f"selected source exceeds the {TOTAL_FILE_LIMIT}-byte aggregate limit")
      files.append(path)
  if len(files) != len(set(files)):
      fail("selected paths repeat after normalization")
  files.sort()


  def reject_duplicate_pairs(pairs):
      value = {}
      for key, item in pairs:
          if key in value:
              raise ValueError(f"duplicate JSON key {key!r}")
          value[key] = item
      return value


  rules = dict(DEFAULT_RULES)
  source_config_path = os.path.join(workspace, CONFIG_NAME)
  try:
      source_config_exists = os.path.lexists(source_config_path)
  except OSError as error:
      fail(f"cannot inspect {CONFIG_NAME}: {error}")
  if source_config_exists:
      _, config_bytes = read_unique_file(source_config_path, CONFIG_NAME, CONFIG_LIMIT)
      try:
          document = json.loads(
              config_bytes.decode("utf-8"),
              object_pairs_hook=reject_duplicate_pairs,
              parse_constant=lambda value: (_ for _ in ()).throw(
                  ValueError(f"non-finite JSON value {value}")
              ),
          )
      except (UnicodeError, json.JSONDecodeError, ValueError) as error:
          fail(f"{CONFIG_NAME} is not strict UTF-8 JSON: {error}")
      if not isinstance(document, dict):
          fail(f"{CONFIG_NAME} must contain one JSON object")
      unknown = set(document) - {"$schema", "rules"}
      if unknown:
          fail(f"{CONFIG_NAME} contains unsupported keys: {sorted(unknown)!r}")
      if "$schema" in document and not isinstance(document["$schema"], str):
          fail(f"{CONFIG_NAME} $schema must be a string")
      configured_rules = document.get("rules", {})
      if not isinstance(configured_rules, dict):
          fail(f"{CONFIG_NAME} rules must be a JSON object")
      for name, severity in configured_rules.items():
          if name not in RULES:
              fail(f"{CONFIG_NAME} contains unsupported rule {name!r}")
          if isinstance(severity, bool):
              fail(f"{CONFIG_NAME} rule {name!r} severity cannot be boolean")
          if isinstance(severity, str):
              if severity not in SEVERITIES:
                  fail(f"{CONFIG_NAME} rule {name!r} has unsupported severity {severity!r}")
              severity = SEVERITIES[severity]
          if not isinstance(severity, int) or severity not in (0, 1, 2):
              fail(f"{CONFIG_NAME} rule {name!r} severity must be 0, 1, 2, off, warn, or error")
          rules[name] = severity


  def resolve_program(requested, label, executable):
      resolved = requested if os.path.dirname(requested) else shutil.which(requested)
      if resolved is None:
          fail(f"cannot resolve {label} {requested!r}")
      resolved = os.path.realpath(resolved)
      try:
          info = os.stat(resolved)
      except OSError as error:
          fail(f"cannot inspect {label} {resolved}: {error}")
      if not stat.S_ISREG(info.st_mode) or not os.access(resolved, os.R_OK):
          fail(f"resolved {label} is not a readable regular file: {resolved}")
      if executable and not os.access(resolved, os.X_OK):
          fail(f"resolved {label} is not executable: {resolved}")
      return resolved


  node = resolve_program(requested_node, "Node executable", True)
  tool = resolve_program(requested_tool, "ESLint CLI", False)

  environment = {}
  for name in ("VELVET_GLOVE_TOOL_TRACE_DIR", "VELVET_GLOVE_TOOL_TRACE_SENTINEL"):
      if name in os.environ:
          environment[name] = os.environ[name]
  environment.update(
      {
          "PATH": "/usr/bin:/bin",
          "LANG": "C",
          "LC_ALL": "C",
          "TZ": "UTC",
          "TERM": "dumb",
          "CI": "1",
          "NO_COLOR": "1",
          "FORCE_COLOR": "0",
          "CLICOLOR": "0",
          "NODE_DISABLE_COLORS": "1",
          "UV_THREADPOOL_SIZE": "1",
      }
  )

  process = None
  pending_signal = None
  reported_signal = None
  cleaning = False
  output_total = 0
  private_root = None
  temp_root = None
  handled_signals = (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)


  class AdapterSignal(BaseException):
      def __init__(self, signum):
          super().__init__(f"received signal {signum}")
          self.signum = signum


  class EvidenceError(Exception):
      pass


  def signal_group(signum):
      if process is not None:
          try:
              os.killpg(process.pid, signum)
          except (OSError, ValueError):
              pass


  def process_group_exists():
      if process is None:
          return False
      try:
          os.killpg(process.pid, 0)
          return True
      except ProcessLookupError:
          return False
      except PermissionError:
          return True


  def sweep_process_group():
      if not process_group_exists():
          return False
      signal_group(signal.SIGKILL)
      deadline = time.monotonic() + 1
      while process_group_exists() and time.monotonic() < deadline:
          time.sleep(0.01)
      if process_group_exists():
          raise EvidenceError("cannot reap same-group descendants after child exit")
      return True


  def stop_child(initial_signal=None):
      global process
      global cleaning
      child = process
      if child is None:
          return None
      failures = []
      previous_cleaning = cleaning
      cleaning = True
      try:
          try:
              running = child.poll() is None
          except (OSError, ValueError) as error:
              failures.append(f"cannot poll native child: {error}")
              running = True
          if running:
              signal_group(initial_signal if initial_signal is not None else signal.SIGTERM)
              try:
                  child.wait(timeout=1)
              except subprocess.TimeoutExpired:
                  pass
              except (OSError, ValueError) as error:
                  failures.append(f"cannot stop native child gracefully: {error}")
          signal_group(signal.SIGKILL)
          try:
              child.wait(timeout=1)
          except (OSError, ValueError, subprocess.TimeoutExpired) as error:
              failures.append(f"cannot reap native child: {error}")
          try:
              deadline = time.monotonic() + 1
              while process_group_exists() and time.monotonic() < deadline:
                  time.sleep(0.01)
              if process_group_exists():
                  failures.append("native child process group survived SIGKILL")
          except (OSError, ValueError) as error:
              failures.append(f"cannot verify native child process-group cleanup: {error}")
      finally:
          process = None
          cleaning = previous_cleaning
      if failures:
          return EvidenceError("; ".join(failures))
      return None


  def forward_signal(signum, _frame):
      global pending_signal
      pending_signal = signum
      if process is not None and not cleaning:
          signal_group(signum)
          raise AdapterSignal(signum)


  def append_adapter_error(primary, secondary):
      if secondary is None:
          return primary
      if primary is None:
          return secondary
      return EvidenceError(f"{primary}; {secondary}")


  def apply_pending_signal(primary):
      global reported_signal
      if pending_signal is None or pending_signal == reported_signal:
          return primary
      reported_signal = pending_signal
      return append_adapter_error(primary, AdapterSignal(pending_signal))


  def drain_blocked_signals(primary):
      global pending_signal
      drained = False
      while True:
          queued = sorted(set(signal.sigpending()).intersection(handled_signals), key=int)
          if not queued:
              return primary, drained
          pending_signal = int(signal.sigwait({queued[0]}))
          primary = apply_pending_signal(primary)
          drained = True


  def run_child(arguments):
      global process
      global cleaning
      global output_total
      global stdout_bytes
      global stderr_bytes
      stdout_bytes = b""
      stderr_bytes = b""
      if pending_signal is not None:
          raise AdapterSignal(pending_signal)
      child = subprocess.Popen(
          arguments,
          stdin=subprocess.DEVNULL,
          stdout=subprocess.PIPE,
          stderr=subprocess.PIPE,
          cwd=workspace,
          env=environment,
          start_new_session=True,
      )
      process = child
      stdout_chunks = []
      stderr_chunks = []
      selector = selectors.DefaultSelector()
      leader_status = None
      leader_exit_deadline = None
      try:
          for stream, chunks in ((process.stdout, stdout_chunks), (process.stderr, stderr_chunks)):
              if stream is None:
                  raise OSError("failed to capture ESLint output")
              os.set_blocking(stream.fileno(), False)
              selector.register(stream, selectors.EVENT_READ, chunks)
          while selector.get_map():
              if pending_signal is not None:
                  raise AdapterSignal(pending_signal)
              for key, _ in selector.select(timeout=0.1):
                  chunk = os.read(key.fileobj.fileno(), 65536)
                  if chunk:
                      output_total += len(chunk)
                      if output_total > OUTPUT_LIMIT:
                          raise BufferError(f"combined output exceeded {OUTPUT_LIMIT} bytes")
                      key.data.append(chunk)
                  else:
                      selector.unregister(key.fileobj)
                      key.fileobj.close()
              if leader_status is None:
                  leader_status = process.poll()
                  if leader_status is not None:
                      leader_exit_deadline = time.monotonic() + 0.25
              if (
                  leader_status is not None
                  and selector.get_map()
                  and time.monotonic() >= leader_exit_deadline
              ):
                  previous_cleaning = cleaning
                  cleaning = True
                  try:
                      left_descendants = sweep_process_group()
                  finally:
                      cleaning = previous_cleaning
                  if left_descendants:
                      raise EvidenceError(
                          "native ESLint left same-group descendants after child exit"
                      )
                  raise EvidenceError(
                      "native ESLint child exited without closing output pipes"
                  )
          status = process.wait() if leader_status is None else leader_status
          previous_cleaning = cleaning
          cleaning = True
          try:
              left_descendants = sweep_process_group()
          finally:
              cleaning = previous_cleaning
          if left_descendants:
              raise EvidenceError("native ESLint left same-group descendants after child exit")
          process = None
          return status, b"".join(stdout_chunks), b"".join(stderr_chunks)
      finally:
          selector.close()
          for stream in (child.stdout, child.stderr):
              if stream is not None:
                  try:
                      stream.close()
                  except OSError:
                      pass
          stdout_bytes = b"".join(stdout_chunks)
          stderr_bytes = b"".join(stderr_chunks)


  def file_snapshot(paths):
      snapshot = {}
      total = 0
      for path in paths:
          info, content = read_unique_file(path, f"selected path {path}", FILE_LIMIT)
          try:
              content.decode("utf-8")
          except UnicodeError as error:
              raise EvidenceError(f"selected source became non-UTF-8: {path}: {error}")
          total += len(content)
          if total > TOTAL_FILE_LIMIT:
              raise EvidenceError("selected source exceeded the aggregate limit")
          snapshot[path] = (
              info.st_dev,
              info.st_ino,
              stat.S_IMODE(info.st_mode),
              content,
          )
      return snapshot


  def assert_snapshot(label, before, after):
      if before != after:
          changed = [path for path in files if before.get(path) != after.get(path)]
          raise EvidenceError(f"{label} changed selected files unexpectedly: {changed!r}")


  def strict_native_json(status, stdout, stderr, selected, label):
      if status not in (0, 1) or stderr:
          raise EvidenceError(f"{label} exited {status} without controlled JSON evidence")
      try:
          document = json.loads(
              stdout.decode("utf-8"),
              object_pairs_hook=reject_duplicate_pairs,
              parse_constant=lambda value: (_ for _ in ()).throw(
                  ValueError(f"non-finite JSON value {value}")
              ),
          )
      except (UnicodeError, json.JSONDecodeError, ValueError) as error:
          raise EvidenceError(f"{label} emitted invalid strict UTF-8 JSON: {error}")
      if not isinstance(document, list) or len(document) != len(selected):
          raise EvidenceError(f"{label} did not report exactly one result per selected file")
      by_path = {}
      for result in document:
          if not isinstance(result, dict) or not isinstance(result.get("filePath"), str):
              raise EvidenceError(f"{label} emitted a result without a string filePath")
          path = os.path.abspath(result["filePath"])
          if path not in selected or path in by_path:
              raise EvidenceError(f"{label} emitted duplicate or out-of-scope filePath {path!r}")
          if result.get("suppressedMessages", []) != []:
              raise EvidenceError(f"{label} used unexpected suppressions for {path!r}")
          messages = result.get("messages")
          if not isinstance(messages, list):
              raise EvidenceError(f"{label} emitted invalid messages for {path!r}")
          severities = []
          fatal_count = 0
          for message in messages:
              if not isinstance(message, dict):
                  raise EvidenceError(f"{label} emitted a non-object diagnostic")
              severity = message.get("severity")
              if isinstance(severity, bool) or severity not in (1, 2):
                  raise EvidenceError(f"{label} emitted invalid diagnostic severity")
              if not isinstance(message.get("message"), str):
                  raise EvidenceError(f"{label} emitted a diagnostic without a message")
              if "fatal" in message and not isinstance(message["fatal"], bool):
                  raise EvidenceError(f"{label} emitted a non-boolean fatal marker")
              severities.append(severity)
              if message.get("fatal", False) is True:
                  fatal_count += 1
          expected_counts = {
              "errorCount": severities.count(2),
              "warningCount": severities.count(1),
              "fatalErrorCount": fatal_count,
          }
          for key, expected in expected_counts.items():
              value = result.get(key)
              if isinstance(value, bool) or value != expected:
                  raise EvidenceError(
                      f"{label} emitted inconsistent {key} for {path!r}: {value!r}"
                  )
          for key, total_key in (
              ("fixableErrorCount", "errorCount"),
              ("fixableWarningCount", "warningCount"),
          ):
              value = result.get(key)
              if (
                  isinstance(value, bool)
                  or not isinstance(value, int)
                  or value < 0
                  or value > result[total_key]
              ):
                  raise EvidenceError(f"{label} emitted invalid {key} for {path!r}")
          if "output" in result and not isinstance(result["output"], str):
              raise EvidenceError(f"{label} emitted non-string fix output for {path!r}")
          result = dict(result)
          result["filePath"] = path
          by_path[path] = result
      ordered = [by_path[path] for path in selected]
      issue_count = sum(item["errorCount"] + item["warningCount"] for item in ordered)
      expected_status = 1 if issue_count else 0
      if status != expected_status:
          raise EvidenceError(
              f"{label} status {status} conflicts with its error/warning counts"
          )
      return ordered


  def comparable_results(results):
      comparable = []
      for result in results:
          item = dict(result)
          item.pop("output", None)
          # `source` is the original input for fix-dry-run and the fixed input
          # for the final verify. Exact output bytes are compared separately.
          item.pop("source", None)
          comparable.append(item)
      return comparable


  def rendered_results(results):
      rendered = []
      for result in results:
          item = {
              "filePath": os.path.relpath(result["filePath"], workspace),
              "messages": result["messages"],
              "errorCount": result["errorCount"],
              "fatalErrorCount": result["fatalErrorCount"],
              "warningCount": result["warningCount"],
              "fixableErrorCount": result["fixableErrorCount"],
              "fixableWarningCount": result["fixableWarningCount"],
          }
          rendered.append(item)
      return (
          json.dumps(rendered, ensure_ascii=False, separators=(",", ":"), sort_keys=True)
          + "\n"
      ).encode("utf-8")


  cache_counter = 0


  def child_arguments(selected, native_mode, config_path, suppressions_path):
      global cache_counter
      cache_dir = os.path.join(private_root, f"cache-{cache_counter}")
      cache_counter += 1
      os.mkdir(cache_dir, 0o700)
      arguments = [
          node,
          tool,
          "--format=json",
          "--no-color",
          "--no-config-lookup",
          f"--config={config_path}",
          "--no-ignore",
          "--no-warn-ignored",
          "--no-inline-config",
          "--max-warnings=0",
          "--concurrency=off",
          "--cache",
          "--cache-strategy=content",
          f"--cache-location={os.path.join(cache_dir, '.eslintcache')}",
          f"--suppressions-location={suppressions_path}",
          "--pass-on-unpruned-suppressions",
      ]
      if native_mode == "dry-run":
          arguments.append("--fix-dry-run")
      elif native_mode == "fix":
          arguments.append("--fix")
      elif native_mode != "verify":
          raise ValueError(f"unsupported native mode {native_mode!r}")
      arguments.append("--")
      arguments.extend(selected)
      return arguments


  def write_private(path, content):
      fd = os.open(
          path,
          os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_CLOEXEC", 0),
          0o600,
      )
      try:
          os.fchmod(fd, 0o600)
          with os.fdopen(fd, "wb") as destination:
              fd = None
              destination.write(content)
              destination.flush()
              os.fsync(destination.fileno())
      finally:
          if fd is not None:
              os.close(fd)


  def sanitize(value):
      if isinstance(value, bytes):
          if private_root is None:
              return value
          return value.replace(os.fsencode(private_root), b"<eslint-private>")
      message = str(value)
      if private_root is not None:
          return message.replace(private_root, "<eslint-private>")
      if isinstance(value, OSError) and value.filename is not None and temp_root is not None:
          filename = os.fsdecode(value.filename)
          candidate = os.path.abspath(filename)
          if (
              os.path.dirname(candidate) == temp_root
              and os.path.basename(candidate).startswith("velvet-glove-eslint-")
          ):
              message = message.replace(filename, "<eslint-private>")
      return message


  previous_handlers = {}
  stdout_bytes = b""
  stderr_bytes = b""
  adapter_error = None
  returncode = 2
  final_results = None
  try:
      for signum in handled_signals:
          previous_handlers[signum] = signal.signal(signum, forward_signal)
      requested_temp_root = os.environ.get("TMPDIR")
      temp_root = os.path.realpath(
          requested_temp_root if requested_temp_root else tempfile.gettempdir()
      )
      temp_info = os.lstat(temp_root)
      if not stat.S_ISDIR(temp_info.st_mode) or os.path.islink(temp_root):
          raise OSError(f"temporary root is not a real directory: {temp_root}")
      if inside_workspace(temp_root):
          raise OSError(f"temporary root must be outside the project: {temp_root}")
      private_root = tempfile.mkdtemp(prefix="velvet-glove-eslint-", dir=temp_root)
      os.chmod(private_root, 0o700)
      config_path = os.path.join(private_root, "eslint.config.cjs")
      suppressions_path = os.path.join(private_root, "suppressions.json")
      rendered_rules = {
          name: ([severity, "always"] if name == "semi" else severity)
          for name, severity in sorted(rules.items())
      }
      common = {
          "linterOptions": {
              "noInlineConfig": True,
              "reportUnusedDisableDirectives": "error",
          },
          "rules": rendered_rules,
      }
      config = [
          dict(
              common,
              files=["**/*.js", "**/*.mjs"],
              languageOptions={"ecmaVersion": "latest", "sourceType": "module"},
          ),
          dict(
              common,
              files=["**/*.cjs"],
              languageOptions={"ecmaVersion": "latest", "sourceType": "commonjs"},
          ),
      ]
      config_bytes = (
          b"'use strict';\nmodule.exports = "
          + json.dumps(config, ensure_ascii=False, separators=(",", ":"), sort_keys=True).encode("utf-8")
          + b";\n"
      )
      write_private(config_path, config_bytes)
      write_private(suppressions_path, b"{}\n")

      initial = file_snapshot(files)
      verify_status, verify_stdout, verify_stderr = run_child(
          child_arguments(files, "verify", config_path, suppressions_path)
      )
      verify_results = strict_native_json(
          verify_status, verify_stdout, verify_stderr, files, "native ESLint verify preflight"
      )
      assert_snapshot("native ESLint verify preflight", initial, file_snapshot(files))

      if phase == "verify":
          returncode = verify_status
          final_results = verify_results
      else:
          dry_status, dry_stdout, dry_stderr = run_child(
              child_arguments(files, "dry-run", config_path, suppressions_path)
          )
          dry_results = strict_native_json(
              dry_status, dry_stdout, dry_stderr, files, "native ESLint fix dry-run"
          )
          assert_snapshot("native ESLint fix dry-run", initial, file_snapshot(files))
          predicted = {}
          for result in dry_results:
              output = result.get("output")
              if output is None:
                  continue
              try:
                  output_bytes = output.encode("utf-8")
              except UnicodeError as error:
                  raise EvidenceError(f"native ESLint predicted non-UTF-8 output: {error}")
              if output_bytes != initial[result["filePath"]][3]:
                  predicted[result["filePath"]] = output_bytes
          if any(result["fatalErrorCount"] for result in dry_results):
              returncode = dry_status
              final_results = dry_results
          elif not predicted:
              returncode = dry_status
              final_results = dry_results
          else:
              assert_snapshot("ESLint pre-write cutoff", initial, file_snapshot(files))
              changed = sorted(predicted)
              fix_status, fix_stdout, fix_stderr = run_child(
                  child_arguments(changed, "fix", config_path, suppressions_path)
              )
              fix_results = strict_native_json(
                  fix_status, fix_stdout, fix_stderr, changed, "native ESLint fix"
              )
              actual = file_snapshot(files)
              for path in files:
                  before_identity = initial[path][:3]
                  after_identity = actual[path][:3]
                  if before_identity != after_identity:
                      raise EvidenceError(f"native ESLint replaced or changed mode for {path!r}")
                  expected_bytes = predicted.get(path, initial[path][3])
                  if actual[path][3] != expected_bytes:
                      raise EvidenceError(f"native ESLint write differed from dry-run output for {path!r}")
              for result in fix_results:
                  if "output" in result and result["output"].encode("utf-8") != predicted[result["filePath"]]:
                      raise EvidenceError(
                          f"native ESLint fix report differed from dry-run output for {result['filePath']!r}"
                      )
              final_status, final_stdout, final_stderr = run_child(
                  child_arguments(files, "verify", config_path, suppressions_path)
              )
              final_results = strict_native_json(
                  final_status, final_stdout, final_stderr, files, "native ESLint final verify"
              )
              assert_snapshot("native ESLint final verify", actual, file_snapshot(files))
              if comparable_results(final_results) != comparable_results(dry_results):
                  raise EvidenceError("native ESLint final diagnostics differ from fix dry-run")
              returncode = final_status
  except AdapterSignal as error:
      adapter_error = append_adapter_error(error, stop_child(error.signum))
      reported_signal = error.signum
      returncode = 2
  except BaseException as error:
      adapter_error = append_adapter_error(error, stop_child())
      returncode = 2
  finally:
      cleaning = True
      blocked_mask = None
      try:
          if private_root is not None:
              try:
                  shutil.rmtree(private_root)
              except FileNotFoundError:
                  pass
              except OSError as error:
                  if adapter_error is None:
                      adapter_error = error
                  else:
                      adapter_error = ValueError(f"{adapter_error}; {error}")
                  returncode = 2
          try:
              blocked_mask = signal.pthread_sigmask(signal.SIG_BLOCK, handled_signals)
          except (OSError, ValueError) as error:
              adapter_error = append_adapter_error(
                  adapter_error, ValueError(f"cannot block cleanup signals: {error}")
              )
              returncode = 2
          adapter_error = apply_pending_signal(adapter_error)
          if blocked_mask is not None:
              while True:
                  adapter_error, drained = drain_blocked_signals(adapter_error)
                  if not drained:
                      break
          if adapter_error is not None:
              returncode = 2
      finally:
          # Signals stay blocked through diagnostics and process exit. Restoring
          # handlers before unblocking avoids a post-cleanup termination window.
          for signum, handler in previous_handlers.items():
              try:
                  signal.signal(signum, handler)
              except (OSError, ValueError):
                  pass
          cleaning = False
  process = None

  if adapter_error is not None:
      if stdout_bytes:
          sys.stdout.buffer.write(sanitize(stdout_bytes))
      if stderr_bytes:
          sys.stderr.buffer.write(sanitize(stderr_bytes))
      fail(sanitize(adapter_error))
  if returncode == 0:
      raise SystemExit(0)
  if returncode == 1 and final_results is not None:
      sys.stderr.buffer.write(rendered_results(final_results))
      raise SystemExit(1)
  fail(f"native ESLint exited {returncode} without valid completion evidence")
  """#

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "eslint"
  displayName = "ESLint"
  executable = "eslint"
  installHint = "install exact ESLint 10.8.1, its pinned Node 24.19.0 runtime, and a Python 3 interpreter with isolated-mode support"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.js"; "**/*.js"
      "*.cjs"; "**/*.cjs"
      "*.mjs"; "**/*.mjs"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      program = "python"
      argv = new Listing<String | Config.ArgToken> {
        "-I"
        "-c"
        eslintAdapter
        "node"
        new Config.ToolExecutable {}
        "fix"
        new Config.ExtraArgs {}
        "__VELVET_GLOVE_ESLINT_FILES__"
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      program = "python"
      argv = new Listing<String | Config.ArgToken> {
        "-I"
        "-c"
        eslintAdapter
        "node"
        new Config.ToolExecutable {}
        "verify"
        new Config.ExtraArgs {}
        "__VELVET_GLOVE_ESLINT_FILES__"
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }
}
