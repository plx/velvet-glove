/// cargo fmt — runs rustfmt on a Cargo package.
///
/// `--manifest-path <WorkspaceIndicator>` names the *member* package nearest
/// the touched file; neither phase adds `--all`, so cargo formats only that
/// package's own targets instead of treating the flag as "every package in
/// the enclosing workspace" (which is what `--all` means once a manifest
/// path is given, even a member's own manifest). This also holds for the
/// root package of a non-virtual workspace (its own manifest doubles as the
/// workspace root): `--manifest-path` alone still scopes to that package.

module velvet_glove.builtins.tools.CargoFmt

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "cargo-fmt"
  displayName = "cargo fmt"
  executable = "cargo"
  installHint = "install the Rust toolchain with rustfmt available"
  workspaceIndicator = "Cargo.toml"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.rs"; "**/*.rs" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "fmt"
        "--manifest-path"
        new Config.WorkspaceIndicator {}
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "matching-globs"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "fmt"
        "--check"
        "--manifest-path"
        new Config.WorkspaceIndicator {}
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }

  detect = new Config.Detect {
    indicators = new Listing<String> { "**/Cargo.toml" }
    role = "rust-format"
  }
}
