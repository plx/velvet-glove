/// cargo fmt — deterministic workspace formatting with validated completion.
///
/// cargo-fmt and rustfmt both use status 1 for an unformatted check and for
/// parse, configuration, and operational errors. The isolated adapter binds
/// Cargo, cargo-fmt, rustfmt, and rustc to one toolchain closure, validates the
/// complete Cargo workspace before execution, and accepts an issue status only
/// with a complete files-with-diff report and no stderr.
module velvet_glove.builtins.tools.CargoFmt

import "../Config.pkl" as Config

cargoFmtAdapter: String = #"""
  import hashlib
  import json
  import os
  import selectors
  import shutil
  import signal
  import stat
  import subprocess
  import sys
  import tempfile
  import time

  MARKER = "__VELVET_GLOVE_CARGO_FMT_WORKSPACE__"
  OUTPUT_LIMIT = 16 * 1024 * 1024
  FILE_LIMIT = 16 * 1024 * 1024
  WORKSPACE_LIMIT = 128 * 1024 * 1024
  SKIPPED_DIRECTORIES = {".git", ".velvet-glove", "node_modules", "target"}

  def fail(message):
      print(f"velvet-glove-cargo-fmt: {message}", file=sys.stderr)
      raise SystemExit(2)

  if len(sys.argv) < 7 or sys.argv[5:].count(MARKER) != 1:
      fail("invalid adapter arguments")
  requested_cargo = sys.argv[1]
  requested_cargo_fmt = sys.argv[2]
  requested_rustfmt = sys.argv[3]
  phase = sys.argv[4]
  payload = sys.argv[5:]
  marker_index = payload.index(MARKER)
  extra_args = payload[:marker_index]
  indicators = payload[marker_index + 1 :]
  if phase not in ("format", "verify") or len(indicators) != 1:
      fail("invalid phase or workspace selection")
  if requested_cargo_fmt != "cargo-fmt" or requested_rustfmt != "rustfmt":
      fail("cargo-fmt and rustfmt companion names are fixed")
  if extra_args:
      fail("extra arguments are unsupported because they can change workspace scope, configuration, output, or completion semantics")

  requested_lock = os.path.abspath(indicators[0])
  try:
      lock_info = os.lstat(requested_lock)
      if (
          os.path.islink(requested_lock)
          or not stat.S_ISREG(lock_info.st_mode)
          or lock_info.st_nlink != 1
      ):
          fail(f"workspace lock is not a unique regular file: {requested_lock}")
      lock_path = os.path.realpath(requested_lock)
      if lock_path != requested_lock or os.path.basename(lock_path) != "Cargo.lock":
          fail(f"workspace lock path is not canonical: {requested_lock}")
      workspace = os.path.dirname(lock_path)
      manifest = os.path.join(workspace, "Cargo.toml")
      manifest_info = os.lstat(manifest)
      if (
          os.path.islink(manifest)
          or not stat.S_ISREG(manifest_info.st_mode)
          or manifest_info.st_nlink != 1
          or os.path.realpath(manifest) != manifest
      ):
          fail(f"workspace manifest is not a unique canonical regular file: {manifest}")
  except OSError as error:
      fail(f"cannot inspect workspace lock and manifest: {error}")

  def file_snapshot(path):
      initial = os.lstat(path)
      if stat.S_ISLNK(initial.st_mode) or not stat.S_ISREG(initial.st_mode) or initial.st_nlink != 1:
          raise ValueError(f"path is not a unique regular file: {path}")
      descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
      with os.fdopen(descriptor, "rb", closefd=True) as source:
          opened = os.fstat(source.fileno())
          if (
              not stat.S_ISREG(opened.st_mode)
              or opened.st_nlink != 1
              or opened.st_dev != initial.st_dev
              or opened.st_ino != initial.st_ino
          ):
              raise ValueError(f"path changed while it was opened: {path}")
          content = source.read(FILE_LIMIT + 1)
          final = os.fstat(source.fileno())
      if len(content) > FILE_LIMIT:
          raise ValueError(f"path exceeds the 16 MiB validation limit: {path}")
      stable = ("st_dev", "st_ino", "st_mode", "st_nlink", "st_size", "st_mtime_ns")
      if any(getattr(opened, field) != getattr(final, field) for field in stable):
          raise ValueError(f"path changed while it was read: {path}")
      return {
          "content": content,
          "device": final.st_dev,
          "inode": final.st_ino,
          "mode": stat.S_IMODE(final.st_mode),
          "mtime": final.st_mtime_ns,
          "sha256": hashlib.sha256(content).hexdigest(),
          "size": final.st_size,
      }

  def directory_snapshot(path):
      initial = os.lstat(path)
      if stat.S_ISLNK(initial.st_mode) or not stat.S_ISDIR(initial.st_mode):
          raise ValueError(f"path is not a real directory: {path}")
      descriptor = os.open(
          path,
          os.O_RDONLY
          | getattr(os, "O_DIRECTORY", 0)
          | getattr(os, "O_NOFOLLOW", 0),
      )
      try:
          opened = os.fstat(descriptor)
          if (
              not stat.S_ISDIR(opened.st_mode)
              or opened.st_dev != initial.st_dev
              or opened.st_ino != initial.st_ino
          ):
              raise ValueError(f"directory changed while it was opened: {path}")
          return {
              "device": opened.st_dev,
              "inode": opened.st_ino,
              "mode": stat.S_IMODE(opened.st_mode),
          }
      finally:
          os.close(descriptor)

  def scan_workspace(selected_workspace=workspace, require_sources=True):
      snapshots = {}
      directories = {}
      sources = {}
      manifests = set()
      configs = set()
      total = 0

      def walk_error(error):
          raise ValueError(f"cannot walk workspace: {error}")

      for directory, child_directories, names in os.walk(
          selected_workspace, followlinks=False, onerror=walk_error
      ):
          directory_relative = os.path.relpath(directory, selected_workspace).replace(os.sep, "/")
          if len(directories) >= 8192:
              raise ValueError("workspace contains more than 8192 validated directories")
          directories[directory_relative] = directory_snapshot(directory)
          retained = []
          for name in child_directories:
              path = os.path.join(directory, name)
              if name in SKIPPED_DIRECTORIES:
                  continue
              if os.path.islink(path):
                  raise ValueError(f"workspace contains a symlink directory: {path}")
              retained.append(name)
          child_directories[:] = retained
          for name in names:
              path = os.path.join(directory, name)
              relative = os.path.relpath(path, selected_workspace).replace(os.sep, "/")
              snapshot = file_snapshot(path)
              total += snapshot["size"]
              if len(snapshots) >= 8192:
                  raise ValueError("workspace contains more than 8192 validated files")
              if total > WORKSPACE_LIMIT:
                  raise ValueError("workspace validated files exceed the 128 MiB aggregate limit")
              snapshots[relative] = snapshot
              if name.endswith(".rs"):
                  sources[relative] = snapshot
              if name == "Cargo.toml":
                  manifests.add(relative)
              if name in ("rustfmt.toml", ".rustfmt.toml"):
                  configs.add(relative)
      if require_sources and not sources:
          raise ValueError("workspace contains no physical Rust source files")
      return snapshots, sources, manifests, configs, directories

  try:
      (
          baseline,
          source_snapshots,
          physical_manifests,
          rustfmt_configs,
          baseline_directories,
      ) = scan_workspace()
      if "Cargo.toml" not in physical_manifests:
          raise ValueError("workspace root Cargo.toml is absent from the validated tree")
      lock_relative = "Cargo.lock"
      if lock_relative not in baseline:
          raise ValueError(f"workspace lock is unavailable: {lock_path}")
      root_configs = rustfmt_configs.intersection({"rustfmt.toml", ".rustfmt.toml"})
      if len(root_configs) > 1:
          raise ValueError("workspace contains both rustfmt.toml and .rustfmt.toml")
      if rustfmt_configs != root_configs:
          nested = ", ".join(sorted(rustfmt_configs - root_configs))
          raise ValueError(f"nested rustfmt configuration is unsupported: {nested}")
  except (OSError, ValueError) as error:
      fail(str(error))

  def resolve_program(name):
      resolved = shutil.which(name)
      if resolved is None:
          fail(f"cannot resolve required executable {name!r}")
      resolved = os.path.abspath(resolved)
      canonical = os.path.realpath(resolved)
      try:
          info = os.stat(canonical)
      except OSError as error:
          fail(f"cannot inspect required executable {resolved}: {error}")
      if not stat.S_ISREG(info.st_mode) or not os.access(resolved, os.X_OK):
          fail(f"required executable is not a regular executable file: {resolved}")
      return resolved

  cargo = resolve_program(requested_cargo)
  cargo_fmt = resolve_program(requested_cargo_fmt)
  rustfmt = resolve_program(requested_rustfmt)
  rustc = resolve_program("rustc")
  launcher_directory = os.path.dirname(cargo)
  if any(os.path.dirname(program) != launcher_directory for program in (cargo_fmt, rustfmt)):
      fail("cargo, cargo-fmt, and rustfmt must resolve from one launcher directory")
  companion_directory = os.path.dirname(rustc)
  for companion in ("cargo", "cargo-fmt", "rustfmt"):
      path = os.path.join(companion_directory, companion)
      if not os.path.isfile(path) or not os.access(path, os.X_OK):
          fail(f"the paired {companion} executable is unavailable beside rustc")

  temporary = os.environ.get("TMPDIR", "")
  if not os.path.isabs(temporary):
      fail("TMPDIR must be an absolute path")
  temporary = os.path.realpath(temporary)
  if not os.path.isdir(temporary):
      fail("TMPDIR must identify an existing directory")

  def cargo_config_candidates(start):
      candidates = []
      directory = start
      while True:
          candidates.extend(
              (os.path.join(directory, ".cargo", "config"), os.path.join(directory, ".cargo", "config.toml"))
          )
          parent = os.path.dirname(directory)
          if parent == directory:
              break
          directory = parent
      return candidates

  inherited_cargo_home = os.environ.get("CARGO_HOME")
  if inherited_cargo_home is None:
      inherited_home = os.environ.get("HOME", "")
      if os.path.isabs(inherited_home):
          inherited_cargo_home = os.path.join(inherited_home, ".cargo")
  if inherited_cargo_home is not None:
      if not os.path.isabs(inherited_cargo_home):
          fail("CARGO_HOME must be an absolute path when configured")
      inherited_cargo_home = os.path.realpath(inherited_cargo_home)
      if os.path.exists(inherited_cargo_home) and not os.path.isdir(inherited_cargo_home):
          fail("CARGO_HOME must identify a directory")
      for config_name in ("config", "config.toml"):
          config_path = os.path.join(inherited_cargo_home, config_name)
          if os.path.lexists(config_path):
              fail(f"Cargo home configuration is unsupported: {config_path}")
  for config_path in cargo_config_candidates(temporary):
      if os.path.lexists(config_path):
          fail(f"Cargo invocation-path configuration is unsupported: {config_path}")

  process = None
  pending_signal = None
  reported_signal = None
  cleaning = True
  previous_handlers = {}
  handled_signals = (signal.SIGHUP, signal.SIGINT, signal.SIGTERM)

  class AdapterSignal(BaseException):
      def __init__(self, signum):
          super().__init__(f"received signal {signum}")
          self.signum = signum

  def signal_group(signum):
      if process is None:
          return
      try:
          os.killpg(process.pid, signum)
      except (OSError, ValueError):
          pass

  def process_group_exists():
      if process is None:
          return False
      try:
          os.killpg(process.pid, 0)
          return True
      except ProcessLookupError:
          return False
      except PermissionError:
          return True

  def sweep_process_group():
      if not process_group_exists():
          return False
      signal_group(signal.SIGKILL)
      deadline = time.monotonic() + 1
      while process_group_exists() and time.monotonic() < deadline:
          time.sleep(0.01)
      if process_group_exists():
          raise ValueError("cannot reap same-group descendants after child exit")
      return True

  def stop_child(initial_signal=None):
      global process
      global cleaning
      child = process
      if child is None:
          return
      cleaning = True
      try:
          try:
              running = child.poll() is None
          except (OSError, ValueError):
              running = True
          if running:
              signal_group(initial_signal if initial_signal is not None else signal.SIGTERM)
              try:
                  child.wait(timeout=1)
              except (OSError, ValueError, subprocess.TimeoutExpired):
                  pass
          signal_group(signal.SIGKILL)
          try:
              child.wait(timeout=1)
          except (OSError, ValueError, subprocess.TimeoutExpired):
              pass
      finally:
          process = None
          cleaning = False

  def forward_signal(signum, _frame):
      global pending_signal
      pending_signal = signum
      if process is not None and not cleaning:
          signal_group(signum)
          raise AdapterSignal(signum)

  def append_adapter_error(primary, secondary):
      if primary is None:
          return secondary
      return ValueError(f"{primary}; {secondary}")

  def apply_pending_signal(primary):
      global reported_signal
      if pending_signal is None or pending_signal == reported_signal:
          return primary
      reported_signal = pending_signal
      return append_adapter_error(primary, AdapterSignal(pending_signal))

  def drain_blocked_signals(primary):
      global pending_signal
      drained = False
      while True:
          queued = sorted(set(signal.sigpending()).intersection(handled_signals), key=int)
          if not queued:
              return primary, drained
          pending_signal = int(signal.sigwait({queued[0]}))
          primary = apply_pending_signal(primary)
          drained = True

  def sanitize_private_error(error, owned_root):
      message = str(error)
      if owned_root is not None:
          message = message.replace(owned_root, "<cargo-fmt-private>")
      elif isinstance(error, OSError) and error.filename is not None:
          filename = os.fsdecode(error.filename)
          candidate = os.path.abspath(filename)
          if (
              os.path.realpath(os.path.dirname(candidate)) == temporary
              and os.path.basename(candidate).startswith("velvet-glove-cargo-fmt-")
          ):
              message = message.replace(filename, "<cargo-fmt-private>")
      return message

  for signum in handled_signals:
      previous_handlers[signum] = signal.signal(signum, forward_signal)

  private_root = None
  initialization_error = None
  try:
      private_root = tempfile.mkdtemp(prefix="velvet-glove-cargo-fmt-", dir=temporary)
      invocation_dir = os.path.join(private_root, "invocation")
      os.mkdir(invocation_dir, mode=0o700)
      if root_configs:
          config_directory = workspace
      else:
          config_directory = invocation_dir
          config_path = os.path.join(config_directory, "rustfmt.toml")
          descriptor = os.open(config_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
          os.close(descriptor)
      environment = os.environ.copy()
      for name in tuple(environment):
          if name.startswith("CARGO_") or name.startswith("RUST"):
              environment.pop(name, None)
          elif (
              name.startswith("SCCACHE_")
              or name.startswith("CCACHE_")
              or name.startswith("DYLD_")
              or name.startswith("LD_")
              or name in ("DEBUG", "SYSROOT")
          ):
              environment.pop(name, None)
      if inherited_cargo_home is not None and os.path.isdir(inherited_cargo_home):
          environment["CARGO_HOME"] = inherited_cargo_home
      else:
          private_cargo_home = os.path.join(private_root, "cargo-home")
          os.mkdir(private_cargo_home, mode=0o700)
          environment["CARGO_HOME"] = private_cargo_home
      environment.update(
          {
              "CARGO": cargo,
              "CARGO_BUILD_JOBS": "1",
              "CARGO_INCREMENTAL": "0",
              "CARGO_NET_OFFLINE": "true",
              "CARGO_TARGET_DIR": private_root,
              "CARGO_TERM_COLOR": "never",
              "NO_COLOR": "1",
              "FORCE_COLOR": "0",
              "CLICOLOR": "0",
              "LANG": "C",
              "LC_ALL": "C",
              "PATH": os.pathsep.join([launcher_directory, companion_directory, "/usr/bin", "/bin"]),
              "RUST_BACKTRACE": "0",
              "RUST_LIB_BACKTRACE": "0",
              "RUSTC": rustc,
              "RUSTFMT": rustfmt,
              "TERM": "dumb",
              "TZ": "UTC",
          }
      )
      toolchain_library = os.path.realpath(os.path.join(companion_directory, "..", "lib"))
      if sys.platform == "darwin" and os.path.isdir(toolchain_library):
          environment["DYLD_LIBRARY_PATH"] = toolchain_library
  except BaseException as error:
      initialization_error = ValueError(
          "cannot initialize controlled Cargo Fmt execution: "
          + sanitize_private_error(error, private_root)
      )

  if initialization_error is not None or pending_signal is not None:
      initialization_mask = None
      try:
          if private_root is not None:
              try:
                  shutil.rmtree(private_root)
              except OSError as cleanup_error:
                  initialization_error = append_adapter_error(
                      initialization_error,
                      ValueError(f"cannot remove controlled Cargo Fmt directory: {cleanup_error}"),
                  )
          try:
              initialization_mask = signal.pthread_sigmask(
                  signal.SIG_BLOCK, handled_signals
              )
          except (OSError, ValueError) as mask_error:
              initialization_error = append_adapter_error(
                  initialization_error,
                  ValueError(f"cannot block initialization cleanup signals: {mask_error}"),
              )
          initialization_error = apply_pending_signal(initialization_error)
          if initialization_mask is not None:
              initialization_error, _ = drain_blocked_signals(initialization_error)
      finally:
          for signum, handler in previous_handlers.items():
              try:
                  signal.signal(signum, handler)
              except (OSError, ValueError):
                  pass
          cleaning = False
      fail(sanitize_private_error(initialization_error, private_root))
  cleaning = False

  coverage_workspace = os.path.join(private_root, "coverage-workspace")
  coverage_manifest = os.path.join(coverage_workspace, "Cargo.toml")
  coverage_config_directory = coverage_workspace if root_configs else config_directory

  def metadata_arguments(selected_manifest):
      return [
          cargo,
          "metadata",
          "--format-version=1",
          "--no-deps",
          "--manifest-path",
          selected_manifest,
          "--locked",
          "--offline",
          "--quiet",
      ]

  def format_arguments(selected_manifest, selected_config, check):
      arguments = [cargo_fmt, "fmt", "--all", "--manifest-path", selected_manifest]
      if check:
          arguments.append("--check")
      arguments.extend(
          ["--", "--config-path", selected_config, "--color", "never", "--files-with-diff"]
      )
      return arguments

  metadata_args = metadata_arguments(manifest)
  coverage_metadata_args = metadata_arguments(coverage_manifest)
  coverage_args = format_arguments(coverage_manifest, coverage_config_directory, True)
  format_args = format_arguments(manifest, config_directory, phase == "verify")

  def run_child(arguments):
      global process
      global cleaning
      stdout_chunks = []
      stderr_chunks = []
      total = 0
      process = subprocess.Popen(
          arguments,
          stdin=subprocess.DEVNULL,
          stdout=subprocess.PIPE,
          stderr=subprocess.PIPE,
          cwd=invocation_dir,
          env=environment,
          start_new_session=True,
      )
      selector = selectors.DefaultSelector()
      for stream, chunks in ((process.stdout, stdout_chunks), (process.stderr, stderr_chunks)):
          if stream is None:
              raise OSError("failed to capture Cargo Fmt output")
          os.set_blocking(stream.fileno(), False)
          selector.register(stream, selectors.EVENT_READ, chunks)
      while selector.get_map():
          if pending_signal is not None:
              raise AdapterSignal(pending_signal)
          for key, _ in selector.select(timeout=0.1):
              chunk = os.read(key.fileobj.fileno(), 65536)
              if chunk:
                  total += len(chunk)
                  if total > OUTPUT_LIMIT:
                      raise BufferError(f"combined output exceeded {OUTPUT_LIMIT} bytes")
                  key.data.append(chunk)
              else:
                  selector.unregister(key.fileobj)
                  key.fileobj.close()
      status = process.wait()
      cleaning = True
      try:
          left_descendants = sweep_process_group()
      finally:
          cleaning = False
      if left_descendants:
          raise ValueError("child left same-group descendants after leader exit")
      process = None
      if pending_signal is not None:
          raise AdapterSignal(pending_signal)
      return status, b"".join(stdout_chunks), b"".join(stderr_chunks)

  def assert_snapshot_unchanged(
      before, before_directories, after, after_directories, context
  ):
      if set(before) != set(after):
          raise ValueError(f"{context} changed workspace paths")
      for relative, snapshot in before.items():
          current = after[relative]
          for key in ("device", "inode", "mode", "mtime", "sha256", "size"):
              if current[key] != snapshot[key]:
                  raise ValueError(f"{context} changed {relative}")
      if set(before_directories) != set(after_directories):
          raise ValueError(f"{context} changed workspace directory topology")
      for relative, snapshot in before_directories.items():
          if after_directories[relative]["mode"] != snapshot["mode"]:
              raise ValueError(f"{context} changed directory {relative}")

  def parse_metadata(raw, selected_workspace, selected_manifests, selected_sources):
      try:
          metadata = json.loads(raw.decode("utf-8"))
      except (UnicodeError, json.JSONDecodeError) as error:
          raise ValueError(f"Cargo metadata is not one UTF-8 JSON object: {error}")
      if not isinstance(metadata, dict) or metadata.get("version") != 1:
          raise ValueError("Cargo metadata does not use the locked version-1 schema")
      metadata_root = metadata.get("workspace_root")
      if not isinstance(metadata_root, str) or os.path.realpath(metadata_root) != selected_workspace:
          raise ValueError("Cargo workspace root differs from the selected Cargo.toml directory")
      target_directory = metadata.get("target_directory")
      if not isinstance(target_directory, str) or os.path.realpath(target_directory) != private_root:
          raise ValueError("Cargo metadata ignored the controlled target directory")
      build_directory = metadata.get("build_directory")
      if not isinstance(build_directory, str) or os.path.realpath(build_directory) != private_root:
          raise ValueError("Cargo metadata ignored the controlled build directory")
      members = metadata.get("workspace_members")
      packages = metadata.get("packages")
      if not isinstance(members, list) or not members or len(set(members)) != len(members):
          raise ValueError("Cargo metadata has no unique workspace-member set")
      if not isinstance(packages, list) or len(packages) != len(members):
          raise ValueError("Cargo metadata must contain exactly the workspace packages")
      member_ids = set(members)
      package_ids = {package.get("id") for package in packages if isinstance(package, dict)}
      if package_ids != member_ids:
          raise ValueError("Cargo package records differ from workspace members")
      member_manifests = set()
      target_sources = set()
      for package in packages:
          package_manifest = package.get("manifest_path")
          if not isinstance(package_manifest, str):
              raise ValueError("Cargo package manifest path is missing")
          package_manifest = os.path.abspath(package_manifest)
          if os.path.realpath(package_manifest) != package_manifest:
              raise ValueError("Cargo package manifest path is not canonical")
          try:
              inside = os.path.commonpath((selected_workspace, package_manifest)) == selected_workspace
          except ValueError:
              inside = False
          relative_manifest = os.path.relpath(package_manifest, selected_workspace).replace(os.sep, "/")
          if not inside or relative_manifest not in selected_manifests:
              raise ValueError(f"Cargo package manifest escapes the validated workspace: {package_manifest}")
          member_manifests.add(relative_manifest)
          dependencies = package.get("dependencies")
          if not isinstance(dependencies, list):
              raise ValueError("Cargo package dependencies are missing")
          for dependency in dependencies:
              if not isinstance(dependency, dict):
                  raise ValueError("Cargo dependency record is malformed")
              dependency_path = dependency.get("path")
              if dependency_path is None:
                  continue
              if not isinstance(dependency_path, str):
                  raise ValueError("Cargo path dependency is malformed")
              dependency_manifest = os.path.join(os.path.realpath(dependency_path), "Cargo.toml")
              try:
                  dependency_inside = (
                      os.path.commonpath((selected_workspace, dependency_manifest)) == selected_workspace
                  )
              except ValueError:
                  dependency_inside = False
              dependency_relative = os.path.relpath(dependency_manifest, selected_workspace).replace(os.sep, "/")
              if not dependency_inside or dependency_relative not in selected_manifests:
                  raise ValueError(f"Cargo path dependency escapes the workspace: {dependency_path}")
          targets = package.get("targets")
          if not isinstance(targets, list) or not targets:
              raise ValueError("Cargo workspace package has no targets")
          for target in targets:
              source = target.get("src_path") if isinstance(target, dict) else None
              if not isinstance(source, str):
                  raise ValueError("Cargo target source path is missing")
              source = os.path.abspath(source)
              if os.path.realpath(source) != source:
                  raise ValueError(f"Cargo target source is not canonical: {source}")
              relative = os.path.relpath(source, selected_workspace).replace(os.sep, "/")
              if relative not in selected_sources:
                  raise ValueError(f"Cargo target source escapes physical Rust scope: {source}")
              target_sources.add(relative)
      allowed_manifests = member_manifests.union({"Cargo.toml"})
      if selected_manifests != allowed_manifests:
          unsupported = ", ".join(sorted(selected_manifests - allowed_manifests))
          raise ValueError(f"non-member Cargo manifests are unsupported: {unsupported}")
      for package in packages:
          for dependency in package["dependencies"]:
              dependency_path = dependency.get("path")
              if dependency_path is None:
                  continue
              dependency_manifest = os.path.join(os.path.realpath(dependency_path), "Cargo.toml")
              dependency_relative = os.path.relpath(dependency_manifest, selected_workspace).replace(os.sep, "/")
              if dependency_relative not in member_manifests:
                  raise ValueError(f"non-member Cargo path dependency is unsupported: {dependency_path}")
      return len(packages), sorted(target_sources)

  def parse_report(raw, selected_workspace, selected_sources):
      try:
          text = raw.decode("utf-8")
      except UnicodeError as error:
          raise ValueError(f"rustfmt files-with-diff output is not UTF-8: {error}")
      reported = []
      for line in text.splitlines():
          if not line or line != line.strip():
              raise ValueError("rustfmt files-with-diff output has a non-canonical line")
          path = line if os.path.isabs(line) else os.path.join(invocation_dir, line)
          path = os.path.abspath(path)
          if os.path.realpath(path) != path:
              raise ValueError(f"rustfmt reported a non-canonical path: {line}")
          relative = os.path.relpath(path, selected_workspace).replace(os.sep, "/")
          if relative not in selected_sources:
              raise ValueError(f"rustfmt reported a path outside physical Rust scope: {line}")
          if relative in reported:
              raise ValueError(f"rustfmt reported a duplicate path: {relative}")
          reported.append(relative)
      return sorted(reported)

  def sanitize_private_output(output):
      return output.replace(os.fsencode(private_root), b"<cargo-fmt-private>")

  def workspace_diff(before, before_directories, after, after_directories):
      before_paths = set(before)
      after_paths = set(after)
      added = sorted(after_paths - before_paths)
      removed = sorted(before_paths - after_paths)
      changed = sorted(
          relative
          for relative in before_paths.intersection(after_paths)
          if before[relative]["content"] != after[relative]["content"]
      )
      touched = sorted(
          relative
          for relative in before_paths.intersection(after_paths)
          if before[relative]["mode"] != after[relative]["mode"]
          or (
              relative not in changed
              and any(
                  before[relative][key] != after[relative][key]
                  for key in ("device", "inode", "mtime", "size", "sha256")
              )
          )
      )
      before_directory_paths = set(before_directories)
      after_directory_paths = set(after_directories)
      added_directories = sorted(after_directory_paths - before_directory_paths)
      removed_directories = sorted(before_directory_paths - after_directory_paths)
      touched_directories = sorted(
          relative
          for relative in before_directory_paths.intersection(after_directory_paths)
          if before_directories[relative]["mode"] != after_directories[relative]["mode"]
      )
      return (
          added,
          removed,
          changed,
          touched,
          added_directories,
          removed_directories,
          touched_directories,
      )

  def atomic_write(path, content, mode):
      descriptor, temporary_path = tempfile.mkstemp(prefix=".velvet-glove-cargo-fmt-", dir=os.path.dirname(path))
      try:
          os.fchmod(descriptor, mode)
          with os.fdopen(descriptor, "wb", closefd=True) as output:
              descriptor = -1
              output.write(content)
              output.flush()
              os.fsync(output.fileno())
          os.replace(temporary_path, path)
      except BaseException:
          if descriptor >= 0:
              os.close(descriptor)
          try:
              os.unlink(temporary_path)
          except OSError:
              pass
          raise

  def set_directory_mode(path, mode, expected=None):
      descriptor = os.open(
          path,
          os.O_RDONLY
          | getattr(os, "O_DIRECTORY", 0)
          | getattr(os, "O_NOFOLLOW", 0),
      )
      try:
          opened = os.fstat(descriptor)
          if not stat.S_ISDIR(opened.st_mode):
              raise ValueError(f"path is not a real directory: {path}")
          if expected is not None and (
              opened.st_dev != expected["device"] or opened.st_ino != expected["inode"]
          ):
              raise ValueError(f"directory changed before restoring its mode: {path}")
          os.fchmod(descriptor, mode)
          restored = os.fstat(descriptor)
          if (
              restored.st_dev != opened.st_dev
              or restored.st_ino != opened.st_ino
              or stat.S_IMODE(restored.st_mode) != mode
          ):
              raise ValueError(f"directory changed while restoring its mode: {path}")
      finally:
          os.close(descriptor)

  def create_coverage_workspace():
      os.mkdir(coverage_workspace, mode=0o700)
      for relative in sorted(
          baseline_directories,
          key=lambda item: (item.count("/"), item),
      ):
          if relative == ".":
              continue
          destination = os.path.join(coverage_workspace, relative.replace("/", os.sep))
          os.mkdir(destination, mode=0o700)
      probe = b"\nconst _: ()=();\n"
      for relative, snapshot in sorted(baseline.items()):
          destination = os.path.join(coverage_workspace, relative.replace("/", os.sep))
          content = snapshot["content"]
          if relative in source_snapshots:
              content += probe
          descriptor = os.open(
              destination,
              os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
              snapshot["mode"],
          )
          try:
              os.fchmod(descriptor, snapshot["mode"])
              with os.fdopen(descriptor, "wb", closefd=True) as output:
                  descriptor = -1
                  output.write(content)
                  output.flush()
                  os.fsync(output.fileno())
          finally:
              if descriptor >= 0:
                  os.close(descriptor)
      for relative in sorted(
          baseline_directories,
          key=lambda item: (item.count("/"), item),
          reverse=True,
      ):
          destination = (
              coverage_workspace
              if relative == "."
              else os.path.join(coverage_workspace, relative.replace("/", os.sep))
          )
          set_directory_mode(destination, baseline_directories[relative]["mode"])

  def restore_workspace(before, before_directories):
      errors = []

      def directory_path(relative):
          return (
              workspace
              if relative == "."
              else os.path.join(workspace, relative.replace("/", os.sep))
          )

      def make_directory_traversable(path):
          initial = os.lstat(path)
          if stat.S_ISLNK(initial.st_mode) or not stat.S_ISDIR(initial.st_mode):
              raise ValueError(f"path is not a real directory: {path}")
          current_mode = stat.S_IMODE(initial.st_mode)
          temporary_mode = current_mode | stat.S_IRUSR | stat.S_IWUSR | stat.S_IXUSR
          if temporary_mode != current_mode:
              os.chmod(path, temporary_mode, follow_symlinks=False)
              restored = os.lstat(path)
              if (
                  stat.S_ISLNK(restored.st_mode)
                  or not stat.S_ISDIR(restored.st_mode)
                  or restored.st_dev != initial.st_dev
                  or restored.st_ino != initial.st_ino
                  or stat.S_IMODE(restored.st_mode) != temporary_mode
              ):
                  raise ValueError(f"directory changed while making it traversable: {path}")

      if not os.path.lexists(workspace):
          try:
              os.mkdir(workspace, mode=0o700)
          except OSError as error:
              errors.append(f"recreate workspace root: {error}")
      for relative in sorted(
          before_directories,
          key=lambda item: (item.count("/"), item),
      ):
          path = directory_path(relative)
          if not os.path.lexists(path):
              continue
          try:
              make_directory_traversable(path)
          except (OSError, ValueError) as error:
              errors.append(f"make {relative} traversable: {error}")

      def restore_walk_error(error):
          errors.append(f"walk workspace for rollback: {error}")

      for directory, child_directories, _ in os.walk(
          workspace, followlinks=False, onerror=restore_walk_error
      ):
          retained = []
          for name in child_directories:
              if name in SKIPPED_DIRECTORIES:
                  continue
              path = os.path.join(directory, name)
              if not os.path.islink(path):
                  try:
                      make_directory_traversable(path)
                  except (OSError, ValueError) as error:
                      relative = os.path.relpath(path, workspace).replace(os.sep, "/")
                      errors.append(f"make {relative} traversable: {error}")
              retained.append(name)
          child_directories[:] = retained

      try:
          current, _, _, _, current_directories = scan_workspace(require_sources=False)
      except (OSError, ValueError) as error:
          raise ValueError("rollback failed: " + "; ".join(errors + [str(error)]))
      for relative in sorted(set(current) - set(before), reverse=True):
          path = os.path.join(workspace, relative.replace("/", os.sep))
          try:
              os.unlink(path)
          except OSError as error:
              errors.append(f"remove {relative}: {error}")
      for relative in sorted(
          set(current_directories) - set(before_directories),
          key=lambda item: (item.count("/"), item),
          reverse=True,
      ):
          path = directory_path(relative)
          try:
              os.rmdir(path)
          except OSError as error:
              errors.append(f"remove directory {relative}: {error}")
      for relative in sorted(
          set(before_directories) - set(current_directories),
          key=lambda item: (item.count("/"), item),
      ):
          path = directory_path(relative)
          try:
              os.mkdir(path, mode=0o700)
          except OSError as error:
              errors.append(f"recreate directory {relative}: {error}")
      for relative, snapshot in before.items():
          path = os.path.join(workspace, relative.replace("/", os.sep))
          try:
              current_snapshot = file_snapshot(path) if os.path.exists(path) else None
              if (
                  current_snapshot is None
                  or current_snapshot["content"] != snapshot["content"]
                  or current_snapshot["mode"] != snapshot["mode"]
              ):
                  os.makedirs(os.path.dirname(path), exist_ok=True)
                  atomic_write(path, snapshot["content"], snapshot["mode"])
                  current_snapshot = file_snapshot(path)
              if current_snapshot["mtime"] != snapshot["mtime"]:
                  descriptor = os.open(path, os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0))
                  try:
                      opened = os.fstat(descriptor)
                      if (
                          not stat.S_ISREG(opened.st_mode)
                          or opened.st_nlink != 1
                          or opened.st_dev != current_snapshot["device"]
                          or opened.st_ino != current_snapshot["inode"]
                      ):
                          raise ValueError(f"path changed before restoring its mtime: {path}")
                      os.utime(
                          descriptor,
                          ns=(opened.st_atime_ns, snapshot["mtime"]),
                      )
                      restored = os.fstat(descriptor)
                      if (
                          restored.st_dev != opened.st_dev
                          or restored.st_ino != opened.st_ino
                          or restored.st_mtime_ns != snapshot["mtime"]
                      ):
                          raise ValueError(f"path changed while restoring its mtime: {path}")
                  finally:
                      os.close(descriptor)
          except (OSError, ValueError) as error:
              errors.append(f"restore {relative}: {error}")
      for relative in sorted(
          before_directories,
          key=lambda item: (item.count("/"), item),
          reverse=True,
      ):
          path = directory_path(relative)
          try:
              current_snapshot = directory_snapshot(path)
              if current_snapshot["mode"] != before_directories[relative]["mode"]:
                  set_directory_mode(
                      path,
                      before_directories[relative]["mode"],
                      current_snapshot,
                  )
          except (OSError, ValueError) as error:
              errors.append(f"restore directory {relative}: {error}")
      try:
          restored, _, _, _, restored_directories = scan_workspace()
          if set(restored) != set(before):
              errors.append("restored workspace paths differ from the baseline")
          else:
              for relative, snapshot in before.items():
                  current_snapshot = restored[relative]
                  for key in ("content", "mode", "mtime"):
                      if current_snapshot[key] != snapshot[key]:
                          errors.append(f"restored {relative} {key} differs from the baseline")
          if set(restored_directories) != set(before_directories):
              errors.append("restored workspace directory topology differs from the baseline")
          else:
              for relative, snapshot in before_directories.items():
                  if restored_directories[relative]["mode"] != snapshot["mode"]:
                      errors.append(
                          f"restored directory {relative} mode differs from the baseline"
                      )
      except (OSError, ValueError) as error:
          errors.append(f"verify restored workspace: {error}")
      if errors:
          raise ValueError("rollback failed: " + "; ".join(errors))

  adapter_error = None
  raw_stdout = b""
  raw_stderr = b""
  summary = None
  outer_status = 2
  rollback_eligible = False
  try:
      raw_stdout = b""
      raw_stderr = b""
      metadata_status, metadata_stdout, metadata_stderr = run_child(metadata_args)
      raw_stdout = metadata_stdout
      raw_stderr = metadata_stderr
      if metadata_status != 0 or metadata_stderr:
          raise ValueError(f"Cargo metadata exited {metadata_status} without clean completion")
      packages, target_sources = parse_metadata(
          metadata_stdout, workspace, physical_manifests, source_snapshots
      )
      after_metadata, _, _, _, after_metadata_directories = scan_workspace()
      assert_snapshot_unchanged(
          baseline,
          baseline_directories,
          after_metadata,
          after_metadata_directories,
          "Cargo metadata",
      )

      # Prove that cargo-fmt actually reaches every physical Rust source. A
      # private copy receives one parseable formatting defect per source; the
      # check must report the complete physical set before the real workspace
      # is trusted. This catches dormant .rs files and Cargo target-selection
      # changes without transiently modifying the selected workspace.
      create_coverage_workspace()
      (
          coverage_baseline,
          coverage_sources,
          coverage_manifests,
          coverage_configs,
          coverage_directories,
      ) = scan_workspace(coverage_workspace)
      if set(coverage_sources) != set(source_snapshots):
          raise ValueError("coverage workspace Rust sources differ from the validated workspace")
      if coverage_manifests != physical_manifests or coverage_configs != rustfmt_configs:
          raise ValueError("coverage workspace Cargo or rustfmt configuration differs from the validated workspace")
      if (
          set(coverage_directories) != set(baseline_directories)
          or any(
              coverage_directories[relative]["mode"]
              != baseline_directories[relative]["mode"]
              for relative in baseline_directories
          )
      ):
          raise ValueError("coverage workspace directory topology or modes differ from the validated workspace")

      raw_stdout = b""
      raw_stderr = b""
      coverage_metadata_status, coverage_metadata_stdout, coverage_metadata_stderr = run_child(
          coverage_metadata_args
      )
      raw_stdout = sanitize_private_output(coverage_metadata_stdout)
      raw_stderr = sanitize_private_output(coverage_metadata_stderr)
      if coverage_metadata_status != 0 or coverage_metadata_stderr:
          raise ValueError(
              f"coverage Cargo metadata exited {coverage_metadata_status} without clean completion"
          )
      coverage_packages, coverage_target_sources = parse_metadata(
          coverage_metadata_stdout,
          coverage_workspace,
          coverage_manifests,
          coverage_sources,
      )
      if coverage_packages != packages or coverage_target_sources != target_sources:
          raise ValueError("coverage Cargo target selection differs from the validated workspace")
      (
          after_coverage_metadata,
          _,
          _,
          _,
          after_coverage_metadata_directories,
      ) = scan_workspace(coverage_workspace)
      assert_snapshot_unchanged(
          coverage_baseline,
          coverage_directories,
          after_coverage_metadata,
          after_coverage_metadata_directories,
          "coverage Cargo metadata",
      )
      (
          after_coverage_metadata_original,
          _,
          _,
          _,
          after_coverage_metadata_original_directories,
      ) = scan_workspace()
      assert_snapshot_unchanged(
          baseline,
          baseline_directories,
          after_coverage_metadata_original,
          after_coverage_metadata_original_directories,
          "coverage Cargo metadata",
      )

      raw_stdout = b""
      raw_stderr = b""
      coverage_status, coverage_stdout, coverage_stderr = run_child(coverage_args)
      raw_stdout = sanitize_private_output(coverage_stdout)
      raw_stderr = sanitize_private_output(coverage_stderr)
      coverage_report = parse_report(
          coverage_stdout, coverage_workspace, coverage_sources
      )
      if coverage_status != 1 or coverage_stderr:
          raise ValueError(
              f"cargo-fmt coverage check exited {coverage_status} without a clean issue report"
          )
      if coverage_report != sorted(source_snapshots):
          missing = sorted(set(source_snapshots) - set(coverage_report))
          unexpected = sorted(set(coverage_report) - set(source_snapshots))
          raise ValueError(
              "cargo-fmt does not cover the complete physical Rust source set: "
              f"missing={missing}, unexpected={unexpected}"
          )
      after_coverage, _, _, _, after_coverage_directories = scan_workspace(
          coverage_workspace
      )
      assert_snapshot_unchanged(
          coverage_baseline,
          coverage_directories,
          after_coverage,
          after_coverage_directories,
          "cargo-fmt coverage check",
      )
      after_coverage_original, _, _, _, after_coverage_original_directories = scan_workspace()
      assert_snapshot_unchanged(
          baseline,
          baseline_directories,
          after_coverage_original,
          after_coverage_original_directories,
          "cargo-fmt coverage check",
      )

      rollback_eligible = True
      raw_stdout = b""
      raw_stderr = b""
      format_status, format_stdout, format_stderr = run_child(format_args)
      raw_stdout = format_stdout
      raw_stderr = format_stderr
      after_format, _, _, _, after_format_directories = scan_workspace()
      (
          added,
          removed,
          changed,
          touched,
          added_directories,
          removed_directories,
          touched_directories,
      ) = workspace_diff(
          baseline,
          baseline_directories,
          after_format,
          after_format_directories,
      )
      reported = parse_report(format_stdout, workspace, source_snapshots)
      if format_stderr:
          raise ValueError("cargo-fmt wrote stderr, so status cannot be classified as a formatting issue")
      if (
          added
          or removed
          or touched
          or added_directories
          or removed_directories
          or touched_directories
      ):
          raise ValueError(
              f"cargo-fmt changed workspace structure or metadata: added={added}, removed={removed}, touched={touched}, added_directories={added_directories}, removed_directories={removed_directories}, touched_directories={touched_directories}"
          )
      non_sources = sorted(set(changed) - set(source_snapshots))
      if non_sources:
          raise ValueError("cargo-fmt changed non-Rust workspace files: " + ", ".join(non_sources))
      if phase == "verify":
          if changed:
              raise ValueError("cargo-fmt check mode mutated workspace files")
          if format_status == 0:
              if reported:
                  raise ValueError("clean cargo-fmt check reported unformatted files")
              status_name = "clean"
              outer_status = 0
          elif format_status == 1 and reported:
              status_name = "issues"
              outer_status = 1
          else:
              raise ValueError(f"cargo-fmt check exited {format_status} without a complete issue report")
          changed_report = []
      else:
          if format_status != 0:
              raise ValueError(f"cargo-fmt format exited {format_status}")
          if sorted(changed) != reported:
              raise ValueError(
                  f"cargo-fmt changed-file report differs from workspace bytes: report={reported}, changed={changed}"
              )
          status_name = "fixed" if changed else "clean"
          changed_report = changed
          outer_status = 0
      summary = {
          "changed": changed_report,
          "kind": "cargo-fmt",
          "packages": packages,
          "phase": phase,
          "sources": len(source_snapshots),
          "status": status_name,
          "targets": len(target_sources),
          "unformatted": reported if phase == "verify" else [],
      }
  except AdapterSignal as error:
      stop_child(error.signum)
      adapter_error = error
      reported_signal = error.signum
  except BaseException as error:
      stop_child()
      adapter_error = error
  finally:
      cleaning = True
      blocked_mask = None
      try:
          try:
              shutil.rmtree(private_root)
          except OSError as cleanup_error:
              adapter_error = append_adapter_error(
                  adapter_error,
                  ValueError(f"cannot remove controlled Cargo Fmt directory: {cleanup_error}"),
              )
          try:
              blocked_mask = signal.pthread_sigmask(signal.SIG_BLOCK, handled_signals)
          except (OSError, ValueError) as mask_error:
              adapter_error = append_adapter_error(
                  adapter_error, ValueError(f"cannot block cleanup signals: {mask_error}")
              )
          rollback_attempted = False
          while True:
              adapter_error = apply_pending_signal(adapter_error)
              drained = False
              if blocked_mask is not None:
                  adapter_error, drained = drain_blocked_signals(adapter_error)
              if adapter_error is not None and rollback_eligible and not rollback_attempted:
                  rollback_attempted = True
                  try:
                      restore_workspace(baseline, baseline_directories)
                  except BaseException as rollback_error:
                      adapter_error = append_adapter_error(adapter_error, rollback_error)
                  continue
              if not drained:
                  break
          if adapter_error is not None:
              outer_status = 2
      finally:
          try:
              for signum, handler in previous_handlers.items():
                  try:
                      signal.signal(signum, handler)
                  except (OSError, ValueError):
                      pass
          finally:
              cleaning = False

  if adapter_error is not None:
      if raw_stdout:
          sys.stdout.buffer.write(sanitize_private_output(raw_stdout))
      if raw_stderr:
          sys.stderr.buffer.write(sanitize_private_output(raw_stderr))
      fail(sanitize_private_error(adapter_error, private_root))
  sys.stdout.write(json.dumps(summary, sort_keys=True, separators=(",", ":")) + "\n")
  raise SystemExit(outer_status)
  """#

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "cargo-fmt"
  displayName = "cargo fmt"
  executable = "cargo"
  installHint = "install exact Rust/Cargo 1.97.1 with cargo-fmt/rustfmt 1.9.0 and Python 3 isolated-mode support"
  workspaceIndicator = "Cargo.lock"
  phaseInvocation = "workspace"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.rs"; "**/*.rs" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      program = "python"
      argv = new Listing<String | Config.ArgToken> {
        "-I"
        "-c"
        cargoFmtAdapter
        new Config.ToolExecutable {}
        "cargo-fmt"
        "rustfmt"
        "format"
        new Config.ExtraArgs {}
        "__VELVET_GLOVE_CARGO_FMT_WORKSPACE__"
        new Config.WorkspaceIndicator {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
      writes = "workspace"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      program = "python"
      argv = new Listing<String | Config.ArgToken> {
        "-I"
        "-c"
        cargoFmtAdapter
        new Config.ToolExecutable {}
        "cargo-fmt"
        "rustfmt"
        "verify"
        new Config.ExtraArgs {}
        "__VELVET_GLOVE_CARGO_FMT_WORKSPACE__"
        new Config.WorkspaceIndicator {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }
  messages = new Config.Messages {
    issuesAgent =
      "cargo fmt reports validated formatting issues; inspect diagnostics at {{ diagnostics_path }}."
  }
}
