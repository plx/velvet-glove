/// Schema for Velvet Glove's immediate and deferred quality runner.
///
/// Project configs typically `amends` this module. The runner's Pkl driver
/// also embeds it so config files loaded via discovery can resolve `Config`,
/// `Builtins`, and the argv-token classes.

module velvet_glove.PostToolUseConfig

/// Top-level runner settings.
class Settings {
  /// Number of independent tool jobs to run concurrently. 0 (the default)
  /// means auto: the available parallelism, capped at 8. 1 runs serially.
  jobs: UInt?

  /// Stop after an operational failure (missing tool, configured failure code).
  failFast: Boolean?

  /// Continue running later tools after an earlier tool reports issues.
  continueAfterIssues: Boolean?

  /// Global file exclusions applied before per-tool selection. Patterns are
  /// matched against project-relative paths and APPEND to the inherited list,
  /// which starts from the defaults (`**/.git/**`, `**/node_modules/**`,
  /// `**/.venv/**`, `**/__pycache__/**`, `**/target/**`). Set
  /// `merge.resetExclude = true` to replace the list instead.
  exclude: Listing<String>?

  /// How to handle optional common-output intents the harness cannot represent.
  loweringPolicy: ("strict" | "best-effort" | "best-effort-with-warnings")?

  /// Directory for immediate-mode diagnostic files. Relative paths resolve
  /// from the project root. When unset, files go under
  /// `$TMPDIR/velvet-glove/state/post-tool-immediate`, outside the project.
  diagnosticsDirectory: String?

  /// What to do when a configured tool executable is missing.
  missingToolPolicy: ("user-notice" | "hard-failure" | "harness-block")?

  /// Optional stop-time file-activity fallback overrides. Omit to use the
  /// runtime defaults represented by FileActivity.
  fileActivity: FileActivity?

  /// Optional field-preserving overrides for deferred Stop reporting. Rust
  /// supplies the built-in defaults; null nested fields inherit prior layers.
  deferredReporting: DeferredReporting?

  /// Wall-clock limit for each external command, in seconds (default 120).
  /// A command that exceeds it is killed and reported as an operational
  /// failure. 0 disables the limit. `ToolSpec.timeoutSeconds` overrides it.
  commandTimeoutSeconds: UInt?

  /// Project-local executable directories searched before `PATH`, each from
  /// the job's workspace up to the project root (nearest first). Default:
  /// `node_modules/.bin`, then `.venv/bin`. Replaces the inherited list.
  localBinDirs: Listing<String>?
}

class TemplatePair {
  user: String?
  agent: String?
}

class FileGroup {
  id: String
  displayName: String
  include: Listing<String>
}

/// A patch over the built-in deferred reporting contract. Empty strings
/// intentionally suppress that audience. Set merge.resetDeferredReporting to
/// restore all defaults before applying this patch.
class DeferredReporting {
  groups: Listing<FileGroup>?
  clean: TemplatePair?
  autoFixed: TemplatePair?
  manualFixesNeeded: TemplatePair?
  operationalError: TemplatePair?
  masterUser: String?
  masterAgent: String?
  renderEmptyBuckets: Boolean?
  /// Block Stop on tool crashes and configuration errors (default false:
  /// notify the user only). Missing executables follow
  /// settings.missingToolPolicy instead.
  blockOnOperationalErrors: Boolean?
  /// Allow at most this many consecutive blocks while the harness reports an
  /// active stop hook (default 3); 0 disables the cap.
  maxConsecutiveBlocks: UInt?
  /// Total final-check output lines/characters quoted to the agent across all
  /// issues (defaults 60 and 6000).
  excerptMaxLines: UInt?
  excerptMaxChars: UInt?
}

class FileActivity {
  /// Infer candidates from project files whose mtimes fall in the unreconciled
  /// interval. This is noisy but useful when tool inspection has gaps.
  filesystemMtime: Boolean = true

  /// `git-dirty` is deliberately broad: it can include changes that predate
  /// the agent session. It is disabled unless explicitly selected.
  vcs: "disabled" | "git-dirty" = "disabled"

  /// Applied only to the first timestamp scan, whose session-start observation
  /// may occur just after an early edit.
  timestampToleranceMillis: UInt = 2000

  /// Bound recursive scans and record a coverage gap when the limit is hit.
  maxEntries: UInt = 100000

  /// Best effort retains and reports incomplete targets without blocking a
  /// stop solely for coverage. Strict also asks the harness to continue.
  coverageGapPolicy: "best-effort" | "strict" = "best-effort"

  ignoredDirectoryNames: Listing<String> = new Listing<String> {
    ".context"
    ".git"
    ".hg"
    ".svn"
    "node_modules"
    "target"
  }
}

class Merge {
  /// Drop all prior config state before applying this file.
  resetAll: Boolean = false

  /// Drop selected top-level fields before applying this file.
  reset: Listing<"settings" | "tools" | "run"> = new Listing<"settings" | "tools" | "run"> {}

  /// Drop named tool entries before applying this file.
  resetTools: Listing<String> = new Listing<String> {}

  /// Restore built-in groups/templates before applying this file's optional
  /// deferredReporting patch.
  resetDeferredReporting: Boolean = false

  /// Clear inherited `settings.exclude` patterns (including the defaults) so
  /// this file's `settings.exclude` replaces the list instead of appending.
  resetExclude: Boolean = false
}

class FileSelection {
  include: Listing<String> = new Listing<String> {}
  exclude: Listing<String> = new Listing<String> {}
}

/// Placeholder tokens for argv expansion. Each subclass carries a `type`
/// discriminator so JSON output is self-describing.
abstract class ArgToken {
  type: String
}

class Files extends ArgToken { type = "Files" }
class WorkspaceFiles extends ArgToken { type = "WorkspaceFiles" }
class Workspace extends ArgToken { type = "Workspace" }
class WorkspaceIndicator extends ArgToken { type = "WorkspaceIndicator" }
class ProjectRoot extends ArgToken { type = "ProjectRoot" }
class ToolExecutable extends ArgToken { type = "ToolExecutable" }
class ExtraArgs extends ArgToken { type = "ExtraArgs" }

class ExitCodes {
  clean: Listing<Int> = new Listing<Int> { 0 }
  issues: Listing<Int> = new Listing<Int> {}
  failure: Listing<Int> = new Listing<Int> {}
  unexpected: "failure" | "issues" = "failure"
}

class Diagnostics {
  directory: String?
}

/// Immediate-mode (post-tool-immediate) agent templates. Besides `tool`,
/// `changed_files`, `issue_files`, and the `diagnostics_*` paths, the issues
/// templates receive `excerpt`: a bounded, ANSI-free, project-relative excerpt
/// of the deciding check's output (capped by
/// `settings.deferredReporting.excerptMaxLines`/`excerptMaxChars`).
class Messages {
  cleanChangedAgent: String =
    "{{ tool }} changed {{ changed_files | join(\", \") }}; re-read changed files before editing further."
  issuesAgent: String =
    "velvet-glove: {{ tool }} reports issues in {{ issue_files | join(\", \") }}:\n{{ excerpt }}"
  issuesChangedAgent: String =
    "velvet-glove: {{ tool }} changed {{ changed_files | join(\", \") }} (re-read before editing); issues remain in {{ issue_files | join(\", \") }}:\n{{ excerpt }}"
  unavailableUser: String?
  failedUser: String?
}

class Phase {
  mode: "format" | "fix" | "verify" | "check-only"
  program: String?
  argv: Listing<String | ArgToken> = new Listing<String | ArgToken> {}
  exitCodes: ExitCodes = new ExitCodes {}
  writes: "none" | "target-files" | "matching-globs" | "workspace" = "none"
  enabled: Boolean = true
  extraArgs: Listing<String> = new Listing<String> {}
}

/// One command in a deferred check/remedy workflow.
class WorkflowCommand {
  program: String?
  argv: Listing<String | ArgToken> = new Listing<String | ArgToken> {}
  exitCodes: ExitCodes = new ExitCodes {}
  /// Treat non-whitespace stdout on an otherwise-clean exit as source issues.
  /// This supports tools such as gofmt whose non-mutating list mode reports
  /// dirty files through stdout while retaining exit status zero.
  issuesOnStdout: Boolean = false
  writes: "none" | "target-files" | "matching-globs" | "workspace" = "none"
  extraArgs: Listing<String> = new Listing<String> {}
}

/// Stop-time workflow. `check` is required for authoritative explicit
/// workflows and is optional in the schema only so validation can report a
/// useful configuration error before any external command runs.
class Workflow {
  check: WorkflowCommand?
  remedy: WorkflowCommand?
  checkScope: "target-files" | "workspace" = "target-files"
  invocation: "per-file" | "batch" | "workspace" = "batch"
  enabled: Boolean = true
  /// Arguments for the `ExtraArgs` token of both `check` and `remedy`, after
  /// the tool's `extraArgs` and before the command's own.
  extraArgs: Listing<String> = new Listing<String> {}
}

class ToolSpec {
  id: String
  displayName: String
  executable: String
  installHint: String?
  files: FileSelection = new FileSelection {}
  workspaceIndicator: String?
  /// Granularity used by the immediate phase pipeline and phase-derived
  /// compatibility workflows. Explicit workflows declare their own.
  phaseInvocation: "per-file" | "batch" | "workspace" = "batch"
  /// Preferred Stop-time check/remedy workflows. When empty, the deferred
  /// runner compatibility-translates `phases`; immediate PostToolUse continues
  /// to execute `phases` exactly as before.
  workflows: Mapping<String, Workflow> = new Mapping<String, Workflow> {}
  workflowOrder: Listing<String> = new Listing<String> {}
  /// Nonempty only when a catalog entry has no authoritative read-only check
  /// and must retain the legacy mutator-first compatibility behavior. Built-in
  /// validation rejects such entries unless this limitation is explicit.
  unverifiedRemedyFallback: String?
  phases: Mapping<String, Phase> = new Mapping<String, Phase> {}
  /// Optional explicit phase ordering. Phases not listed run after the
  /// listed ones, sorted by mode (format, fix, verify, check-only), then id.
  phaseOrder: Listing<String> = new Listing<String> {}
  messages: Messages = new Messages {}
  diagnostics: Diagnostics = new Diagnostics {}
  enabled: Boolean = true
  /// Arguments placed first in every command's `ExtraArgs` expansion (every
  /// phase, workflow check, and remedy). Only useful when every command of
  /// the tool accepts them; otherwise use Workflow/Phase `extraArgs`.
  extraArgs: Listing<String> = new Listing<String> {}
  /// Environment variables set for every command of this tool.
  env: Mapping<String, String> = new Mapping<String, String> {}
  /// Per-command timeout in seconds, overriding
  /// `settings.commandTimeoutSeconds`. 0 disables the limit.
  timeoutSeconds: UInt?
  /// Project-detection hints for `velvet-glove init`. Never affects hook runs.
  detect: Detect?
}

/// How `velvet-glove init` decides whether a project uses a tool. A tool is
/// suggested when its `files` globs match a project file, its executable
/// resolves, and either an indicator is present or it is its role's default
/// and no other tool in that role has an indicator.
class Detect {
  /// Project-relative globs whose presence suggests the project uses this
  /// tool, typically its config file (e.g. "ruff.toml", ".prettierrc*").
  indicators: Listing<String> = new Listing<String> {}
  /// Project-relative file -> text that suggests the tool when the file
  /// contains it (e.g. a package.json dependency or a pyproject table).
  contains: Mapping<String, String> = new Mapping<String, String> {}
  /// Mutually exclusive slot such as "python-format" or "js-lint".
  role: String?
  /// Pick this tool for its role when no indicator decides.
  default: Boolean = false
  /// Short reason shown by `init`, e.g. why the tool is opt-in only.
  note: String?
}

settings: Settings = new Settings {}
merge: Merge = new Merge {}
tools: Mapping<String, ToolSpec> = new Mapping<String, ToolSpec> {}
run: Listing<String> = new Listing<String> {}
