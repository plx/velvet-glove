  "sharedBootstrap": [
    {
      "id": "cargo-fetch",
      "argv": ["cargo", "fetch", "--locked", "--manifest-path", "{repository}/Cargo.toml"],
      "environment": {
        "CARGO_HOME": "{state}/cargo-home",
        "CARGO_TARGET_DIR": "{state}/cargo-target"
      },
      "workingDirectory": "/",
      "network": "required",
      "lockfile": "Cargo.lock"
    }
