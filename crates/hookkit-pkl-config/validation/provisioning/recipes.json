      },
      "probe": {
        "argv": ["python", "--version"],
        "match": "exact",
        "expected": "Python 3.14.5"
      }
    },
    {
      "id": "apple-clang",
      "version": "major >=17",
      "installationSource": "Apple developer toolchain selected by the declared macOS host",
      "integrity": {
        "kind": "host-program",
        "path": "/usr/bin/cc"
      },
      "probe": {
        "argv": ["/usr/bin/cc", "--version"],
        "match": "major-at-least",
        "expected": "17"
      }
    },
    {
      "id": "macos-sdk",
      "version": "major >=26",
      "installationSource": "macOS SDK selected by the Apple xcrun host shim",
      "integrity": {
        "kind": "host-program",
        "path": "/usr/bin/xcrun"
      },
      "probe": {
        "argv": ["/usr/bin/xcrun", "--show-sdk-version"],
        "match": "major-at-least",
        "expected": "26"
      }
    },
    {
      "id": "xcode",
      "version": "major >=26",
      "installationSource": "Apple Xcode or Command Line Tools supplied by the declared macOS host",
      "integrity": {
        "kind": "host-program",
        "path": "/usr/bin/xcodebuild"
      },
      "probe": {
        "argv": ["/usr/bin/xcodebuild", "-version"],
        "match": "major-at-least",
        "expected": "26"
      }
    }
