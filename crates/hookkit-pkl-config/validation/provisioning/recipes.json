{
  "$schema": "./recipes.schema.json",
  "schemaVersion": 1,
  "mise": {
    "requiredVersion": "2026.5.15",
    "config": "crates/hookkit-pkl-config/validation/provisioning/mise.toml",
    "lock": "crates/hookkit-pkl-config/validation/provisioning/mise.lock",
    "provisioningNetwork": "required"
  },
  "controlledEnvironment": {
    "clearInherited": true,
    "home": "neutral-system-temporary",
    "seededVariables": [
      "HOME",
      "LANG",
      "PATH",
      "SHELL",
      "TERM",
      "USER"
    ],
    "set": {
      "LC_ALL": "C",
      "TZ": "UTC"
    }
  },
  "sharedComponents": [
    {
      "id": "jq",
      "version": "1.8.2",
      "miseTool": "jq@1.8.2",
      "installationSource": "jqlang/jq 1.8.2 macOS arm64 release asset locked by SHA-256 with GitHub SLSA provenance",
      "integrity": {
        "kind": "mise-lock",
        "path": "crates/hookkit-pkl-config/validation/provisioning/mise.lock"
      },
      "probe": {
        "argv": ["jq", "--version"],
        "match": "exact",
        "expected": "jq-1.8.2"
      }
    },
    {
      "id": "pkl",
      "version": "0.31.1",
      "miseTool": "pkl@0.31.1",
      "installationSource": "mise aqua:apple/pkl asset locked for macos-arm64",
      "integrity": {
        "kind": "mise-lock",
        "path": "crates/hookkit-pkl-config/validation/provisioning/mise.lock"
      },
      "probe": {
        "argv": ["pkl", "--version"],
        "match": "prefix",
        "expected": "Pkl 0.31.1 "
      }
    },
    {
      "id": "rust",
      "version": "1.90.0",
      "installationSource": "official dated Rust 1.90.0 standalone archive for aarch64-apple-darwin",
      "integrity": {
        "kind": "sha256-archive",
