        "sha256": "9772d20d5cd736079a0ee84d00e6697cf2084f0fc4621b011e24e6f2d08d2d7f",
        "archiveFormat": "tar-xz",
        "archiveRoot": "rust-1.90.0-aarch64-apple-darwin",
        "minOsVersion": "11.0",
        "allowedDylibPrefixes": ["/System/Library/", "/usr/lib/"]
      },
      "probe": {
        "argv": ["rustc", "--version"],
        "match": "prefix",
        "expected": "rustc 1.90.0 "
      }
    },
    {
      "id": "python",
