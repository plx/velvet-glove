{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/plx/velvet-glove/blob/main/crates/hookkit-pkl-config/validation/manifest.schema.json",
  "title": "Velvet Glove builtin validation manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "catalogSources", "tools"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "catalogSources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builtin",
        "id",
        "specPath",
        "trackingIssue",
        "support",
        "surfaces",
        "contracts",
        "fixtureCases",
        "dependencies",
        "provenance",
        "constraints",
        "evidence",
        "exceptions"
      ],
      "properties": {
        "builtin": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "specPath": { "type": "string", "pattern": "\\.pkl$" },
        "trackingIssue": { "type": "integer", "minimum": 1 },
        "support": { "enum": ["enabled", "disabled"] },
        "surfaces": { "$ref": "#/$defs/surfaces" },
        "contracts": { "$ref": "#/$defs/surfaceContracts" },
        "fixtureCases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "dependencies": { "$ref": "#/$defs/dependencies" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "constraints": { "$ref": "#/$defs/constraints" },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "exceptions": {
          "type": "array",
          "items": { "$ref": "#/$defs/exception" }
        }
      }
    },
    "surfaces": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediate", "deferred"],
      "properties": {
        "immediate": { "enum": ["supported", "not-supported"] },
        "deferred": {
          "enum": ["explicit", "compatibility", "not-supported"]
        }
      }
    },
    "surfaceContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["immediate", "deferred"],
      "properties": {
        "immediate": {
          "anyOf": [
            { "$ref": "#/$defs/surfaceContract" },
            { "type": "null" }
          ]
        },
        "deferred": {
          "anyOf": [
            { "$ref": "#/$defs/surfaceContract" },
            { "type": "null" }
          ]
        }
      }
    },
    "surfaceContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilities",
        "requiredCases",
        "orchestrationCases",
        "targets"
      ],
      "properties": {
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "requiredCases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contractCase" }
        },
        "orchestrationCases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contractCase" }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/commandTarget" }
        }
      }
    },
    "commandTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "order",
        "invocation",
        "checkScope",
        "workingDirectory",
        "workspaceIndicator",
        "fileIncludes",
        "fileExcludes",
        "commands",
        "capabilities",
        "requiredCases"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "immediate-pipeline",
            "explicit-workflow",
            "compatibility-workflow"
          ]
        },
        "order": { "type": "integer", "minimum": 0 },
        "invocation": { "enum": ["per-file", "batch", "workspace"] },
        "checkScope": {
          "type": ["string", "null"],
          "enum": ["target-files", "workspace", null]
        },
        "workingDirectory": { "enum": ["project-root", "workspace"] },
        "workspaceIndicator": { "type": ["string", "null"] },
        "fileIncludes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "fileExcludes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/commandSignature" }
        },
        "capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        },
        "requiredCases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contractCase" }
        }
      }
    },
    "commandSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "mode",
        "reusesImmediatePhase",
        "program",
        "argv",
        "exitCodes",
        "issuesOnStdout",
        "writes",
        "extraArgs"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["phase", "workflow-check", "workflow-remedy"] },
        "mode": { "enum": ["format", "fix", "verify", "check-only"] },
        "reusesImmediatePhase": { "type": ["string", "null"] },
        "program": { "type": "string", "minLength": 1 },
        "argv": {
          "type": "array",
          "items": { "$ref": "#/$defs/argvElement" }
        },
        "exitCodes": { "$ref": "#/$defs/exitCodes" },
        "issuesOnStdout": { "type": "boolean" },
        "writes": {
          "enum": ["none", "target-files", "matching-globs", "workspace"]
        },
        "extraArgs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "argvElement": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "#/$defs/argToken" }
      ]
    },
    "argToken": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "Files",
            "WorkspaceFiles",
            "Workspace",
            "WorkspaceIndicator",
            "ProjectRoot",
            "ToolExecutable",
            "ExtraArgs"
          ]
        }
      }
    },
    "exitCodes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clean", "issues", "failure", "unexpected"],
      "properties": {
        "clean": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer" }
        },
        "issues": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer" }
        },
        "failure": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer" }
        },
        "unexpected": { "enum": ["failure", "issues"] }
      }
    },
    "capability": {
      "enum": [
        "checker",
        "mutator",
        "stdout-signaled",
        "workspace-scoped",
        "per-file",
        "batch",
        "workspace-invocation"
      ]
    },
    "contractCase": {
      "enum": [
        "command-coverage",
        "immediate-phase-order",
        "deferred-lifecycle",
        "clean",
        "source-issue",
        "operational-failure",
        "no-mutation",
        "mutation",
        "complete-workspace-diff",
        "post-mutation-verification",
        "idempotence",
        "stdout-clean",
        "stdout-issue",
        "workspace-scope",
        "multi-file",
        "batch-attribution",
        "per-file-invocation",
        "workspace-attribution"
      ]
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provisioningGroup",
        "primaryExecutable",
        "programOverrides",
        "wrapperExecutables"
      ],
      "properties": {
        "provisioningGroup": { "type": "string", "minLength": 1 },
        "primaryExecutable": { "type": "string", "minLength": 1 },
        "programOverrides": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "wrapperExecutables": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogSource", "upstream"],
      "properties": {
        "catalogSource": { "type": "string", "minLength": 1 },
        "upstream": { "$ref": "#/$defs/upstream" }
      }
    },
    "upstream": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "url",
            "version",
            "installationSource",
            "versionCommand"
          ],
          "properties": {
            "status": { "const": "recorded" },
            "url": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "installationSource": { "type": "string", "minLength": 1 },
            "versionCommand": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "trackingIssue"],
          "properties": {
            "status": { "const": "gap" },
            "reason": { "type": "string", "minLength": 1 },
            "trackingIssue": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "architectures", "caseNetwork"],
      "properties": {
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["linux", "macos"] }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["x86-64", "aarch64"] }
        },
        "caseNetwork": { "enum": ["denied", "loopback", "required"] }
      }
    },
    "tier": {
      "enum": ["schema", "rendered-command", "pinned-real-tool"]
    },
    "surface": { "enum": ["catalog", "immediate", "deferred"] },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "status",
        "surfaces",
        "targets",
        "cases",
        "surfaceCases",
        "references",
        "reason",
        "trackingIssue"
      ],
      "properties": {
        "tier": { "$ref": "#/$defs/tier" },
        "status": { "enum": ["covered", "gap"] },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/surface" }
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "cases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contractCase" }
        },
        "surfaceCases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contractCase" }
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "reason": { "type": ["string", "null"] },
        "trackingIssue": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "reason",
        "trackingIssue",
        "expiresOn",
        "tiers",
        "surfaces",
        "targets",
        "cases",
        "surfaceCases"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "trackingIssue": { "type": "integer", "minimum": 1 },
        "expiresOn": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "tiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tier" }
        },
        "surfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/surface" }
        },
        "targets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "cases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contractCase" }
        },
        "surfaceCases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/contractCase" }
        }
      }
    }
  }
}
