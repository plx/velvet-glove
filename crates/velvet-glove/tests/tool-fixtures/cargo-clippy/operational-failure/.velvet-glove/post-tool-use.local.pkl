amends "Config.pkl"
import "Builtins.pkl"

tools {
  ["cargo-clippy"] = (Builtins.cargoClippy) {
    phases {
      ["fix"] {
        // Exercise cargo's own usage-error exit (1) through an unrecognized
        // flag — genuinely operational, unlike the 101 that compile errors,
        // lint violations, and bad clippy.toml/Cargo.toml all share.
        extraArgs = new Listing<String> { "--this-flag-does-not-exist" }
      }
    }
  }
}
