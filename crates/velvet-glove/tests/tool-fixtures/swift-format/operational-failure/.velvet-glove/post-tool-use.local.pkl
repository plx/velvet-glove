amends "Config.pkl"
import "Builtins.pkl"

tools {
  ["swift-format"] = (Builtins.appleSwiftFormat) {
    phases {
      // A malformed `.swift-format` JSON config exits 1, the same code as a
      // real issue, so force the distinguishable argv-parsing failure
      // (exit 64) through a supported extra arg instead.
      ["fix"] {
        extraArgs = new Listing<String> { "--this-flag-does-not-exist" }
      }
      ["verify"] {
        extraArgs = new Listing<String> { "--this-flag-does-not-exist" }
      }
    }
  }
}
