amends "Config.pkl"
import "Builtins.pkl"

tools {
  ["pylint"] = (Builtins.pylint) {
    phases {
      // An unrecognized CLI flag is pylint's usage-error exit code 32, listed
      // explicitly in this spec's `failure` set, so it is reported as an
      // operational failure rather than a lint issue.
      ["verify"] {
        extraArgs = new Listing<String> { "--bogus-flag" }
      }
    }
  }
}
