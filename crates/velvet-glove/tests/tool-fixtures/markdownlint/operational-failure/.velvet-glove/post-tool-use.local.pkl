amends "Config.pkl"
import "Builtins.pkl"

tools {
  ["markdownlint"] = (Builtins.markdownLint) {
    phases {
      ["verify"] {
        // Exercise markdownlint-cli's fatal config-parse exit through supported extra args.
        extraArgs = new Listing<String> { "--config"; "bad-config.json" }
      }
    }
  }
}
