amends "Config.pkl"
import "Builtins.pkl"

tools {
  ["black"] = (Builtins.black) {
    // An invalid --target-version value is a usage error (exit 2), not a formatting issue.
    // Tool-level extraArgs reach every command, so the immediate phases and
    // the deferred check/remedy all hit the same exit-2 usage error.
    extraArgs = new Listing<String> { "--target-version=bogus" }
  }
}
