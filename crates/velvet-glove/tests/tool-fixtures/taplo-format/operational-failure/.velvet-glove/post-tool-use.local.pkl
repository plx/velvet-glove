amends "Config.pkl"
import "Builtins.pkl"

tools {
  ["taplo-format"] = (Builtins.taploFormat) {
    // An unrecognized flag on every command: taplo exits 2 (usage error),
    // which neither phase maps, so it is an operational failure. Tool-level
    // extraArgs also reach the deferred check, which runs verify first.
    extraArgs = new Listing<String> { "--this-flag-does-not-exist" }
  }
}
