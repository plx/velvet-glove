amends "Config.pkl"
import "Builtins.pkl"

tools {
  ["betterleaks"] = (Builtins.betterleaks) {
    phases {
      ["verify"] {
        // A missing config exits 1, which must read as operational.
        extraArgs = new Listing<String> { "--config"; "missing-operational.toml" }
      }
    }
  }
}
