amends "Config.pkl"
import "Builtins.pkl"

tools {
  ["bandit"] = (Builtins.bandit) {
    phases {
      // An unparseable `-c` config exits 2, which the default
      // `unexpected = "failure"` classification reports as an operational
      // failure rather than "no issues found".
      ["verify"] {
        extraArgs = new Listing<String> { "-c"; "bandit.yaml" }
      }
    }
  }
}
