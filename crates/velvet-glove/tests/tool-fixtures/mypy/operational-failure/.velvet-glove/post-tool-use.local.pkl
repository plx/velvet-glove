amends "Config.pkl"
import "Builtins.pkl"

tools {
  ["mypy"] = (Builtins.mypy) {
    phases {
      // An unrecognized CLI flag is a usage error (exit 2), which the default
      // `unexpected = "failure"` classification correctly reports as an
      // operational failure rather than a type issue.
      ["verify"] {
        extraArgs = new Listing<String> { "--bogus-flag" }
      }
    }
  }
}
