amends "Config.pkl"
import "Builtins.pkl"

tools {
  ["editorconfig-checker"] = (Builtins.editorconfigChecker) {
    phases {
      ["verify"] {
        // Exercise the tool's unreadable-config failure through supported
        // extra args: `-config` pointed at a file that doesn't exist.
        extraArgs = new Listing<String> { "-config"; "missing-operational.json" }
      }
    }
  }
}
