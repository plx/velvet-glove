amends "Config.pkl"
import "Builtins.pkl"

tools {
  ["trailing-whitespace"] = (Builtins.trailingWhitespace) {
    phases {
      ["fix"] {
        // Exercise hk's usage-error exit (2) through supported extra args.
        extraArgs = new Listing<String> { "--nonexistent-flag" }
      }
      ["verify"] {
        extraArgs = new Listing<String> { "--nonexistent-flag" }
      }
    }
  }
}
