{
  "description": "Run Velvet Glove's formatters and linters before the coding agent stops, or after each edit when VELVET_GLOVE_MODE=immediate.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-velvet-glove.sh\" session-start-state",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-velvet-glove.sh\" post-tool",
            "timeout": 300
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/run-velvet-glove.sh\" turn-completion",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
